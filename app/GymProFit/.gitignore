.gitignore

# Android Studio / IntelliJ
*.iml
/.idea/
!/.idea/codeStyles/
!/.idea/runConfigurations/

# Gradle
.gradle/
/build/
gradle/wrapper/gradle-wrapper.jar

# Secretos y configuración local
local.properties
secrets.properties
keystore.properties
# Clave de subida a Play (GP-159): mismo trato que keystore.properties
upload.properties

# Keystores (firma de APK)
*.keystore
*.jks
*.p12
# Certificados y exportaciones de PEPK: viven fuera del repo, por si acaso
*.pem
*.pepk

# Firebase (por si lo añades)
google-services.json

# Artefactos
/captures/
.externalNativeBuild/
.cxx/

# Sistema operativo
.DS_Store
Thumbs.db
CLAUDE_ANDROID.md
CLAUDE_API.md
TODO.md
.claude
DOCUMENTACION_COMPLETA.md
# Eclipse / JDT.LS (el plugin jdtls-lsp los genera)
.project
.classpath
.settings/
