<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Manifiesto de la aplicación GymProFit
  Declara permisos, el FileProvider, todas las Activities de la app
  y la Activity de arranque (SplashActivity) con su intent-filter LAUNCHER.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos requeridos: red, notificaciones, cámara/galería (foto de perfil) y contactos -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- El cronómetro de las series por tiempo avisa vibrando al mínimo y al máximo (GP-012). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- El fin del descanso suena a su hora con la pantalla apagada (GP-013). SCHEDULE y
         nunca USE_EXACT_ALARM: Play reserva ese a las apps de alarmas, temporizadores y
         calendarios. En Android 14 o más, las instalaciones nuevas lo tienen denegado y
         se pide con una hoja la primera vez que empieza un descanso. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".GymProFitApp"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymProFit">

        <!-- Servicio FCM: recibe las notificaciones push y las rotaciones de token -->
        <service
            android:name=".services.GymFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Canal usado por FCM cuando la app está en background (Android pinta la notificación solo) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="5" />
        <!-- Icono y color de la push cuando la pinta el sistema, con la app en segundo
             plano: el mensaje lleva bloque notification, así que no pasa por
             NotificationHelper. Sin esto Android usa el icono de la app, que en la barra
             de estado sale como un borrón blanco (GP-081). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notificacion" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/gp_primary" />

        <!-- El fin del descanso (GP-013): su alarma, y el cambio del permiso de alarmas
             exactas, que manda el sistema (acción protegida). -->
        <receiver
            android:name=".envivo.FinDescansoReceiver"
            android:exported="false" />
        <receiver
            android:name=".envivo.PermisoAlarmasReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Activities de administración (gestión de usuarios, rutinas, ejercicios, alimentos) -->
        <activity
            android:name=".ui.activities.EstadisticasNutricionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AdminUsuariosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AdminRutinasActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AdminEjerciciosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.EditarRutinaAdminActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.EditarEjercicioAdminActivity"
            android:exported="false" />
        <!-- Perfil, logros y mediciones corporales -->
        <activity
            android:name=".ui.activities.EditarPerfilActivity"
            android:exported="false" />
        <!-- Sesiones de entrenamiento -->
        <activity
            android:name=".ui.activities.RegistrarSesionActivity"
            android:exported="false" />
        <!-- La sesión en vivo (GP-012). singleTop: la notificación no abre otra encima. -->
        <activity
            android:name=".ui.activities.SesionEnVivoActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.activities.ResumenSesionActivity"
            android:exported="false" />
        <!-- El alta nueva (GP-103): la bienvenida y el cuestionario. «Guarda tu plan» y
             los avisos van con Ajustes. -->
        <activity android:name=".ui.activities.BienvenidaActivity" android:exported="false" />
        <activity android:name=".ui.activities.AltaActivity" android:exported="false" />
        <!-- Rutinas: edición, detalle, creación y gestión de ejercicios asociados -->
        <activity
            android:name=".ui.activities.EditarRutinaActivity"
            android:exported="false" />
        <activity android:name=".ui.activities.ProgramasActivity" android:exported="false" />
        <activity android:name=".ui.activities.ProgramaDetalleActivity" android:exported="false" />
        <activity
            android:name=".ui.activities.DetalleRutinaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.DetalleEjercicioActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.ResumenCrearRutinaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.AnadirEjerciciosActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.CrearRutinaActivity"
            android:exported="false" />
        <!-- Navegación principal (GP-105): 1 Activity + ViewPager2 + 4 Fragments
             (Inicio/Entrenar/Nutrición/Progreso) con la barra fija y el «+». -->
        <activity
            android:name=".ui.activities.MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.activities.LoginActivity"
            android:exported="false" />

        <!-- Recuperación de contraseña olvidada; se abre desde el login -->
        <activity
            android:name=".ui.activities.RecuperarPasswordActivity"
            android:exported="false" />
        <!-- Nutrición: comidas y alimentos (registro, alta y administración) -->
        <activity android:name=".ui.activities.ComidaActivity" android:exported="false" />
        <activity android:name=".ui.activities.AnadirAlimentoActivity" android:exported="false" />
        <activity android:name=".ui.activities.CrearAlimentoActivity" android:exported="false" />
        <activity android:name=".ui.activities.AdminAlimentosActivity" android:exported="false" />
        <activity android:name=".ui.activities.AcercaDeActivity" android:exported="false" />
        <!-- Licencias de terceros (GP-082): el texto de lo que no sale de Gradle, y las
             dos pantallas de play-services-oss-licenses con una barra de título, que el
             tema de la app no tiene y sin la cual no dirían qué son ni tendrían volver. -->
        <activity android:name=".ui.activities.LicenciaActivity" android:exported="false" />
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesMenuActivity"
            android:theme="@style/Theme.GymProFit.ConBarra"
            tools:replace="android:theme" />
        <activity
            android:name="com.google.android.gms.oss.licenses.OssLicensesActivity"
            android:theme="@style/Theme.GymProFit.ConBarra"
            tools:replace="android:theme" />
        <!-- Borrado definitivo de la cuenta (GP-008); se abre desde Ajustes -->
        <activity android:name=".ui.activities.EliminarCuentaActivity" android:exported="false" />
        <!-- Estructura de GP-105: Ajustes y lo que cuelga de él, la biblioteca de
             ejercicios y todas las plantillas (antes, pestañas o parte del perfil). -->
        <activity android:name=".ui.activities.AjustesActivity" android:exported="false" />
        <!-- Ajustes › Notificaciones y «¿Te avisamos?» del alta (GP-112, lote 1.5.1). -->
        <activity android:name=".ui.activities.NotificacionesActivity" android:exported="false" />
        <activity android:name=".ui.activities.AvisosActivity" android:exported="false" />
        <!-- «Guarda tu plan»: la cuenta al final del alta (GP-103). -->
        <activity android:name=".ui.activities.GuardaPlanActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.activities.CambiarPasswordActivity" android:exported="false" />
        <activity android:name=".ui.activities.CambiarCorreoActivity" android:exported="false" />
        <activity android:name=".ui.activities.LicenciasActivity" android:exported="false" />
        <activity android:name=".ui.activities.EjerciciosActivity" android:exported="false" />

        <!-- FileProvider para compartir/capturar la foto de perfil con la cámara -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Activity de arranque (launcher), decide a qué pantalla redirigir según sesión -->
        <activity
            android:name=".ui.activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>