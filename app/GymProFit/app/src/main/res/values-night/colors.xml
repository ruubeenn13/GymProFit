<?xml version="1.0" encoding="utf-8"?>
<!--
  colors.xml (values-night) — paleta "atlética oscura" (modo POR DEFECTO).
  Carbón profundo + naranja de marca vivo como energía. Sobrescribe los
  tokens semánticos de values/colors.xml.
-->
<resources>
    <!-- ── Marca ─────────────────────────────────────────────────────────── -->
    <color name="gp_primary">#FF6A00</color>
    <!-- Carbón cálido, NO blanco. El blanco sobre este naranja daba 2,87:1:
         falla AA (4,5:1) y ni siquiera llega al 3:1 de texto grande, en el
         elemento héroe de la pantalla principal y en todos los botones
         primarios. Con #1A0E00 sube a 6,61:1. Es además lo que hacen Strava
         y Hevy: el naranja se ve más caro con texto oscuro encima. -->
    <color name="gp_on_primary">#1A0E00</color>
    <!-- Texto secundario sobre la marca: la mezcla del 80 % ya hecha, 4,93:1 (GP-063). -->
    <color name="gp_on_primary_secondary">#482000</color>
    <color name="gp_primary_container">#3A2110</color>
    <color name="gp_on_primary_container">#FFB27A</color>
    <!-- El de Material 1.12 (GP-136). -->
    <color name="gp_on_secondary_container">#E8DEF8</color>
    <color name="gp_gold">#E8B84B</color>
    <color name="gp_gold_text">#E8B84B</color>
    <!-- Medallón de logro conseguido: gp_gold encima da 7,21:1 (GP-079). -->
    <color name="gp_gold_container">#3A2E12</color>
    <!-- Fila de la serie que batió el récord en la sesión en vivo (GP-210, momento 25).
         El texto (gp_text_primary) da 13,79:1 encima y el secundario 6,51:1. -->
    <color name="gp_gold_fila">#2A2414</color>

    <!-- ── Superficies ───────────────────────────────────────────────────── -->
    <!-- Mismo problema que en claro, peor: surface estaba a 1,10:1 del fondo y
         el borde a 1,25:1. En tema oscuro la sombra no se ve, así que el
         trabajo de separar lo tiene que hacer el BORDE.

         Hasta GP-063 el borde se quedaba en 2,06:1 a propósito, con el
         argumento de que a 3:1 se lee como un wireframe y de que WCAG 1.4.11
         solo lo exige para identificar un control. Se cambia porque muchas de
         estas tarjetas SON controles —se pulsan— y su canto es lo único que
         dice dónde se pulsa. #676F7E da 3,30:1 sobre la tarjeta, 3,87:1 sobre
         el fondo y 3,11:1 sobre la tarjeta teñida por la elevación (#262223).
         gp_divider conserva el valor anterior para los separadores internos,
         que no delimitan nada. -->
    <color name="gp_background">#0B0C0E</color>
    <color name="gp_surface">#1B1E24</color>
    <!-- Sin borde en oscuro: el de las tarjetas dibujadas a mano pinta el color de la superficie. -->
    <color name="gp_tarjeta_borde">@color/gp_surface</color>
    <color name="gp_surface_2">#252A31</color>
    <color name="gp_stroke">#676F7E</color>
    <color name="gp_divider">#4A505B</color>

    <!-- ── Texto ─────────────────────────────────────────────────────────── -->
    <color name="gp_on_surface">#F2F2F3</color>
    <!-- 7,05:1 sobre la tarjeta. Sustituye a los android:alpha sobre texto. -->
    <color name="gp_text_secondary">#A1A9B6</color>

    <!-- ── Cuerpo anatómico (mapa muscular estilo Symmetry) ──────────────── -->
    <!-- Silueta clara para que el cuerpo destaque sobre el fondo carbón
         (antes #3A3B42 se camuflaba); el músculo trabajado sigue en naranja -->
    <color name="body_silhouette">#A6A7AF</color>
    <color name="body_highlight">#FF6A00</color>

    <!-- ── Macros ────────────────────────────────────────────────────────── -->
    <!-- Un color por macro: tres barras del mismo color no codifican nada. -->
    <color name="gp_macro_proteinas">#6BA6F5</color>
    <color name="gp_macro_carbos">#E8A94B</color>
    <color name="gp_macro_grasas">#B295E8</color>

    <!-- ── Estados ───────────────────────────────────────────────────────── -->
    <color name="gp_success">#4ADE80</color>
    <color name="gp_success_container">#143323</color>
    <color name="gp_error">#F87171</color>
    <color name="gp_error_container">#3A1414</color>

    <!-- Pista del medidor de nivel: #353A43 frente a #FF6A00 da 3,98:1 (GP-078). -->
    <!-- El agua (lote 1.6.8, tablero 1): el vaso y la gota en gp_agua (8,02:1 sobre la tarjeta);
         el botón «Vaso», gp_on_agua_container sobre gp_agua_container (9,36:1). -->
    <!-- El brillo que cruza la barra dorada de la proteína con el día completo (momento 21). -->
    <color name="gp_brillo_oro">#B3FFF4D9</color>
    <color name="gp_agua">#56C2D6</color>
    <color name="gp_agua_container">#10323A</color>
    <color name="gp_on_agua_container">#8FE3F0</color>
    <color name="gp_meter_track">#353A43</color>

    <!-- ── Alias legados usados por layouts existentes ───────────────────── -->
    <color name="on_surface">@color/gp_on_surface</color>
    <color name="primaryContainer_dark">#24252B</color>
    <color name="onPrimaryContainer_dark">#F2F2F3</color>
    <color name="surface_card">@color/gp_surface</color>
    <color name="surface_card_2">@color/gp_surface_2</color>
    <color name="text_secondary">@color/gp_text_secondary</color>

    <color name="green_chip">@color/gp_success_container</color>
    <color name="green_chip_text">@color/gp_success</color>
    <color name="red_chip">@color/gp_error_container</color>
    <color name="red_chip_text">@color/gp_error</color>
    <!-- La acción de un aviso invertido («Deshacer», lote 1.6.2): el naranja del otro tema, sobre el fondo claro del aviso en oscuro. -->
    <color name="gp_accion_inversa">#B83E00</color>
    <!-- Sobre oscuro el logo va sin baldosa (GP-231, DEC-057): la G sola, en el mismo sitio. -->
    <color name="logo_baldosa">#000B0C0E</color>
    <!-- GP-265: la tarjeta de «Tu objetivo», superficie elevada con borde fino. -->
    <color name="gp_objetivo_fondo">@color/gp_surface_2</color>
    <color name="gp_objetivo_borde">@color/gp_divider</color>
    <color name="gp_objetivo_texto">@color/gp_on_surface</color>
    <color name="gp_objetivo_texto_2">@color/gp_text_secondary</color>
    <color name="gp_objetivo_ficha">@color/gp_surface</color>
    <color name="gp_objetivo_contorno">#808897</color>
    <!-- GP-045: el halo de la caja activa del código (naranja al 25 %). -->
    <color name="gp_codigo_halo">#40FF6A00</color>
    <!-- ── Liquid Glass (GP-285, DEC-070) ─────────────────────────────────────
         Valores de documentacion/diseno/2026-11-25-liquid-glass/README.md. El contraste de cada
         texto está medido sobre el punto más claro de fondo + brillo + cristal compuestos
         (ContrasteCristalTest); las cifras de cada par, en DESIGN.md. -->
    <!-- Fondo ambiental: la base y sus tres brillos (FondoAmbiental, Ambiente). El naranja va al
         26 % y no al 55 % de la maqueta: con el 55 %, el texto secundario sobre una tarjeta que
         pasa por encima del brillo se quedaba en 3,19:1 y el acento en 2,87:1 (regla 1 del diseño:
         ningún brillo intenso detrás de texto pequeño). Al 26 % el peor par da 4,65:1. -->
    <color name="gp_ambiente_base">#08090B</color>
    <color name="gp_ambiente_brillo_1">#42FF6A00</color>
    <color name="gp_ambiente_brillo_2">#73BE2814</color>
    <color name="gp_ambiente_brillo_3">#593C5AC8</color>
    <!-- Cristal estático: relleno a 160° blanco 16 % → 5 % (al 55 %) → 9 %, borde 18 % y brillo
         superior 35 %. -->
    <color name="gp_cristal_alto">#29FFFFFF</color>
    <color name="gp_cristal_medio">#0DFFFFFF</color>
    <color name="gp_cristal_bajo">#17FFFFFF</color>
    <color name="gp_cristal_borde">#2EFFFFFF</color>
    <color name="gp_cristal_brillo">#59FFFFFF</color>
    <!-- Texto sobre el fondo ambiental y sobre el cristal. -->
    <color name="gp_cristal_texto">#F2F2F3</color>
    <color name="gp_cristal_texto_2">#C9CDD6</color>
    <!-- Acento de texto pequeño sobre cristal, y el de enlaces sobre el fondo y la selección
         de la barra. -->
    <color name="gp_cristal_acento">#FFB27A</color>
    <color name="gp_cristal_enlace">#FF8A3D</color>
    <color name="gp_cristal_exito">#8FE3B0</color>
    <!-- Dorado de texto sobre cristal (4,65:1) y la cifra de 26 sp sobre la fila de un récord
         (#E8B84B se quedaba en 2,85:1 sobre su propio degradado; #F0DDA8 da 3,90:1). -->
    <color name="gp_cristal_oro">#E8B84B</color>
    <color name="gp_cristal_oro_cifra">#F0DDA8</color>
    <!-- Pista de una barra de progreso: un surco oscuro. La maqueta la pone en blanco al 14 %,
         pero contra ella el relleno se quedaba en 2,56:1; contra el surco pasa de 3:1 (GP-078:
         la pista se mide contra su relleno). Y las barras apagadas de una gráfica: blanco al
         45 % y no al 20 %, para que cada barra dé 3:1 contra el cristal. -->
    <color name="gp_cristal_pista">#66000000</color>
    <color name="gp_cristal_barra_tenue">#73FFFFFF</color>
    <!-- Cristal vivo (barra, barra de sesión, hoja del «+»): el tinte sobre el desenfoque
         (niveles 1 y 2) y la superficie casi opaca del nivel 3. -->
    <color name="gp_vivo_alto">#8C282A30</color>
    <color name="gp_vivo_bajo">#6614161A</color>
    <color name="gp_vivo_opaco_alto">#FA282A30</color>
    <color name="gp_vivo_opaco_bajo">#FA14161A</color>
    <color name="gp_vivo_texto">#E4E6EB</color>
    <color name="gp_vivo_acento">#FFB27A</color>
    <color name="gp_vivo_sombra">#59000000</color>
    <!-- Selección «lente»: cápsula blanco 10 %, brillo superior 40 % y resplandor 8 %. La maqueta
         pone el relleno al 14 % y el icono y la etiqueta en #FF8A3D: sobre la barra daban 3,19:1
         (3,74:1 en el nivel 3). Con el relleno al 10 % y el acento claro, #FFB27A, 4,78:1. -->
    <color name="gp_lente">#1AFFFFFF</color>
    <color name="gp_lente_brillo">#66FFFFFF</color>
    <color name="gp_lente_resplandor">#14FFFFFF</color>
    <!-- Récord sobre cristal: degradado dorado 28 % → 8 % y brillo. -->
    <color name="gp_cristal_oro_alto">#47E8B84B</color>
    <color name="gp_cristal_oro_bajo">#14E8B84B</color>
    <color name="gp_cristal_oro_brillo">#66FFECBE</color>
    <!-- Botón principal sobre cristal: brillo superior y halo. -->
    <color name="gp_boton_brillo">#73FFFFFF</color>
    <color name="gp_boton_halo">#73FF6A00</color>
    <!-- Botón secundario y chip: cristal estático plano. -->
    <color name="gp_cristal_boton">#1FFFFFFF</color>
</resources>
