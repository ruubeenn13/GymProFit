<?xml version="1.0" encoding="utf-8"?>
<!--
  colors.xml (values-night) — paleta "atlética oscura" (modo POR DEFECTO).
  Carbón profundo + naranja de marca vivo como energía. Sobrescribe los
  tokens semánticos de values/colors.xml.
-->
<resources>
    <!-- ── Marca ─────────────────────────────────────────────────────────── -->
    <color name="gp_primary">#FF6A00</color>
    <!-- Carbón cálido, NO blanco. El blanco sobre este naranja daba 2,87:1:
         falla AA (4,5:1) y ni siquiera llega al 3:1 de texto grande, en el
         elemento héroe de la pantalla principal y en todos los botones
         primarios. Con #1A0E00 sube a 6,61:1. Es además lo que hacen Strava
         y Hevy: el naranja se ve más caro con texto oscuro encima. -->
    <color name="gp_on_primary">#1A0E00</color>
    <!-- Texto secundario sobre la marca: la mezcla del 80 % ya hecha, 4,93:1 (GP-063). -->
    <color name="gp_on_primary_secondary">#482000</color>
    <color name="gp_primary_container">#3A2110</color>
    <color name="gp_on_primary_container">#FFB27A</color>
    <color name="gp_gold">#E8B84B</color>
    <color name="gp_gold_text">#E8B84B</color>

    <!-- ── Superficies ───────────────────────────────────────────────────── -->
    <!-- Mismo problema que en claro, peor: surface estaba a 1,10:1 del fondo y
         el borde a 1,25:1. En tema oscuro la sombra no se ve, así que el
         trabajo de separar lo tiene que hacer el BORDE.

         Hasta GP-063 el borde se quedaba en 2,06:1 a propósito, con el
         argumento de que a 3:1 se lee como un wireframe y de que WCAG 1.4.11
         solo lo exige para identificar un control. Se cambia porque muchas de
         estas tarjetas SON controles —se pulsan— y su canto es lo único que
         dice dónde se pulsa. #676F7E da 3,30:1 sobre la tarjeta, 3,87:1 sobre
         el fondo y 3,11:1 sobre la tarjeta teñida por la elevación (#262223).
         gp_divider conserva el valor anterior para los separadores internos,
         que no delimitan nada. -->
    <color name="gp_background">#0B0C0E</color>
    <color name="gp_surface">#1B1E24</color>
    <color name="gp_surface_2">#252A31</color>
    <color name="gp_stroke">#676F7E</color>
    <color name="gp_divider">#4A505B</color>

    <!-- ── Texto ─────────────────────────────────────────────────────────── -->
    <color name="gp_on_surface">#F2F2F3</color>
    <!-- 7,05:1 sobre la tarjeta. Sustituye a los android:alpha sobre texto. -->
    <color name="gp_text_secondary">#A1A9B6</color>

    <!-- ── Cuerpo anatómico (mapa muscular estilo Symmetry) ──────────────── -->
    <!-- Silueta clara para que el cuerpo destaque sobre el fondo carbón
         (antes #3A3B42 se camuflaba); el músculo trabajado sigue en naranja -->
    <color name="body_silhouette">#A6A7AF</color>
    <color name="body_highlight">#FF6A00</color>

    <!-- ── Macros ────────────────────────────────────────────────────────── -->
    <!-- Un color por macro: tres barras del mismo color no codifican nada. -->
    <color name="gp_macro_proteinas">#6BA6F5</color>
    <color name="gp_macro_carbos">#E8A94B</color>
    <color name="gp_macro_grasas">#B295E8</color>

    <!-- ── Estados ───────────────────────────────────────────────────────── -->
    <color name="gp_success">#4ADE80</color>
    <color name="gp_success_container">#143323</color>
    <color name="gp_error">#F87171</color>
    <color name="gp_error_container">#3A1414</color>

    <!-- Pista del medidor de nivel: #353A43 frente a #FF6A00 da 3,98:1 (GP-078). -->
    <color name="gp_meter_track">#353A43</color>

    <!-- ── Alias legados usados por layouts existentes ───────────────────── -->
    <color name="on_surface">@color/gp_on_surface</color>
    <color name="primaryContainer_dark">#24252B</color>
    <color name="onPrimaryContainer_dark">#F2F2F3</color>
    <color name="surface_card">@color/gp_surface</color>
    <color name="surface_card_2">@color/gp_surface_2</color>
    <color name="text_secondary">@color/gp_text_secondary</color>

    <color name="green_chip">@color/gp_success_container</color>
    <color name="green_chip_text">@color/gp_success</color>
    <color name="red_chip">@color/gp_error_container</color>
    <color name="red_chip_text">@color/gp_error</color>
</resources>
