<?xml version="1.0" encoding="utf-8"?>
<!--
  colors.xml — paleta "atlética" de GymProFit (valores del MODO CLARO;
  values-night los sobrescribe para el modo oscuro, que es el por defecto).
  Naranja de marca como acento de energía, dorado del logo para racha/logros,
  neutros limpios. Los nombres son semánticos: los layouts no deben
  hardcodear hex, siempre @color/... o ?attr/...
-->
<resources>
    <!-- ── Marca ─────────────────────────────────────────────────────────── -->
    <!-- Naranja de marca, MISMO en los dos temas. Antes el claro era teal
         petróleo, así que la app cambiaba de identidad al cambiar de tema y
         peleaba con el logo, que es naranja siempre.
         En claro se oscurece a #B83E00 para que valga en los DOS papeles:
         5,63:1 como texto sobre blanco y 5,63:1 con blanco encima. El #FF6A00
         puro daba 2,56:1 como texto: deslumbra y no se lee. -->
    <color name="gp_primary">#B83E00</color>
    <color name="gp_on_primary">#FFFFFF</color>
    <color name="gp_primary_container">#FFE0CC</color>
    <color name="gp_on_primary_container">#5C1E00</color>
    <!-- El de Material 1.12 (GP-136): texto sobre colorSecondaryContainer, que no se fija. -->
    <color name="gp_on_secondary_container">#1D192B</color>
    <!-- Dorado del logo: reservado a récords y logros (DEC-018). Son DOS tokens
         porque el tema claro no admite uno solo (GP-063): el #B58A2A de antes daba
         2,80:1 como texto sobre el fondo. gp_gold es para lo gráfico —borde,
         icono— y pasa 3:1 sobre fondo y tarjeta; gp_gold_text es para letras y
         pasa 4,5:1. En oscuro los dos son el mismo color. -->
    <color name="gp_gold">#AE8528</color>
    <color name="gp_gold_text">#8A6920</color>
    <!-- Fondo del medallón de un logro conseguido. gp_gold encima da 3,10:1
         (GP-079, WCAG 1.4.11). Es muy claro a la fuerza: con el dorado gráfico
         que exige 3:1 sobre el fondo, no cabe un contenedor más saturado. -->
    <color name="gp_gold_container">#FFF4D9</color>
    <!-- Fila de la serie que batió el récord en la sesión en vivo (GP-210, momento 25):
         un dorado más suave que el contenedor, para que el aviso de arriba mande.
         El texto secundario (gp_text_secondary) da 6,31:1 encima. -->
    <color name="gp_gold_fila">#FFF8E6</color>

    <!-- ── Superficies ───────────────────────────────────────────────────── -->
    <!-- La tarjeta tiene que VERSE. Antes surface estaba a 1,07:1 del fondo y
         el borde a 1,15:1, con elevación 0: una MaterialCardView era un
         rectángulo invisible, y toda la app está construida sobre tarjetas.
         Surface queda a 1,13:1 del fondo, con 1dp de elevación (ver
         Widget.GymProFit.Card), que en claro tiñe la tarjeta a #FBF5F2.

         gp_stroke es el BORDE que delimita —tarjeta, campo, chip— y desde GP-063
         llega a 3:1 (WCAG 1.4.11) contra fondo, tarjeta y tarjeta teñida. Antes
         daba 1,66:1. gp_divider es el SEPARADOR decorativo de dentro de una
         tarjeta, que no delimita ningún componente: conserva el valor antiguo
         para no convertir cada lista en una rejilla. -->
    <color name="gp_background">#F1F1EE</color>
    <color name="gp_surface">#FFFFFF</color>
    <color name="gp_surface_2">#E8E8E3</color>
    <color name="gp_stroke">#8C8C7D</color>
    <color name="gp_divider">#C9C9C2</color>

    <!-- ── Texto ─────────────────────────────────────────────────────────── -->
    <color name="gp_on_surface">#17181C</color>
    <!-- 6,68:1 sobre blanco. Es el token que sustituye a los android:alpha
         sobre texto, que bajaban hasta 2,14:1 (ilegible). -->
    <color name="gp_text_secondary">#5A5C62</color>
    <!-- Texto secundario SOBRE LA MARCA (tarjetas naranjas de inicio, nutrición,
         perfil y administración). Sustituye a los alpha 0,7–0,85 que llevaba
         colorOnPrimary (GP-063): es la mezcla del 90 % ya hecha, 4,86:1 sobre
         gp_primary. -->
    <color name="gp_on_primary_secondary">#F8ECE6</color>

    <!-- ── Cuerpo anatómico (mapa muscular estilo Symmetry) ──────────────── -->
    <!-- Silueta neutra del cuerpo; el músculo trabajado se pinta en naranja -->
    <color name="body_silhouette">#D2D2D6</color>
    <color name="body_highlight">#F25C00</color>

    <!-- ── Macros ────────────────────────────────────────────────────────── -->
    <!-- Un color por macro: tres barras del mismo color no codifican nada.
         Los tres pasan 4,5:1 sobre fondo y tarjeta (GP-063): carbohidratos
         (#C27C12) daba 3,39:1 y proteínas (#2F6FD0) 4,31:1 sobre el fondo. -->
    <color name="gp_macro_proteinas">#2E6CCB</color>
    <color name="gp_macro_carbos">#99620E</color>
    <!-- El ámbar del nivel intermedio (Biblioteca, GP-216): el mismo de los carbohidratos, que
         ya pasa contraste en los dos temas; en oscuro lo da values-night. -->
    <color name="gp_nivel_intermedio">@color/gp_macro_carbos</color>
    <color name="gp_macro_grasas">#7A54C4</color>

    <!-- ── Estados ───────────────────────────────────────────────────────── -->
    <!-- 4,55:1 sobre su contenedor y 4,64:1 sobre el fondo (GP-063). El
         #1E8E4A de antes daba 3,63:1 en el chip y 3,69:1 sobre el fondo. -->
    <color name="gp_success">#1A7C41</color>
    <color name="gp_success_container">#DFF4E7</color>
    <color name="gp_error">#C62828</color>
    <color name="gp_error_container">#FDE9E9</color>

    <!-- Pista vacía del medidor de nivel (GP-078). Se mide contra la MARCA, no
         contra la tarjeta: lo que hay que distinguir es segmento lleno de vacío,
         y eso pide 3:1 (WCAG 1.4.11). #D6D6D0 frente a #B83E00 da 3,86:1.
         No reutiliza gp_stroke a propósito: el borde tiene que oscurecerse para
         delimitar la tarjeta, y cuanto más oscuro, menos se distingue de la marca. -->
    <!-- El agua (lote 1.6.8, tablero 1): el vaso y la gota en gp_agua (4,89:1 sobre la tarjeta blanca);
         el botón «Vaso», gp_on_agua_container sobre gp_agua_container (7,20:1). -->
    <!-- El brillo que cruza la barra dorada de la proteína con el día completo (momento 21). -->
    <color name="gp_brillo_oro">#B3FFF4D9</color>
    <color name="gp_agua">#0E7C8F</color>
    <color name="gp_agua_container">#D7F2F6</color>
    <color name="gp_on_agua_container">#0B5562</color>
    <color name="gp_meter_track">#D6D6D0</color>

    <!-- Tarjeta protagonista («Hoy toca», resúmenes): igual en los dos temas, como el velo.
         #FFF4E8 sobre #3A2110 da 13,78:1 y #FFD3B0 sobre #3A2110, 10,82:1 (medido en PaletaContrasteTest). -->
    <!-- Borde de las tarjetas dibujadas a mano (grupos de filas): outlineVariant en claro y el
         color de la superficie en oscuro, donde la tarjeta no lleva borde. -->
    <color name="gp_tarjeta_borde">@color/gp_divider</color>

    <!-- La cabecera del detalle de un programa (GP-216, tablero 31) lleva el color de su material;
         igual en los dos temas, con texto #FFF4E8 encima y fundiéndose con el fondo por abajo. -->
    <color name="gp_programa_gimnasio">#2A3A6A</color>
    <color name="gp_programa_mancuernas">#7A3A10</color>
    <color name="gp_programa_corporal">#0E5562</color>
    <color name="gp_hero">#3A2110</color>
    <!-- Los macros dentro de la tarjeta protagonista: los de oscuro en los dos temas, porque
         el fondo no cambia (sobre #3A2110: 5,95 a 7,27:1; los de claro daban menos de 3:1). -->
    <color name="gp_hero_macro_proteinas">#6BA6F5</color>
    <!-- La línea del peso de «Tu cuerpo» en Progreso (tablero 16): el azul de dato, no el naranja,
         que es de lo que se pulsa. Es el tono de la proteína en cada tema (5,09:1 en claro y 6,68:1 en oscuro sobre la tarjeta). -->
    <color name="gp_linea_peso">@color/gp_macro_proteinas</color>
    <!-- La insignia de «datos revisados» (ficha, filas de Añadir y escáner; lienzo de Nutrición): el
         azul de dato, con su propio nombre (GP-225). Sobre la tarjeta, 5,09:1 en claro y 6,68:1 en oscuro. -->
    <color name="gp_revisado">@color/gp_macro_proteinas</color>
    <color name="gp_hero_macro_carbos">#E8A94B</color>
    <color name="gp_hero_macro_grasas">#B295E8</color>
    <color name="gp_on_hero">#FFF4E8</color>
    <color name="gp_on_hero_variant">#FFD3B0</color>
    <!-- El botón principal dentro de la tarjeta protagonista: el naranja de oscuro y su texto. -->
    <color name="gp_primary_sobre_hero">#FF6A00</color>
    <color name="gp_on_primary_sobre_hero">#1A0E00</color>
    <!-- Dentro de la tarjeta protagonista de Apuntar entreno (GP-241, tablero Entreno-B): la píldora de
         la fecha y los tres cuadros. Igual en los dos temas, como la tarjeta: #FFF4E8 encima da 11,53:1
         y #FFD3B0, 9,05:1. Contra #3A2110 da 1,19:1: es un relleno, no delimita (el cuadro que se pulsa
         lo dice su texto y su lápiz). -->
    <color name="gp_hero_superficie">#4C2C15</color>
    <!-- El récord dentro de la tarjeta protagonista: el dorado y su contenedor de oscuro en los dos
         temas, como los macros (el de claro sobre #3A2110 era una píldora clara sobre oscuro). Texto
         #E8B84B sobre #3A2E12: 7,21:1. -->
    <color name="gp_hero_oro">#E8B84B</color>
    <color name="gp_hero_oro_fondo">#3A2E12</color>

    <!-- ── Alias legados (layouts existentes; apuntan a la paleta nueva) ──── -->
    <color name="primary_light">@color/gp_primary</color>
    <color name="on_primary_light">@color/gp_on_primary</color>
    <color name="surface_light">@color/gp_surface</color>
    <color name="on_surface_light">@color/gp_on_surface</color>
    <color name="background_light">@color/gp_background</color>
    <color name="primary_container_light">@color/gp_primary_container</color>
    <color name="on_primary_container_light">@color/gp_on_primary_container</color>

    <color name="primary_dark">#FF6A00</color>
    <color name="on_primary_dark">#FFFFFF</color>
    <color name="surface_dark">#1A1B1F</color>
    <color name="on_surface_dark">#F2F2F3</color>
    <color name="background_dark">#101114</color>

    <color name="golden">@color/gp_gold</color>
    <color name="golden_light">@color/gp_gold</color>
    <color name="orange_primary">@color/gp_primary</color>
    <color name="orange_dark">#FF8A3D</color>

    <color name="text_primary_dark">#F2F2F3</color>
    <color name="text_secondary_dark">#9EA0A8</color>

    <color name="black">#000000</color>
    <color name="white">#FFFFFF</color>

    <color name="on_surface">@color/gp_on_surface</color>
    <color name="primaryContainer_dark">#24252B</color>
    <color name="onPrimaryContainer_dark">#F2F2F3</color>

    <color name="surface_card">@color/gp_surface</color>
    <color name="surface_card_2">@color/gp_surface_2</color>
    <color name="text_secondary">@color/gp_text_secondary</color>

    <color name="green_chip">@color/gp_success_container</color>
    <color name="green_chip_text">@color/gp_success</color>
    <color name="red_chip">@color/gp_error_container</color>
    <color name="red_chip_text">@color/gp_error</color>

    <!-- Fondo del icono de la app (GP-081). Solo en values/: el icono del lanzador no
         cambia con el tema de la app. Es el fondo del tema oscuro, con el logo de la
         variante oscura encima (versión A, elegida por el propietario). -->
    <!-- Velo bajo la hoja del «+» (GP-105): negro al 62 %, igual en los dos temas. -->
    <color name="gp_velo">#9E000000</color>

    <!-- El escáner (lote 1.6.1) va siempre sobre la imagen de la cámara: sus textos, sus
    esquinas y el verde de «leído» son los del lienzo en los dos temas, no los del tema. -->
    <color name="gp_escaner_texto">#F2F2F3</color>
    <color name="gp_escaner_leido">#4ADE80</color>
    <color name="gp_escaner_velo">#C70B0C0E</color>

    <color name="ic_launcher_fondo">#0B0C0E</color>
    <!-- La G del arranque (GP-223): los colores del logo, medidos en documentacion/marca/logo.png (la
         mediana del interior de cada pieza). Son de la marca, no del tema: no cambian con el claro. -->
    <color name="logo_g_cuerpo">#EBBB3D</color>
    <color name="logo_g_trazo">#FF6100</color>
    <!-- La baldosa del logo único (GP-231, DEC-057): la del icono, para que la G se vea sobre claro.
         En values-night es transparente y la G va sola. Es de la marca, no un color de la interfaz. -->
    <color name="logo_baldosa">#0B0C0E</color>
    <!-- El brillo que cruza la G mientras se espera (GP-223): luz blanca al 40 %. -->
    <color name="gp_arranque_brillo">#66FFFFFF</color>
    <!-- La acción de un aviso invertido («Deshacer», lote 1.6.2): el naranja del otro tema, sobre el fondo oscuro del aviso en claro. -->
    <color name="gp_accion_inversa">#FF8A3D</color>

    <!-- Las miniaturas de la hoja «Tema» (GP-216, tablero 22): cada una enseña su tema entero, así que
         llevan los valores de los dos temas fijos y no cambian con el que esté puesto. Son los de
         gp_background, gp_surface y gp_on_surface de oscuro y de claro. Decoración: ningún texto va
         encima, y el nombre del tema va escrito debajo de cada una. -->
    <color name="gp_vista_tema_oscuro_fondo">#0B0C0E</color>
    <color name="gp_vista_tema_oscuro_tarjeta">#1B1E24</color>
    <color name="gp_vista_tema_oscuro_trazo">#F2F2F3</color>
    <color name="gp_vista_tema_claro_fondo">#F1F1EE</color>
    <color name="gp_vista_tema_claro_tarjeta">#FFFFFF</color>
    <color name="gp_vista_tema_claro_trazo">#17181C</color>

    <!-- El botón «Eliminar mi cuenta» (GP-216, tablero 21): el rojo de error del tema claro y blanco encima
         (5,62:1), igual en los dos temas. Con el #F87171 del tema oscuro el blanco daba 2,6:1 y por eso el
         botón era de contorno; relleno y con este rojo se lee en los dos. -->
    <color name="gp_eliminar_fondo">#C62828</color>
    <color name="gp_eliminar_texto">#FFFFFF</color>
    <!-- GP-265: la tarjeta destacada de «Tu objetivo» en Perfil. En claro, casi negra con
         texto claro; en oscuro, superficie elevada con borde fino (values-night). -->
    <color name="gp_objetivo_fondo">#17181C</color>
    <color name="gp_objetivo_borde">#17181C</color>
    <color name="gp_objetivo_texto">#F2F2F3</color>
    <color name="gp_objetivo_texto_2">#B9BEC8</color>
    <color name="gp_objetivo_ficha">#2A2C32</color>
    <color name="gp_objetivo_contorno">#8A909B</color>
    <!-- El cuadro del icono: el naranja vivo en los dos temas, porque va sobre fondo oscuro. -->
    <color name="gp_objetivo_icono_fondo">#FF6A00</color>
    <color name="gp_objetivo_icono">#1A0E00</color>
    <!-- GP-045: el halo de la caja activa del código (naranja al 20 %). -->
    <color name="gp_codigo_halo">#33B83E00</color>
    <!-- GP-045: el check sobre el círculo dorado, casi negro en los dos temas. -->
    <color name="gp_sobre_oro">#17181C</color>
    <!-- ── Liquid Glass (GP-285, DEC-070) ─────────────────────────────────────
         Tema claro, rehecho en el lote 1b: el cristal solo se lee si el fondo tiene color y la
         tarjeta deja pasar parte de él (el del lote 1 eran tarjetas blancas casi opacas sobre un
         fondo lavado, y el propietario lo rechazó). Valores del propietario; donde uno choca con
         una regla de legibilidad manda la regla (DEC-070) y queda escrito aquí con su cifra.
         Todo medido en ContrasteCristalTest; cifras en DESIGN.md. -->
    <!-- Fondo ambiental: base cálida y cuatro brillos (naranja 55 %, coral 30 %, azul 36 % y,
         solo en claro, verde 26 % abajo a la izquierda). -->
    <color name="gp_ambiente_base">#F2EDE8</color>
    <color name="gp_ambiente_brillo_1">#8CFF7A28</color>
    <color name="gp_ambiente_brillo_2">#4DFF606E</color>
    <color name="gp_ambiente_brillo_3">#5C507DFF</color>
    <color name="gp_ambiente_brillo_4">#423CBEA0</color>
    <!-- Fondo de la Sesión en vivo (lote 2; Ambiente.sesion): naranja arriba a la derecha, dorado
         a la izquierda y azul abajo a la derecha. No hay maqueta en claro. -->
    <color name="gp_ambiente_sesion_1">#8CFF7A28</color>
    <color name="gp_ambiente_sesion_2">#73E8B84B</color>
    <color name="gp_ambiente_sesion_3">#5C507DFF</color>
    <!-- «Descartar la sesión», texto sobre el fondo, sin cristal debajo. -->
    <color name="gp_cristal_error">#9A1010</color>
    <!-- La fila dorada de un récord en la Sesión en vivo: en claro no lleva surco, y lo que se
         escribe encima va en un dorado más oscuro que el de la tarjeta. -->
    <color name="gp_cristal_oro_surco">#00000000</color>
    <color name="gp_cristal_oro_fila">#6B4F12</color>
    <!-- El acento sobre la lente de la serie en curso (su número, sus kilos y su aro). -->
    <color name="gp_cristal_lente_acento">@color/gp_cristal_acento</color>
    <!-- La barra del descanso que se vacía. -->
    <color name="gp_cristal_descanso_alto">#A33800</color>
    <color name="gp_cristal_descanso_bajo">#A33800</color>
    <!-- El campo de una serie (kg, reps, tiempo), remate del lote 2: cristal estático con el
         relleno de las tarjetas (el surco, tinta al 10 %, se leía como una caja gris opaca). Su
         canto sigue en tinta (gp_cristal_barra_tenue, 3:1). -->
    <color name="gp_cristal_campo_alto">@color/gp_cristal_alto</color>
    <color name="gp_cristal_campo_medio">@color/gp_cristal_medio</color>
    <color name="gp_cristal_campo_bajo">@color/gp_cristal_bajo</color>
    <!-- Cristal estático: relleno a 160° blanco 62 % → 34 % (al 55 %) → 48 %, borde blanco 80 %,
         brillo superior blanco 100 %, línea inferior blanca 40 %, filo exterior de 0,5 dp y
         sombra suave (28 dp de difuminado, 10 hacia abajo), que en oscuro no hay. -->
    <color name="gp_cristal_alto">#9EFFFFFF</color>
    <color name="gp_cristal_medio">#57FFFFFF</color>
    <color name="gp_cristal_bajo">#7AFFFFFF</color>
    <color name="gp_cristal_borde">#CCFFFFFF</color>
    <color name="gp_cristal_brillo">#FFFFFFFF</color>
    <color name="gp_cristal_brillo_bajo">#66FFFFFF</color>
    <color name="gp_cristal_filo">#0F3C1E0A</color>
    <color name="gp_cristal_sombra">#1F5A280A</color>
    <!-- Texto. Tres valores del propietario se oscurecen lo justo para llegar a 4,5:1 sobre el
         punto más desfavorable (el brillo naranja al 55 %, que no se toca: es el que hace que el
         cristal se lea): el secundario, #4A4F58 → #494E57 (4,47 → 4,54 sobre el fondo); el
         acento sobre cristal, #A83A00 → #A33800 (4,32 → 4,53); y el enlace, que va sobre el
         fondo sin cristal debajo, #A83A00 → #8B3000 (3,48 → 4,52). -->
    <color name="gp_cristal_texto">#15171B</color>
    <color name="gp_cristal_texto_2">#494E57</color>
    <color name="gp_cristal_acento">#A33800</color>
    <color name="gp_cristal_enlace">#8B3000</color>
    <color name="gp_cristal_exito">#12693A</color>
    <!-- El relleno del círculo de una serie hecha sobre cristal: el mismo verde, tenue. -->
    <color name="gp_cristal_exito_fondo">#2912693A</color>
    <!-- Dorado de texto sobre cristal: con el cristal nuevo, #7A5C18 se quedaba en 4,19:1. -->
    <color name="gp_cristal_oro">#745717</color>
    <color name="gp_cristal_oro_cifra">#7A5C18</color>
    <!-- La marca de un gráfico pequeño sobre cristal (el icono de un ejercicio, la barra de
         «esta vez» de un entreno): el acento, que pasa de 3:1 solo. Y sus barras apagadas. -->
    <color name="gp_cristal_grafico">#A33800</color>
    <!-- La silueta muscular sobre cristal. El cuerpo: el gris de la tarjeta opaca (#D2D2D6) se
         quedaba en 1,39:1 contra el cristal y casi no se veía; va en «tinta», como el texto. Y
         sus zonas trabajadas, en el naranja vivo: con un cuerpo a media luz (#737579) y el
         naranja oscuro del tema, la zona quedaba a 1,2:1 del cuerpo y solo se distinguía por el
         tono; así pasa de 3:1 a pleno color (ContrasteCristalTest). -->
    <color name="gp_cristal_silueta">#45474C</color>
    <color name="gp_cristal_silueta_marca">#FF6A00</color>
    <color name="gp_cristal_barra_tenue">#8015171B</color>
    <!-- La gráfica de kilos: la semana en curso en el naranja vivo y las demás en naranja al
         28 %, como pide el diseño. Ninguno de los dos llega a 3:1 contra el cristal (1,93:1 y
         1,22:1), así que cada barra lleva un filo de 1 dp en el acento, que sí (4,53:1): la
         forma de la barra se lee por el filo y el color es el del diseño. -->
    <color name="gp_cristal_kilos">#FF6A00</color>
    <color name="gp_cristal_kilos_tenue">#47FF6A00</color>
    <color name="gp_cristal_kilos_filo">#A33800</color>
    <!-- Barras de progreso: la pista del diseño (casi negro al 10 %) y, contra ella, el relleno
         de proteína y de agua un punto más oscuro que el de la tarjeta opaca (#2E6CCB y #0E7C8F
         se quedaban en 2,82:1 y 2,71:1 contra su pista). -->
    <color name="gp_cristal_pista">#1A15171B</color>
    <color name="gp_cristal_proteinas">#2C67C1</color>
    <color name="gp_cristal_agua">#0D7385</color>
    <!-- Cristal vivo (barra, barra de sesión, hoja del «+»): el mismo relleno del estático sobre
         el desenfoque (niveles 1 y 2) y, en el nivel 3, ese relleno ya compuesto sobre el fondo
         base, opaco. El velo de detrás de la hoja del «+», negro 35 %. -->
    <color name="gp_vivo_alto">#9EFFFFFF</color>
    <color name="gp_vivo_medio">#57FFFFFF</color>
    <color name="gp_vivo_bajo">#7AFFFFFF</color>
    <color name="gp_velo_cristal">#59000000</color>
    <color name="gp_vivo_opaco_alto">#FAF8F6</color>
    <color name="gp_vivo_opaco_bajo">#F8F6F3</color>
    <!-- La hoja del «+» lleva más tinte que la barra (blanco 80 % → 70 %): con el del diseño y
         el velo detrás, su texto secundario se quedaba en 3,44:1. -->
    <color name="gp_vivo_hoja_alto">#CCFFFFFF</color>
    <color name="gp_vivo_hoja_bajo">#B3FFFFFF</color>
    <color name="gp_vivo_texto">#2A2E35</color>
    <color name="gp_vivo_acento">#A83A00</color>
    <!-- La acción de la barra de la sesión («Volver») y su icono: sobre la barra, fuera de la
