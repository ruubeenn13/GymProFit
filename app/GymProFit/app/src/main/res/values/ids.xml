<?xml version="1.0" encoding="utf-8"?>
<!--
  Identificadores que no pertenecen a ningún layout: se usan como clave de
  View.setTag(int, Object), que exige un id de recurso para no pisar los tags
  de otras librerías.
-->
<resources>
    <!-- Guarda el padding que traía escrito el layout antes de sumarle los insets
         del sistema. Ver InsetsUtils. -->
    <item name="tag_padding_original" type="id"/>
    <!-- Marca el scroller de una pestaña al que ya se le ha sumado el hueco de la
         barra flotante, para no sumárselo dos veces. Ver BaseFragment. -->
    <item name="tag_hueco_barra_reservado" type="id"/>
    <!-- Cómo dejaron el XML y el adapter cada campo de una serie, para volver a ponerlos
         en fila después de apilarlos. Ver CamposSerie. -->
    <item name="campos_serie_guardado" type="id"/>
    <!-- El borde que tenía una tarjeta antes de ponerle el anillo de foco. Ver FocoTarjeta. -->
    <item name="tag_borde_tarjeta" type="id"/>
    <!-- La ventana ya escucha el foco para el anillo de las tarjetas. Ver FocoTarjeta. -->
    <item name="tag_foco_tarjeta" type="id"/>
    <!-- Si la raíz de una pestaña era enfocable antes de apartarla del foco. Ver MainActivity. -->
    <item name="tag_enfocable_original" type="id"/>

</resources>
