<?xml version="1.0" encoding="utf-8"?>
<!--
  arrays.xml — arrays de valores fijos usados en spinners y filtros.
  Niveles de dificultad, grupos musculares y categorías de alimentos (deben coincidir con los enums del backend).
-->
<resources>
    <!-- Niveles de dificultad de rutinas/ejercicios -->
    <string-array name="niveles">
        <item>PRINCIPIANTE</item>
        <item>INTERMEDIO</item>
        <item>AVANZADO</item>
    </string-array>

    <!-- Grupos musculares para filtrar ejercicios -->
    <string-array name="grupos_musculares">
        <item>PECHO</item>
        <item>ESPALDA</item>
        <item>PIERNAS</item>
        <item>HOMBROS</item>
        <item>BRAZOS</item>
        <item>ABDOMEN</item>
        <item>CARDIO</item>
        <item>FULLBODY</item>
    </string-array>

    <!-- Categorías de alimentos para el catálogo de nutrición -->
    <string-array name="categorias_alimento">
        <item>Carnes y aves</item>
        <item>Pescado y marisco</item>
        <item>Huevos</item>
        <item>Lácteos</item>
        <item>Legumbres</item>
        <item>Cereales y pan</item>
        <item>Frutas</item>
        <item>Verduras</item>
        <item>Frutos secos</item>
        <item>Aceites y grasas</item>
        <item>Bebidas</item>
        <item>Suplementos</item>
        <item>Snacks</item>
        <item>Otro</item>
    </string-array>
    <!-- Las opciones de cada SelectorPildora que se monta desde el layout (GP-224). -->
    <string-array name="selector_niveles">
        <item>@string/rutinas_principiante</item>
        <item>@string/rutinas_intermedio</item>
        <item>@string/rutinas_avanzado</item>
    </string-array>
    <!-- 4 sem. · 8 sem. · Todo: la gráfica de la ficha del ejercicio y «Kilos movidos» de Progreso
         (GP-216, lote 4). El nombre para TalkBack dice «semanas» entero. -->
    <string-array name="selector_periodos_semanas">
        <item>@string/detalle_periodo_4</item>
        <item>@string/detalle_periodo_8</item>
        <item>@string/detalle_periodo_todo</item>
    </string-array>
    <string-array name="selector_periodos_semanas_nombres">
        <item>@string/detalle_periodo_4_nombre</item>
        <item>@string/detalle_periodo_8_nombre</item>
        <item>@string/detalle_periodo_todo</item>
    </string-array>
    <!-- Pestañas de la ficha del ejercicio. -->
    <string-array name="selector_pestanas_ficha">
        <item>@string/detalle_ejercicio_tab_progreso</item>
        <item>@string/detalle_ejercicio_tab_como</item>
    </string-array>
    <string-array name="selector_periodos">
        <item>@string/stats_periodo_semana</item>
        <item>@string/stats_periodo_mes</item>
    </string-array>
    <string-array name="selector_metricas">
        <item>@string/grafica_met_peso</item>
        <item>@string/grafica_met_grasa</item>
        <item>@string/grafica_met_cintura</item>
    </string-array>
    <string-array name="selector_rangos">
        <item>@string/grafica_rango_30</item>
        <item>@string/grafica_rango_90</item>
        <item>@string/grafica_rango_todo</item>
    </string-array>
    <string-array name="selector_sexos">
        <item>@string/onboarding_hombre</item>
        <item>@string/onboarding_mujer</item>
    </string-array>
</resources>
