<?xml version="1.0" encoding="utf-8"?>
<!--
  Atributos del cristal de Liquid Glass (GP-285, DEC-070).
  Cristal es el drawable del cristal estático (<drawable class=…> en bg_cristal*.xml);
  CristalVivo, la vista que desenfoca lo que tiene detrás.
-->
<resources>
    <!-- Radio de las esquinas; sin él, la mitad del alto (píldora). -->
    <attr name="cristalRadio" format="dimension" />
    <attr name="cristalSombra" format="boolean" />

    <declare-styleable name="Cristal">
        <attr name="cristalRadio" />
        <!-- Qué cristal es: ver Cristal.java. -->
        <attr name="cristalTipo" format="enum">
            <enum name="tarjeta" value="0" />
            <enum name="lente" value="1" />
            <enum name="oro" value="2" />
            <enum name="oro_fila" value="3" />
            <enum name="marca" value="7" />
            <enum name="campo" value="8" />
            <enum name="campo_foco" value="9" />
        </attr>
    </declare-styleable>

    <!-- Los colores de una gráfica dibujada a mano (BarrasKilosView, BarrasVecesView): la barra
         destacada y las demás. En el tema, el naranja y el borde; sobre cristal, los medidos ahí. -->
    <attr name="gpGraficoMarca" format="color" />
    <attr name="gpGraficoTenue" format="color" />
    <attr name="gpGraficoOro" format="color" />
    <!-- El gris del cuerpo de la silueta muscular (SiluetaMuscularView). -->
    <attr name="gpSilueta" format="color" />
    <!-- El color de sus zonas trabajadas, a pleno color (con menos series va con menos alfa). -->
    <attr name="gpSiluetaMarca" format="color" />
    <!-- La gráfica de kilos (BarrasKilosView): la semana en curso, las demás y el filo de cada
         barra (transparente: sin filo). -->
    <attr name="gpGraficoKilos" format="color" />
    <attr name="gpGraficoKilosTenue" format="color" />
    <attr name="gpGraficoKilosFilo" format="color" />

    <!-- BotonCristal encima de un cristal vivo (el panel del descanso): cristal estático también
         en el nivel 3, donde el panel ya es opaco y un botón opaco no se distinguiría de él. -->
    <declare-styleable name="BotonCristal">
        <attr name="cristalSobreVivo" format="boolean" />
    </declare-styleable>

    <declare-styleable name="CristalVivo">
        <attr name="cristalRadio" />
        <!-- Sombra suave por fuera. El padre no puede recortar a sus hijos. -->
        <attr name="cristalSombra" />
        <!-- Tinte con más cuerpo (gp_vivo_hoja_*): la hoja del «+», que lleva texto secundario. -->
        <attr name="cristalGrueso" format="boolean" />
    </declare-styleable>

    <!-- La tarjeta de cristal estático. En claro lleva sombra por fuera, salvo que vaya dentro
         de otra tarjeta: cristalSombra="false". -->
    <declare-styleable name="TarjetaCristal">
        <attr name="cristalSombra" />
    </declare-styleable>
</resources>
