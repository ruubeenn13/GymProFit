<?xml version="1.0" encoding="utf-8"?>
<!--
  dimens.xml — la escala tipográfica de GymProFit.

  Antes había 21 tamaños de texto distintos repartidos por los 66 layouts, en 323
  apariciones escritas a mano: 13, 14, 15, 16, 17 y 18 sp convivían para hacer
  exactamente el mismo trabajo. Eso no es un sistema, es colocar a ojo, y es una
  de las cosas que más delatan a una app hecha a trozos.

  Once escalones, y ninguno más. Ningún layout vuelve a escribir un sp a pelo.

  2026-09-25: la escala baja. Cuando se retiró el multiplicador de 1,18 de
  ScaleUtils, estos valores se rebasaron para que en pantalla no cambiara nada, y se
  quedaron grandes: cuerpo a 17 sp, titulares a 26, títulos de pantalla a 34-40. El
  propietario vio toda la app demasiado grande. Ahora el cuerpo es 15 sp y cada
  escalón sube alrededor de un 15 % sobre el anterior, así que las proporciones entre
  niveles son regulares. El suelo sigue en 13 sp (GP-089).
-->
<resources>

    <!-- ── Escala tipográfica ─────────────────────────────────────────────── -->

    <!-- Etiqueta en mayúsculas sobre una cifra. Sustituye a 10 y 11 sp.
         Es el suelo de la escala: ningún texto de la app baja de 13 sp (GP-089). -->
    <dimen name="text_eyebrow">13sp</dimen>

    <!-- Botones, chips y etiquetas de campo. Sustituye a 12 sp. -->
    <dimen name="text_label">14sp</dimen>

    <!-- Texto secundario: descripciones, metadatos. Sustituye a 13 sp. -->
    <dimen name="text_caption">14sp</dimen>

    <!-- Cuerpo. Es el tamaño más usado de la app. Sustituye a 14 y 15 sp. -->
    <dimen name="text_body">15sp</dimen>

    <!-- Fila de lista y nombre en tarjetas pequeñas de la estructura de GP-105 (hoja
         del «+», comidas, plantillas, récords de Progreso). El lienzo aprobado el
         27-09-2026 lo pide a 16 sp, entre cuerpo y subtítulo. -->
    <dimen name="text_fila">16sp</dimen>

    <!-- Título de fila o de tarjeta. Sustituye a 16 y 17 sp. -->
    <dimen name="text_subtitle">17sp</dimen>

    <!-- Cabecera de sección. Sustituye a 18 y 20 sp. -->
    <dimen name="text_title">19sp</dimen>

    <!-- Titular de tarjeta grande. Sustituye a 22, 24 y 26 sp. -->
    <dimen name="text_headline">22sp</dimen>

    <!-- Título de pantalla. Sustituye a 28, 30 y 32 sp. -->
    <dimen name="text_display">26sp</dimen>

    <!-- Título de pantalla grande. Sustituye a 34 y 40 sp. -->
    <dimen name="text_display_large">30sp</dimen>

    <!-- Cifra de estadística. Sustituye a 52 y 60 sp. -->
    <dimen name="text_number">44sp</dimen>

    <!-- La cifra protagonista de una pantalla. Sustituye a 64 sp. -->
    <dimen name="text_number_hero">56sp</dimen>



    <!-- Sesión en vivo (GP-012): hueco libre al final de la lista para el descanso (GP-013). -->
    <dimen name="envivo_hueco_descanso">160dp</dimen>
    <!-- Ancho de la columna del número de serie. -->
    <dimen name="envivo_col_serie">40dp</dimen>
</resources>
