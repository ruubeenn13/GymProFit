<?xml version="1.0" encoding="utf-8"?>
<!--
  dimens.xml — la escala tipográfica de GymProFit.

  Antes había 21 tamaños de texto distintos repartidos por los 66 layouts, en 323
  apariciones escritas a mano: 13, 14, 15, 16, 17 y 18 sp convivían para hacer
  exactamente el mismo trabajo. Eso no es un sistema, es colocar a ojo, y es una
  de las cosas que más delatan a una app hecha a trozos.

  Once escalones, y ninguno más. Ningún layout vuelve a escribir un sp a pelo.

  2026-09-25: la escala baja. Cuando se retiró el multiplicador de 1,18 de
  ScaleUtils, estos valores se rebasaron para que en pantalla no cambiara nada, y se
  quedaron grandes: cuerpo a 17 sp, titulares a 26, títulos de pantalla a 34-40. El
  propietario vio toda la app demasiado grande. Ahora el cuerpo es 15 sp y cada
  escalón sube alrededor de un 15 % sobre el anterior, así que las proporciones entre
  niveles son regulares. El suelo sigue en 13 sp (GP-089).
-->
<resources>

    <!-- ── Escala tipográfica ─────────────────────────────────────────────── -->

    <!-- Etiqueta en mayúsculas sobre una cifra. Sustituye a 10 y 11 sp.
         Es el suelo de la escala: ningún texto de la app baja de 13 sp (GP-089). -->
    <dimen name="text_eyebrow">13sp</dimen>

    <!-- Botones, chips y etiquetas de campo. Sustituye a 12 sp. -->
    <dimen name="text_label">14sp</dimen>

    <!-- Texto secundario: descripciones, metadatos. Sustituye a 13 sp. -->
    <dimen name="text_caption">14sp</dimen>

    <!-- Cuerpo. Es el tamaño más usado de la app. Sustituye a 14 y 15 sp. -->
    <dimen name="text_body">16sp</dimen>

    <!-- Fila de lista y nombre en tarjetas pequeñas de la estructura de GP-105 (hoja
         del «+», comidas, plantillas, récords de Progreso). El lienzo aprobado el
         27-09-2026 lo pide a 16 sp, entre cuerpo y subtítulo. -->
    <dimen name="text_fila">16sp</dimen>

    <!-- Título de fila o de tarjeta. Sustituye a 16 y 17 sp. -->
    <dimen name="text_subtitle">16sp</dimen>

    <!-- Cabecera de sección. Sustituye a 18 y 20 sp. -->
    <dimen name="text_title">20sp</dimen>

    <!-- Titular de tarjeta grande. Sustituye a 22, 24 y 26 sp. -->
    <dimen name="text_headline">20sp</dimen>

    <!-- Título de pantalla. Sustituye a 28, 30 y 32 sp. -->
    <dimen name="text_display">26sp</dimen>

    <!-- Título de pantalla grande. Sustituye a 34 y 40 sp. -->
    <dimen name="text_display_large">34sp</dimen>

    <!-- Cifra de estadística. Sustituye a 52 y 60 sp. -->
    <dimen name="text_number">44sp</dimen>

    <!-- La cifra protagonista de una pantalla. Sustituye a 64 sp. -->
    <dimen name="text_number_hero">56sp</dimen>

    <!-- La cifra del resumen del entreno (tablero 3 de GP-210, «8.420»): la única que se cuenta
         desde cero a 72 px del lienzo. Solo la usa el resumen; el resto de cifras héroe, 56. -->
    <dimen name="text_number_gigante">72sp</dimen>


    <!-- ══ Cimientos de GP-210 paso 2 / GP-216: espaciado, radios y piezas ══════════
         Nada de esto se escribe a mano en un layout: se pide por nombre. Los números
         son los de DESIGN.md («Cimientos»). -->

    <!-- Espaciado: 4, 8, 12, 16, 20, 24, 28 y 36 dp. -->
    <dimen name="espacio_4">4dp</dimen>
    <dimen name="espacio_8">8dp</dimen>
    <dimen name="espacio_12">12dp</dimen>
    <dimen name="espacio_16">16dp</dimen>
    <dimen name="espacio_20">20dp</dimen>
    <dimen name="espacio_24">24dp</dimen>
    <dimen name="espacio_28">28dp</dimen>
    <dimen name="espacio_36">36dp</dimen>
    <!-- Margen lateral de pantalla, entre secciones (36 en las pestañas, 28 en las
         subpantallas) y del título de sección a su contenido. -->
    <dimen name="margen_pantalla">20dp</dimen>
    <!-- Para que un carrusel dentro de una columna con margen_pantalla llegue a los bordes
         (Logros de Progreso): margen negativo y el mismo relleno, con clipToPadding="false". -->
    <dimen name="margen_pantalla_fuera">-20dp</dimen>
    <dimen name="separacion_pestana">36dp</dimen>
    <dimen name="separacion_subpantalla">28dp</dimen>
    <dimen name="titulo_a_contenido">14dp</dimen>
    <!-- Logros de Progreso (GP-216, lote 4, tablero 16): medallón de 72 con borde de 3 y su
         icono de 34, en una columna de 120. La línea del peso de «Tu cuerpo», 90 de alto. -->
    <dimen name="logro_carrusel_ancho">120dp</dimen>
    <dimen name="logro_medallon">72dp</dimen>
    <dimen name="logro_medallon_borde">3dp</dimen>
    <dimen name="logro_medallon_icono">34dp</dimen>
    <dimen name="linea_peso_alto">90dp</dimen>
    <!-- Ancho de una tarjeta de carrusel (Inicio, «Lo que te encaja» en Añadir). -->
    <dimen name="tarjeta_carrusel">220dp</dimen>

    <!-- Radios. Botones y píldoras: la mitad de su altura (cornerSize 50 %). -->
    <dimen name="radio_chip">12dp</dimen>
    <dimen name="radio_miniatura">16dp</dimen>
    <dimen name="radio_tarjeta_pequena">20dp</dimen>
    <dimen name="radio_tarjeta">24dp</dimen>
    <dimen name="radio_protagonista">28dp</dimen>

    <!-- Borde de la tarjeta estándar: 1 dp en claro, ninguno en oscuro (values-night). -->
    <dimen name="tarjeta_borde">1dp</dimen>

    <!-- Zona táctil mínima (DEC-019): 48 dp. -->
    <dimen name="zona_tactil">48dp</dimen>
    <!-- Hueco entre los tramos de la barra de reparto de una comida. -->
    <dimen name="reparto_hueco">2dp</dimen>

    <!-- Selector de opciones (GP-224): pista de 48 dp con 4 de relleno, píldora y opción de 40,
         anillo de foco de 2 dp; pulsado, capa del 10 %; desactivado, al 38 %. -->
    <dimen name="selector_relleno">4dp</dimen>
    <dimen name="selector_opcion_alto">40dp</dimen>
    <dimen name="selector_anillo_foco">2dp</dimen>
    <item name="selector_capa_pulsado" format="float" type="dimen">0.10</item>
    <item name="alfa_desactivado" format="float" type="dimen">0.38</item>

    <!-- Fila de lista: 64 dp mínimo, 16 a los lados, icono en círculo de 40 y separador
         con sangría hasta el texto (16 + 40 + 14 = 70). -->
    <dimen name="fila_alto_min">64dp</dimen>
    <dimen name="fila_padding_horizontal">16dp</dimen>
    <dimen name="fila_icono_circulo">40dp</dimen>
    <dimen name="fila_icono">22dp</dimen>
    <dimen name="fila_icono_a_texto">14dp</dimen>
    <dimen name="fila_sangria_separador">70dp</dimen>
    <dimen name="separador_alto">1dp</dimen>

    <!-- Cabecera de sección: el enlace de la derecha mide 44 dp de alto. -->
    <dimen name="seccion_enlace_alto">48dp</dimen>

    <!-- Avatar de cabecera: 48 dp, borde de 2 dp en naranja. -->
    <dimen name="avatar_cabecera">48dp</dimen>
    <dimen name="avatar_cabecera_borde">2dp</dimen>

    <!-- Botones que cambian de forma al pulsar (Expressive): de 26 a 12 dp. -->
    <dimen name="boton_radio_reposo">26dp</dimen>
    <dimen name="boton_radio_pulsado">12dp</dimen>

    <!-- Hojas inferiores propias: atrás predictivo, esquinas de 28 dp. -->
    <dimen name="hoja_radio_atras">28dp</dimen>

    <!-- Roles de texto (los de DESIGN.md): título de pantalla 34, cifra 26 a 48, sección 20,
         cuerpo 16 y apoyo 13 a 14. Los escalones de arriba (text_*) apuntan a estos tamaños. -->
    <dimen name="text_enlace_seccion">15sp</dimen>
    <dimen name="text_cifra_pequena">26sp</dimen>
    <dimen name="text_cifra_grande">48sp</dimen>

    <!-- Sesión en vivo (GP-012): hueco libre al final de la lista para el descanso (GP-013). -->
    <dimen name="envivo_hueco_descanso">160dp</dimen>
    <!-- La cuenta atrás del descanso: grande, se lee de un vistazo (GP-013). -->
    <dimen name="envivo_descanso_numero">46sp</dimen>
    <!-- Ancho de la columna del número de serie. 48 y no 40: con letra 1,3 «SERIE» tocaba a «ANTERIOR». -->
    <dimen name="envivo_col_serie">48dp</dimen>
    <!-- GP-216: el anillo de la cámara del avatar de Perfil y el borde de una opción de la hoja de elegir. -->
    <dimen name="avatar_camara_anillo">3dp</dimen>
    <dimen name="opcion_borde">2dp</dimen>
    <!-- Interlineado del título de una fila (GP-216): 22 sp para 16 sp de texto. -->
    <dimen name="linea_titulo_fila">22sp</dimen>
    <!-- Lo que el enlace de una cabecera de sección sale hacia fuera para que su aire (el del anillo de
         foco) no lo meta hacia dentro: menos espacio_8. -->
    <dimen name="enlace_aire_fuera">-8dp</dimen>
</resources>
