<?xml version="1.0" encoding="utf-8"?>
<!--
  dimens.xml — la escala tipográfica de GymProFit.

  Antes había 21 tamaños de texto distintos repartidos por los 66 layouts, en 323
  apariciones escritas a mano: 13, 14, 15, 16, 17 y 18 sp convivían para hacer
  exactamente el mismo trabajo. Eso no es un sistema, es colocar a ojo, y es una
  de las cosas que más delatan a una app hecha a trozos.

  Once escalones, y ninguno más. Ningún layout vuelve a escribir un sp a pelo.

  2026-09-25: la escala baja. Cuando se retiró el multiplicador de 1,18 de
  ScaleUtils, estos valores se rebasaron para que en pantalla no cambiara nada, y se
  quedaron grandes: cuerpo a 17 sp, titulares a 26, títulos de pantalla a 34-40. El
  propietario vio toda la app demasiado grande. Ahora el cuerpo es 15 sp y cada
  escalón sube alrededor de un 15 % sobre el anterior, así que las proporciones entre
  niveles son regulares. El suelo sigue en 13 sp (GP-089).
-->
<resources>

    <!-- ── Escala tipográfica ─────────────────────────────────────────────── -->

    <!-- Etiqueta en mayúsculas sobre una cifra. Sustituye a 10 y 11 sp.
         Es el suelo de la escala: ningún texto de la app baja de 13 sp (GP-089). -->
    <dimen name="text_eyebrow">13sp</dimen>
    <!-- Lo que mide text_eyebrow a letra 1,0, en dp: el suelo de un rótulo que encoge para caber. -->
    <dimen name="text_eyebrow_minimo">13dp</dimen>

    <!-- Botones, chips y etiquetas de campo. Sustituye a 12 sp. -->
    <dimen name="text_label">14sp</dimen>

    <!-- Texto secundario: descripciones, metadatos. Sustituye a 13 sp. -->
    <dimen name="text_caption">14sp</dimen>

    <!-- Cuerpo. Es el tamaño más usado de la app. Sustituye a 14 y 15 sp. -->
    <dimen name="text_body">16sp</dimen>

    <!-- Fila de lista y nombre en tarjetas pequeñas de la estructura de GP-105 (hoja
         del «+», comidas, plantillas, récords de Progreso). El lienzo aprobado el
         27-09-2026 lo pide a 16 sp, entre cuerpo y subtítulo. -->
    <dimen name="text_fila">16sp</dimen>

    <!-- Título de fila o de tarjeta. Sustituye a 16 y 17 sp. -->
    <dimen name="text_subtitle">16sp</dimen>

    <!-- Cabecera de sección. Sustituye a 18 y 20 sp. -->
    <dimen name="text_title">20sp</dimen>

    <!-- Titular de tarjeta grande. Sustituye a 22, 24 y 26 sp. -->
    <dimen name="text_headline">20sp</dimen>

    <!-- Título de pantalla. Sustituye a 28, 30 y 32 sp. -->
    <dimen name="text_display">26sp</dimen>

    <!-- Título de pantalla grande. Sustituye a 34 y 40 sp. -->
    <dimen name="text_display_large">34sp</dimen>

    <!-- Cifra de estadística. Sustituye a 52 y 60 sp. -->
    <dimen name="text_number">44sp</dimen>

    <!-- La cifra protagonista de una pantalla. Sustituye a 64 sp. -->
    <dimen name="text_number_hero">56sp</dimen>

    <!-- La cifra del resumen del entreno (tablero 3 de GP-210, «8.420»): la única que se cuenta
         desde cero a 72 px del lienzo. Solo la usa el resumen; el resto de cifras héroe, 56. -->
    <dimen name="text_number_gigante">72sp</dimen>


    <!-- ══ Cimientos de GP-210 paso 2 / GP-216: espaciado, radios y piezas ══════════
         Nada de esto se escribe a mano en un layout: se pide por nombre. Los números
         son los de DESIGN.md («Cimientos»). -->

    <!-- Espaciado: 4, 8, 12, 16, 20, 24, 28 y 36 dp. -->
    <dimen name="espacio_4">4dp</dimen>
    <dimen name="espacio_8">8dp</dimen>
    <dimen name="espacio_12">12dp</dimen>
    <dimen name="espacio_16">16dp</dimen>
    <dimen name="espacio_20">20dp</dimen>
    <dimen name="espacio_24">24dp</dimen>
    <dimen name="espacio_28">28dp</dimen>
    <dimen name="espacio_36">36dp</dimen>
    <!-- Icono de view_estado (GP-064): el vacío y el error, dentro de una tarjeta o a pantalla entera. -->
    <dimen name="estado_icono">48dp</dimen>
    <!-- Quita el aire de abajo de view_estado (24) cuando debajo empieza otra sección con su propio
         margen: si no, se suman (Entrenar, «Mis rutinas»). -->
    <dimen name="estado_sin_aire_abajo">-24dp</dimen>
    <!-- Margen lateral de pantalla, entre secciones (36 en las pestañas, 28 en las
         subpantallas) y del título de sección a su contenido. -->
    <dimen name="margen_pantalla">20dp</dimen>
    <!-- Para que un carrusel dentro de una columna con margen_pantalla llegue a los bordes
         (Logros de Progreso): margen negativo y el mismo relleno, con clipToPadding="false". -->
    <dimen name="margen_pantalla_fuera">-20dp</dimen>
    <!-- Aire de un bloque pulsable que no tiene relleno propio (la fila de una macro, la cabecera de
         «Tu programa»): el anillo de foco iba a 2 dp del texto y sus esquinas lo cruzaban (GP-227,
         sexta pasada). Relleno de 8 y el mismo margen negativo, para que el texto no se mueva. -->
    <dimen name="aire_anillo">8dp</dimen>
    <dimen name="aire_anillo_fuera">-8dp</dimen>
    <!-- Arriba y abajo, entre filas apiladas (las macros), basta la mitad. Los márgenes negativos van
         siempre lado a lado: android:layout_margin negativo se ignora. -->
    <dimen name="aire_anillo_alto">4dp</dimen>
    <dimen name="aire_anillo_alto_fuera">-4dp</dimen>
    <dimen name="separacion_pestana">36dp</dimen>
    <!-- Para un carrusel que lleva ese hueco como relleno propio (CarruselView): lo descuenta. -->
    <dimen name="separacion_pestana_fuera">-36dp</dimen>
    <!-- El fundido con el que un carrusel desvanece su último elemento a la vista. -->
    <dimen name="carrusel_fundido">28dp</dimen>
    <dimen name="separacion_subpantalla">28dp</dimen>
    <dimen name="titulo_a_contenido">14dp</dimen>
    <!-- Logros de Progreso (GP-216, lote 4, tablero 16): medallón de 72 con borde de 3 y su
         icono de 34, en una columna de 120. La línea del peso de «Tu cuerpo», 90 de alto. -->
    <dimen name="logro_carrusel_ancho">120dp</dimen>
    <dimen name="logro_medallon">72dp</dimen>
    <dimen name="logro_medallon_borde">3dp</dimen>
    <dimen name="logro_medallon_icono">34dp</dimen>
    <dimen name="linea_peso_alto">90dp</dimen>
    <!-- Ancho de una tarjeta de carrusel (Inicio, «Lo que te encaja» en Añadir). -->
    <dimen name="tarjeta_carrusel">220dp</dimen>

    <!-- Radios. Botones y píldoras: la mitad de su altura (cornerSize 50 %). -->
    <dimen name="radio_chip">12dp</dimen>
    <dimen name="radio_miniatura">16dp</dimen>
    <dimen name="radio_tarjeta_pequena">20dp</dimen>
    <dimen name="radio_tarjeta">24dp</dimen>
    <dimen name="radio_protagonista">28dp</dimen>

    <!-- Borde de la tarjeta estándar: 1 dp en claro, ninguno en oscuro (values-night). -->
    <dimen name="tarjeta_borde">1dp</dimen>

    <!-- Zona táctil mínima (DEC-019): 48 dp. -->
    <dimen name="zona_tactil">48dp</dimen>
    <!-- Hueco entre los tramos de la barra de reparto de una comida. -->
    <dimen name="reparto_hueco">2dp</dimen>

    <!-- Selector de opciones (GP-224): pista de 48 dp con 4 de relleno, píldora y opción de 40,
         anillo de foco de 2 dp; pulsado, capa del 10 %; desactivado, al 38 %. -->
    <dimen name="selector_relleno">4dp</dimen>
    <dimen name="selector_opcion_alto">40dp</dimen>
    <dimen name="selector_anillo_foco">2dp</dimen>
    <item name="selector_capa_pulsado" format="float" type="dimen">0.10</item>
    <item name="alfa_desactivado" format="float" type="dimen">0.38</item>

    <!-- Fila de lista: 64 dp mínimo, 16 a los lados, icono en círculo de 40 y separador
         con sangría hasta el texto (16 + 40 + 14 = 70). -->
    <dimen name="fila_alto_min">64dp</dimen>
    <dimen name="fila_padding_horizontal">16dp</dimen>
    <!-- La cabecera de las pantallas secundarias (MaterialToolbar, Widget.GymProFit.Cabecera). -->
    <dimen name="cabecera_alto">56dp</dimen>
    <!-- Buscador en píldora (Biblioteca y Añadir, GP-225): 56 dp y la mitad de radio. -->
    <dimen name="buscador_alto">56dp</dimen>
    <dimen name="buscador_radio">28dp</dimen>
    <dimen name="fila_icono_circulo">40dp</dimen>
    <dimen name="fila_icono">22dp</dimen>
    <dimen name="fila_icono_a_texto">14dp</dimen>
    <dimen name="fila_sangria_separador">70dp</dimen>
    <dimen name="separador_alto">1dp</dimen>

    <!-- Cabecera de sección: el enlace de la derecha mide 44 dp de alto. -->
    <dimen name="seccion_enlace_alto">48dp</dimen>

    <!-- Avatar de cabecera: 48 dp, borde de 2 dp en naranja. -->
    <dimen name="avatar_cabecera">48dp</dimen>
    <dimen name="avatar_cabecera_borde">2dp</dimen>

    <!-- Botones que cambian de forma al pulsar (Expressive): de 26 a 12 dp. -->
    <dimen name="boton_radio_reposo">26dp</dimen>
    <dimen name="boton_radio_pulsado">12dp</dimen>

    <!-- Hojas inferiores propias: atrás predictivo, esquinas de 28 dp. -->
    <dimen name="hoja_radio_atras">28dp</dimen>

    <!-- Roles de texto (los de DESIGN.md): título de pantalla 34, cifra 26 a 48, sección 20,
         cuerpo 16 y apoyo 13 a 14. Los escalones de arriba (text_*) apuntan a estos tamaños. -->
    <dimen name="text_enlace_seccion">15sp</dimen>
    <!-- Título junto a la cara de Profi («Lo que te encaja», tablero 25; GP-225). -->
    <dimen name="text_titulo_profi">17sp</dimen>
    <dimen name="profi_cara_pequena">32dp</dimen>
    <!-- La cola del bocadillo de Profi (BurbujaProfi): ancho y alto de su base. -->
    <dimen name="cola_burbuja">8dp</dimen>
    <dimen name="cola_burbuja_alto">14dp</dimen>
    <dimen name="text_cifra_pequena">26sp</dimen>
    <dimen name="text_cifra_grande">48sp</dimen>

    <!-- Sesión en vivo (GP-012): hueco libre al final de la lista para el descanso (GP-013). -->
    <dimen name="envivo_hueco_descanso">160dp</dimen>
    <!-- La cuenta atrás del descanso: grande, se lee de un vistazo (GP-013). -->
    <dimen name="envivo_descanso_numero">40sp</dimen>
    <!-- El panel del descanso flota (GP-285, lote 2): 12 a los lados y 22 sobre el hueco del sistema. -->
    <dimen name="envivo_descanso_lado">12dp</dimen>
    <dimen name="envivo_descanso_abajo">22dp</dimen>
    <!-- Botones del descanso: letra y relleno contenidos, para que «−15 s», «+15 s» y «Saltar»
         quepan en una fila también con letra 2,0 en un móvil de 360 dp. -->
    <dimen name="envivo_descanso_boton_texto">14sp</dimen>
    <dimen name="envivo_descanso_boton_relleno">12dp</dimen>
    <!-- Hueco que la lista deja arriba para la cabecera flotante mientras esta no se ha medido. -->
    <dimen name="envivo_hueco_cabecera">180dp</dimen>
    <!-- Radio de la fila de una serie resaltada (la que toca, la del récord) y del aviso del récord. -->
    <dimen name="radio_fila_serie">16dp</dimen>
    <!-- Ancho de la columna del número de serie. 48 y no 40: con letra 1,3 «SERIE» tocaba a «ANTERIOR». -->
    <dimen name="envivo_col_serie">48dp</dimen>
    <!-- Margen de la Sesión en vivo a los lados de la pantalla: 16, como en la maqueta (GP-285, lote 2). -->
    <dimen name="envivo_margen">16dp</dimen>
    <!-- GP-216: el anillo de la cámara del avatar de Perfil y el borde de una opción de la hoja de elegir. -->
    <dimen name="avatar_camara_anillo">3dp</dimen>
    <dimen name="opcion_borde">2dp</dimen>
    <!-- Interlineado del título de una fila (GP-216): 22 sp para 16 sp de texto. -->
    <dimen name="linea_titulo_fila">22sp</dimen>

    <!-- ── El arranque (GP-223) ─────────────────────────────────────────── -->
    <!-- El icono sin fondo del splash de Android 12: la G (160 dp) va dentro, en el círculo de 192. -->
    <dimen name="arranque_icono">288dp</dimen>
    <dimen name="arranque_g">160dp</dimen>
    <dimen name="arranque_g_error">72dp</dimen>
    <!-- «Conectando…» y el texto de los errores: no más anchos que esto, a cualquier letra. -->
    <dimen name="arranque_texto_max">300dp</dimen>
    <dimen name="arranque_boton_alto">52dp</dimen>
    <dimen name="arranque_boton_abajo">32dp</dimen>
    <!-- «Conectando…», Barlow a 15 sp; el título de un error, Barlow Condensed a 30 sp. -->
    <dimen name="text_arranque_estado">15sp</dimen>
    <dimen name="text_arranque_titulo">30sp</dimen>
    <!-- ── Las tarjetas de sesión y de rutina (GP-232) ──────────────────── -->
    <!-- Barras de «tus últimas veces»: ancho, hueco y alto. En tarjeta, 10, 6 y 36; en el carrusel
         de Inicio, 7, 4 y 28; en las filas (Progreso y «¿Qué rutina hoy?»), 5, 3 y 24. -->
    <dimen name="barras_tarjeta_ancho">10dp</dimen>
    <dimen name="barras_tarjeta_hueco">6dp</dimen>
    <dimen name="barras_tarjeta_alto">36dp</dimen>
    <dimen name="barras_carrusel_ancho">7dp</dimen>
    <dimen name="barras_carrusel_hueco">4dp</dimen>
    <dimen name="barras_carrusel_alto">28dp</dimen>
    <dimen name="barras_fila_ancho">5dp</dimen>
    <dimen name="barras_fila_hueco">3dp</dimen>
    <dimen name="barras_fila_alto">24dp</dimen>
    <!-- Una barra de 0 kg no desaparece: se queda en este filo. -->
    <dimen name="barras_minimo">4dp</dimen>
    <!-- Los kilos de la tarjeta, Barlow Condensed 700 a 26 sp; el «kg» de al lado, en Barlow a 15
         (14 en el carrusel de Inicio). -->
    <dimen name="text_tarjeta_kg">15sp</dimen>
    <dimen name="text_tarjeta_kg_carrusel">14sp</dimen>
    <!-- Programas: el nombre en Barlow Condensed 700 a 22 sp (26 en el recomendado, Cifra.Pequena) y
         las siglas de la tira del ciclo, en círculos de 36 dp con la condensada 600 a 14. -->
    <dimen name="text_programa_nombre">22sp</dimen>
    <dimen name="sigla_ciclo">36dp</dimen>
    <dimen name="text_sigla_ciclo">14sp</dimen>

    <!-- La hoja del tiempo por sesión (GP-243, tablero Tiempo-1): un bloque por ejercicio de 30 dp
         de alto, radio 8 y, si sale, borde discontinuo de 1,5 dp. -->
    <dimen name="bloque_rutina_alto">30dp</dimen>
    <dimen name="bloque_rutina_radio">8dp</dimen>
    <dimen name="bloque_rutina_borde">1.5dp</dimen>
    <!-- Las píldoras de zona de «Elige ejercicios» (GP-244, tablero Mezcla-2): 44 dp, y 48 de zona
         táctil con setEnsureMinTouchTargetSize. -->
    <dimen name="chip_zona_alto">44dp</dimen>
    <!-- GP-265 y GP-045: el rótulo en condensada de 15 sp y los titulares en 800. -->
    <dimen name="text_rotulo_destacado">15sp</dimen>
    <dimen name="text_titular_objetivo">36sp</dimen>
    <dimen name="text_titular_vacio">28sp</dimen>
    <dimen name="text_titular_correo">40sp</dimen>
    <dimen name="text_cifra_codigo">34sp</dimen>
    <!-- GP-045: alto de cada caja del código. -->
    <dimen name="codigo_caja_alto">64dp</dimen>
    <!-- GP-265: alto fijo de la cifra de «Tus datos»: el autoajuste necesita una caja con medida,
         y así las cuatro columnas quedan alineadas aunque la actividad encoja. -->
    <dimen name="dato_perfil_alto">36dp</dimen>

    <!-- ── Liquid Glass (GP-285, DEC-070) ─────────────────────────────────────
         Medidas de documentacion/diseno/2026-11-25-liquid-glass/README.md. -->
    <!-- Radios del cristal: tarjeta héroe 30, tarjetas 26 y tiles 22; chips y botones, píldora. -->
    <dimen name="radio_cristal_heroe">30dp</dimen>
    <dimen name="radio_cristal">26dp</dimen>
    <dimen name="radio_cristal_tile">22dp</dimen>
    <!-- Borde y brillo superior del cristal. -->
    <dimen name="cristal_borde">1dp</dimen>
    <!-- Solo en claro: el filo oscuro del canto y la sombra del cristal estático (28 dp de
         difuminado, como el «blur» de CSS, y 10 hacia abajo) y la de la lente de la barra. -->
    <dimen name="cristal_filo">0.5dp</dimen>
    <dimen name="cristal_estatico_sombra_difuminado">28dp</dimen>
    <dimen name="cristal_estatico_sombra_baja">10dp</dimen>
    <dimen name="lente_sombra_difuminado">6dp</dimen>
    <dimen name="lente_sombra_baja">2dp</dimen>
    <!-- Desenfoque del cristal vivo: la desviación (σ), como el blur(22px) de la maqueta. -->
    <dimen name="cristal_desenfoque">22dp</dimen>
    <!-- La lente del borde (nivel 1): el ancho de la banda que refracta y lo que desplaza como mucho. -->
    <dimen name="cristal_lente_banda">14dp</dimen>
    <dimen name="cristal_lente_fuerza">16dp</dimen>
    <!-- Sombra del cristal vivo: difuminado y cuánto cae. -->
    <dimen name="cristal_sombra_radio">26dp</dimen>
    <dimen name="cristal_sombra_baja">12dp</dimen>
    <!-- La barra flotante: cápsula de 64 a 16 de los lados y 26 del borde de abajo (más el hueco
         de gestos), el «+» de 64 a 10 de ella y la lente de la pestaña activa, de 52. -->
    <dimen name="barra_alto">64dp</dimen>
    <dimen name="barra_margen_lado">16dp</dimen>
    <dimen name="barra_margen_abajo">26dp</dimen>
    <dimen name="barra_hueco_mas">10dp</dimen>
    <dimen name="barra_relleno">6dp</dimen>
    <dimen name="barra_lente_alto">52dp</dimen>
    <dimen name="barra_lente_radio">26dp</dimen>
    <!-- El «+»: círculo de 64 (radio 32). De cristal (niveles 1 y 2), con el borde de 1,5 dp y
         el reflejo en media luna a 3 del canto, solo en su cuarto de arriba: el icono, a 19 del
         borde, queda fuera de ella. Opaco (nivel 3), con el degradado radial de 45 dp de radio. -->
    <dimen name="barra_mas_icono_margen">19dp</dimen>
    <!-- Botón de marca (Cristal.MARCA): media luna metida 3 dp, borde de 1,5 dp y su sombra. -->
    <dimen name="marca_reflejo_dentro">3dp</dimen>
    <dimen name="marca_borde">1.5dp</dimen>
    <dimen name="marca_sombra_difuminado">10dp</dimen>
    <dimen name="marca_sombra_baja">3dp</dimen>
    <!-- La barra de la sesión va 8 por encima. -->
    <dimen name="barra_sesion_hueco">8dp</dimen>
    <!-- Margen mínimo entre el último botón de una tarjeta y la barra flotante: lo último de
         cada pestaña acaba a esto del pie (MainActivity.aplicarHuecoInferior) y, en reposo, el
         botón de «Hoy toca» también (EncajeHeroe). -->
    <dimen name="barra_margen_boton">16dp</dimen>
    <!-- Bordes del sistema (BordesSistema): el tramo, bajo la barra de estado, en que el
         contenido se desvanece hacia el fondo base. El de abajo sale de las medidas de la barra. -->
    <dimen name="borde_sistema_desvanecido">24dp</dimen>
    <!-- Tile de «Tu día»: relleno y barra de progreso. -->
    <dimen name="tile_relleno">12dp</dimen>
    <dimen name="tile_barra">6dp</dimen>
    <dimen name="tile_alto_min">112dp</dimen>
    <!-- Chip de cristal: 4 arriba y abajo. -->
    <dimen name="chip_cristal_relleno">4dp</dimen>
    <!-- El bloque del icono de cada ejercicio de «Hoy toca» (eran 84: con letra 1,3 la tarjeta
         héroe dejaba «Empezar» bajo la barra flotante), y lo más que cede si aun así el botón
         queda a menos de barra_margen_boton de la barra (EncajeHeroe): hasta 48, con el icono de 40. -->
    <dimen name="hoy_ejercicio_icono_alto">72dp</dimen>
    <dimen name="hoy_ejercicio_icono_cede">24dp</dimen>
</resources>
