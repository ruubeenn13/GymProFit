<?xml version="1.0" encoding="utf-8"?>
<!--
  idioma.xml — en qué idioma están los recursos con que se pinta la app. values-en lo
  sobrescribe. Sin idioma elegido, el diálogo de idioma marca este (GP-233), y fechas y
  números se formatean en él (FechaUtils.localeDeLaApp, GP-240). Sin idioma elegido la app
  sigue la lista del sistema entre los suyos (IdiomaApp): con [francés] o [catalán, español]
  sale en español; con [francés, inglés] o [alemán, inglés], en inglés. La primera
  configuración diría «fr» o «ca», que no es el idioma en que se pinta.
-->
<resources>
    <bool name="recursos_en_ingles">false</bool>
</resources>
