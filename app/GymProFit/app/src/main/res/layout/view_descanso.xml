<?xml version="1.0" encoding="utf-8"?>
<!--
  view_descanso — el descanso entre series (GP-013), abajo en la sesión en vivo, en el
  hueco que dejó la 1.3.0. Nunca bloquea: la lista sigue debajo, se escribe y se marca.
  · panelDescanso: «Descanso», qué viene después, la cuenta atrás, la barra, «−15 s»,
    «+15 s» y «Saltar». TalkBack lo lee como un temporizador al llegar a él o tocarlo
    (la descripción se calcula en ese momento; no se anuncia cada segundo).
  · avisoFinDescanso: «¡A por la serie 3!» con el ejercicio y su cerrar; se va solo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/zonaDescanso"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom">

    <LinearLayout
        android:id="@+id/panelDescanso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-1dp"
        android:layout_marginEnd="-1dp"
        android:layout_marginBottom="-1dp"
        android:background="@drawable/bg_panel_descanso"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="17dp"
        android:paddingTop="14dp"
        android:paddingEnd="17dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/grupoCuentaAtras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDescansoRotulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/envivo_descanso"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.GymProFit.Label"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_eyebrow" />

                <TextView
                    android:id="@+id/tvDescansoDespues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDescansoTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.GymProFit.Number"
                android:textSize="@dimen/envivo_descanso_numero" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraDescanso"
            style="@style/Widget.GymProFit.BarraProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDescansoMenos"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:contentDescription="@string/envivo_descanso_menos_a11y"
                android:minHeight="48dp"
                android:text="@string/envivo_descanso_menos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDescansoMas"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/envivo_descanso_mas_a11y"
                android:minHeight="48dp"
                android:text="@string/envivo_descanso_mas" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDescansoSaltar"
                style="@style/Widget.GymProFit.BotonPildora"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorPrimaryContainer"
                android:contentDescription="@string/envivo_descanso_saltar_a11y"
                android:minHeight="48dp"
                android:text="@string/envivo_descanso_saltar"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/avisoFinDescanso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="4dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_notifications_active_fill"
                app:tint="?attr/colorOnPrimary" />

            <LinearLayout
                android:id="@+id/grupoFinDescanso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFinTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                    android:textColor="?attr/colorOnPrimary" />

                <TextView
                    android:id="@+id/tvFinTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCerrarFin"
                style="@style/Widget.GymProFit.BotonIcono"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/envivo_fin_cerrar"
                android:src="@drawable/ic_ms_close"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
