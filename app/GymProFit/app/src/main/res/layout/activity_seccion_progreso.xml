<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_seccion_progreso — una lista completa de Progreso en su propia pantalla (GP-216,
  lote 4): Récords, Logros, Medidas o Historial, con su cabecera y «Volver». La lista es el
  fragment de siempre, que se aloja aquí sin cambiar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/btn_volver" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorSeccion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
