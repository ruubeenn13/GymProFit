<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_eliminar_cuenta — borrado definitivo de la cuenta (GP-008).

  Es una PANTALLA y no un diálogo a propósito: un diálogo se cierra tocando fuera,
  y eso es lo contrario de la deliberación que pide algo irreversible. Aquí hay que
  desplazarse, leer qué se lleva por delante, teclear la contraseña y marcar la
  casilla antes de que el botón se encienda.

  El texto es el mismo que el de gymprofit.app/eliminar-cuenta. La política de
  privacidad NO está dentro del APK: el enlace la abre en el navegador.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/eliminar_cuenta_titulo"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- CABECERA: el aviso de que no hay vuelta atrás, antes que nada más -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="20dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_delete"
                    android:layout_marginTop="2dp"
                    app:tint="?attr/colorError"
                    android:contentDescription="@string/eliminar_cuenta_icono_descripcion" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:text="@string/eliminar_cuenta_intro"
                    android:textSize="@dimen/text_body"
                    android:textColor="?attr/colorError"
                    android:lineSpacingMultiplier="1.35" />

            </LinearLayout>

            <!-- CARD: qué se borra -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta_que_se_borra"
                        android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_1" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_2" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_3" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_4" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_5" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_6" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista"
                        android:layout_marginBottom="0dp">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_borra_7" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: qué NO se borra -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta_que_no_se_borra"
                        android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_no_borra_1" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_no_borra_2" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista"
                        android:layout_marginBottom="0dp">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_no_borra_3" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: antes de hacerlo (la salida de emergencia: cerrar sesión) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta_antes"
                        android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="14dp"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout style="@style/GymProFit.ItemLista">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_antes_1" />
                    </LinearLayout>

                    <LinearLayout style="@style/GymProFit.ItemLista"
                        android:layout_marginBottom="0dp">
                        <View style="@style/GymProFit.PuntoLista" />
                        <TextView style="@style/GymProFit.TextoLista"
                            android:text="@string/eliminar_cuenta_antes_2" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="10dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- Enlace al apartado de conservación de la política publicada -->
                    <LinearLayout
                        android:id="@+id/llEliminarConservacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:paddingEnd="4dp"
                        android:paddingStart="0dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_web"
                            android:alpha="0.55"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/eliminar_cuenta_conservacion_enlace"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorPrimary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- CARD: reautenticación y confirmación explícita -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta_confirmar_titulo"
                        android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/eliminar_cuenta_password_explicacion"
                        android:textSize="@dimen/text_caption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingMultiplier="1.35" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEliminarPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/eliminar_cuenta_password"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEliminarPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbEliminarConfirmacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minHeight="48dp"
                        android:text="@string/eliminar_cuenta_confirmacion"
                        android:textSize="@dimen/text_caption"
                        android:textColor="?attr/colorOnSurface"
                        android:lineSpacingMultiplier="1.3" />

                    <!-- Botón destructivo en contorno y no relleno: sobre gp_error
                         relleno, el texto blanco no llega al contraste mínimo en
                         modo oscuro (#F87171). En contorno, el propio texto va en
                         gp_error sobre el fondo y se lee bien en claro y oscuro. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEliminarCuenta"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="@string/eliminar_cuenta_btn"
                        android:textColor="?attr/colorError"
                        android:textSize="@dimen/text_body"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="start"
                        app:iconTint="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
