<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_eliminar_cuenta — borrado definitivo de la cuenta (GP-008; rehecha en GP-216, tablero 21).
  Cuatro líneas de lo que se pierde en vez de once viñetas, el detalle plegado, la contraseña y una
  casilla que habilita el botón. Es una pantalla y no un diálogo a propósito: un diálogo se cierra
  tocando fuera, y algo irreversible pide deliberar. El texto no promete otra cosa que la página
  gymprofit.app/eliminar-cuenta (EliminarCuentaWebTest).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/eliminar_cuenta_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_16"
            android:paddingBottom="@dimen/espacio_36">

            <!-- Qué pasa -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:accessibilityHeading="true"
                android:text="@string/eliminar_cuenta_titular"
                android:textAppearance="@style/TextAppearance.GymProFit.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_8"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:text="@string/eliminar_cuenta_intro_corta"
                android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo" />

            <!-- Lo que pierdes: cuatro líneas y el detalle plegado -->
            <LinearLayout
                android:id="@+id/grupoPierdes"
                style="@style/Widget.GymProFit.GrupoAjustes.Pantalla"
                android:layout_marginTop="@dimen/espacio_24">

                <include android:id="@+id/pierdeCuenta" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/pierdeEntrenos" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/pierdeDiario" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/pierdeProgreso" layout="@layout/view_fila_ajuste" />

                <LinearLayout
                    android:id="@+id/btnVerDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/espacio_20"
                    android:paddingEnd="@dimen/espacio_16">

                    <TextView
                        android:id="@+id/tvVerDetalle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:text="@string/eliminar_cuenta_ver_detalle"
                        android:textAppearance="@style/TextAppearance.GymProFit.Enlace" />

                    <ImageView
                        android:id="@+id/ivVerDetalle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ms_keyboard_arrow_down"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detallePierdes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espacio_20"
                    android:paddingEnd="@dimen/espacio_20"
                    android:paddingBottom="@dimen/espacio_16"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta_borra_5"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:text="@string/eliminar_cuenta_borra_7"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:text="@string/eliminar_cuenta_no_borra_1"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:text="@string/eliminar_cuenta_antes_2"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                    <TextView
                        android:id="@+id/llEliminarConservacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:text="@string/eliminar_cuenta_conservacion_enlace"
                        android:textAppearance="@style/TextAppearance.GymProFit.Enlace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Confirmar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEliminarPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_24"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:hint="@string/eliminar_cuenta_password"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:endIconDrawable="@drawable/sel_ojo_password"
                app:endIconMode="password_toggle"
                app:errorIconDrawable="@drawable/ic_ms_error">

                <es.pmdm.gymprofit.ui.widget.CampoContrasena
                    android:id="@+id/etEliminarPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbEliminarConfirmacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_16"
                android:layout_marginTop="@dimen/espacio_8"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:lineSpacingMultiplier="1.1"
                android:minHeight="52dp"
                android:text="@string/eliminar_cuenta_confirmacion_corta"
                android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo" />

            <!-- Botón destructivo relleno con su rojo fijo y texto blanco (5,62:1) en los dos temas;
                 apagado hasta marcar la casilla. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarCuenta"
                style="@style/Widget.GymProFit.BotonPildora"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_16"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:minHeight="56dp"
                android:text="@string/eliminar_cuenta_btn_corto"
                android:textColor="@color/boton_eliminar_texto"
                app:backgroundTint="@color/boton_eliminar_fondo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMejorNo"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_8"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:minHeight="52dp"
                android:text="@string/eliminar_cuenta_mejor_no"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
