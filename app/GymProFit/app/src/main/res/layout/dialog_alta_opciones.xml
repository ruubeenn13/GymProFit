<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_alta_opciones — una hoja de «Sobre ti» con opciones (GP-103): actividad y sexo.
  Como la hoja «¿Cuánto te mueves?» del lienzo: tirador, título, para qué, las opciones
  en su variante de hoja y «Listo».
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvTituloHoja"
            style="@style/Widget.GymProFit.Alta.TituloHoja" />

        <TextView
            android:id="@+id/tvTextoHoja"
            style="@style/Widget.GymProFit.Alta.Texto"
            android:layout_marginTop="8dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grupoHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListoHoja"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:layout_marginTop="16dp"
            android:text="@string/alta_listo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
