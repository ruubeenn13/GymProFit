<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_notificaciones — Perfil › Notificaciones (GP-112, lote 1.5.1; rehecha en GP-216, tablero 19):
  los mismos avisos que el alta, con los interruptores de la cuenta, y el permiso del sistema. Si
  falta el permiso, Profi lo pide arriba con «Activar avisos» y los interruptores se ven apagados.
  Cada cambio se guarda en el momento con el PATCH. Las filas son las de Perfil y ajustes.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ajustes_notificaciones" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_16"
            android:paddingBottom="@dimen/espacio_28">

            <!-- Sin permiso del sistema, nada llega: Profi lo dice y ofrece activarlo. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPermisoAvisos"
                style="@style/Widget.GymProFit.Card.Protagonista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:layout_marginBottom="@dimen/separacion_subpantalla"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/espacio_16">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@color/gp_on_primary_sobre_hero"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profi_cara"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.GymProFit.Circulo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/espacio_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPermisoAvisos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.1"
                            android:text="@string/notificaciones_profi"
                            android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPermisoAvisos"
                            style="@style/Widget.GymProFit.BotonPildora"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/espacio_12"
                            android:text="@string/notificaciones_activar_avisos" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:text="@string/notificaciones_que_avisamos" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaAvisoDescanso" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAvisoEntrenar" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAvisoComidas" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAvisoProgreso" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes.Pantalla"
                android:layout_marginTop="@dimen/espacio_16">

                <include android:id="@+id/filaAjustesSistema" layout="@layout/view_fila_ajuste" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
