<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_historial — el Historial completo de Progreso (GP-232, tablero «Historial»): las
  sesiones por semanas, cada semana con su cabecera, en tarjetas que se borran deslizando a la
  izquierda. Carga, error y vacío van en view_estado dentro de la sección, sin toast (la parte
  del Historial de GP-064).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizHistorial"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSesiones"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_4"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_24" />

    <include
        android:id="@+id/estadoHistorial"
        layout="@layout/view_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla" />
</FrameLayout>
