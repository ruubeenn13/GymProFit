<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_licencia — texto completo de una licencia de terceros (GP-082).
  Copyright en una frase arriba, en el idioma de la app, y debajo el texto legal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_ms_arrow_back"
        app:navigationContentDescription="@string/btn_volver"
        app:titleTextColor="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvAvisoLicencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurface" />

            <!-- El texto legal viene cortado a 80 columnas: en horizontal se
                 desplaza en vez de reflotar, que lo rompía en líneas sueltas. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvTextoLicencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:typeface="monospace"
                android:textSize="@dimen/text_label"
                android:textColor="?attr/colorOnSurfaceVariant" />

            </HorizontalScrollView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
