<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_bottom_menu — Contenedor genérico para un BottomSheet de menú de opciones.
  Incluye título opcional con separador y un contenedor donde se insertan
  dinámicamente los ítems del menú.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Título del menú (oculto si no se establece): el nombre de lo que se toca, tal cual se
         escribe (en mayúsculas, a 1,3 se cortaba un nombre corto) y hasta en dos líneas. -->
    <TextView
        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
        android:id="@+id/tvMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:textStyle="bold"
        android:textColor="@color/gp_text_secondary"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

    <!-- Separador bajo el título -->
    <View
        android:id="@+id/dividerMenuTitle"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/colorOutlineVariant"
        android:visibility="gone" />

    <!-- Contenedor donde se añaden los ítems del menú programáticamente -->
    <LinearLayout
        android:id="@+id/llMenuItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
