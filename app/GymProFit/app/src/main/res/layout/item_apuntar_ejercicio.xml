<?xml version="1.0" encoding="utf-8"?>
<!--
  item_apuntar_ejercicio — un ejercicio abierto en «Apuntar entreno» (GP-241, tablero Entreno-B):
  su nombre, su pauta en frase («3 series de 6 a 10 repeticiones»), los rótulos de las columnas y
  una fila de la sesión en vivo (item_envivo_serie) por serie. Si no se ha empezado, la cabecera se
  pulsa para plegarlo.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GymProFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espacio_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/espacio_8">

        <LinearLayout
            android:id="@+id/cabeceraEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="@dimen/fila_alto_min"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espacio_16"
            android:paddingTop="@dimen/espacio_12"
            android:paddingEnd="@dimen/espacio_12"
            android:paddingBottom="@dimen/espacio_4">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNombreEjercicio"
                    style="@style/Widget.GymProFit.Fila.Titulo"
                    android:layout_width="match_parent"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPautaEjercicio"
                    style="@style/Widget.GymProFit.Fila.Apoyo"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/espacio_4"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPliegue"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/espacio_8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_keyboard_arrow_up"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Rótulos de las columnas. Solo para la vista: cada fila se lee entera. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espacio_12"
            android:paddingEnd="@dimen/espacio_8">

            <TextView
                android:layout_width="@dimen/envivo_col_serie"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/envivo_col_serie"
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_eyebrow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:paddingStart="@dimen/espacio_8"
                android:paddingEnd="@dimen/espacio_4"
                android:text="@string/envivo_col_anterior"
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_eyebrow" />

            <TextView
                android:id="@+id/tvRotuloKg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/envivo_col_kg"
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_eyebrow" />

            <TextView
                android:id="@+id/tvRotuloReps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/envivo_col_reps"
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_eyebrow" />

            <Space
                android:layout_width="@dimen/zona_tactil"
                android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contenedorSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
