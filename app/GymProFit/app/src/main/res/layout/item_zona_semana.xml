<?xml version="1.0" encoding="utf-8"?>
<!--
  item_zona_semana — una zona de «Tus músculos esta semana» (GP-216, tablero 13): su nombre,
  las series de la semana y una barra relativa a la zona más trabajada. Un grupo para TalkBack
  (nombre y series, de una vez); la barra no lleva nombre porque la cifra ya lo dice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvZonaNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvZonaSeries"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_8"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraZona"
        style="@style/Widget.GymProFit.BarraProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_4"
        android:importantForAccessibility="no"
        app:trackColor="@color/gp_meter_track"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
