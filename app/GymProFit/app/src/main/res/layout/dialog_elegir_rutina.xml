<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_elegir_rutina — la hoja de elegir rutina (GP-105; GP-241): «¿Qué rutina hoy?» de Hoy toca
  y «¿Qué entrenaste?» de Apuntar entreno, que cambia el título y lleva «Cerrar». Las filas, los
  títulos de sección y «Entreno libre» los añade ElegirRutinaHoja.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_asa_hoja"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/espacio_8">

        <TextView
            android:id="@+id/tvTituloHojaRutina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:accessibilityHeading="true"
            android:text="@string/cambiar_rutina_titulo"
            android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

        <ImageButton
            android:id="@+id/btnCerrarHojaRutina"
            style="@style/Widget.GymProFit.BotonIcono"
            android:contentDescription="@string/anadir_cerrar"
            android:src="@drawable/ic_ms_close"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/listaRutinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
