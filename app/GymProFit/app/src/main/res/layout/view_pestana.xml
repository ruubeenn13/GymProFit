<?xml version="1.0" encoding="utf-8"?>
<!--
  view_pestana — una pestaña de la barra (GP-105; Liquid Glass en GP-285): el icono y, debajo, la
  etiqueta, siempre visible, dentro de su «lente» de 52 dp. La activa lleva la lente (bg_lente),
  el icono relleno y la etiqueta en negrita, los dos en el acento; las demás, el icono en
  contorno. Lo pinta BarraNavegacion.
  La pestaña entera es la zona pulsable: su columna de la cápsula por sus 64 dp de alto.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/fondo_pestana">

    <!-- Dos vistas a propósito: la de fuera es la zona pulsable (toda la columna, 64 dp) y esta, la
         lente de 52 dp; y el icono es una vista aparte porque cambia de dibujo y de tinte. -->
    <LinearLayout
        android:id="@+id/flPildora"
        tools:ignore="UselessParent,UseCompoundDrawables"
        android:layout_width="match_parent"
        android:layout_height="@dimen/barra_lente_alto"
        android:layout_gravity="center_vertical"
        android:duplicateParentState="true"
        android:foreground="@drawable/anillo_pildora"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivIcono"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="@dimen/text_eyebrow"
            android:importantForAccessibility="no" />
    </LinearLayout>
</FrameLayout>
