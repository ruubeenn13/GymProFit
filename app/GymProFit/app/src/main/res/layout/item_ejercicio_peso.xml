<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ejercicio_peso — un ejercicio de la sesión, con TODAS sus series.

  Antes esta fila tenía un único campo de peso para el ejercicio entero, así que
  solo se podía guardar un número: un 4×8 subiendo carga (60, 65, 70, 70) no
  cabía. Ahora la cabecera lleva el nombre y lo que pedía la rutina, y debajo va
  una fila por serie (item_serie) que rellena el adapter.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp">

    <!-- Cabecera: nombre del ejercicio y, debajo, lo que pedía la rutina con su pauta
         (lote 1.2.1). Una debajo de otra: a letra grande el nombre parte línea y la
         pauta no se corta. -->
    <TextView
        android:id="@+id/tvNombreEjercicioPeso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvSeriesRepsPeso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:drawablePadding="4dp"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:drawableTint="?attr/colorOnSurfaceVariant" />

    <!-- Por lado: qué se apunta en cada serie («Reps por pierna») -->
    <TextView
        android:id="@+id/tvColumnaSeries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

    <!-- Una fila por serie; las mete el adapter -->
    <LinearLayout
        android:id="@+id/contenedorSeries"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp" />

</LinearLayout>
