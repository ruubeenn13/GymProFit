<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_login.xml — Pantalla de inicio de sesión.
  Logo, campos de usuario/contraseña, botón de entrar, acceso como invitado
  y enlace de registro, con botones de cambio de tema e idioma.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Botón de cambio de tema claro/oscuro -->
        <ImageButton
            android:id="@+id/btnCambiarTema"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_ms_dark_mode"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cambiar_tema" />

        <!-- Botón de cambio de idioma -->
        <ImageButton
            android:id="@+id/btnCambiarIdioma"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@id/btnCambiarTema"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_ms_language"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cambiar_idioma" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logo"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/login_titulo"
                android:textSize="@dimen/text_display"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_subtitulo"
                android:textSize="@dimen/text_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Campo de usuario -->
            <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:hint="@string/login_usuario"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo de contraseña con toggle de visibilidad -->
            <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/login_password"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:endIconMode="password_toggle"
                app:endIconDrawable="@drawable/sel_ojo_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Salida para quien no recuerda la contraseña. Va pegada al campo,
                 que es donde uno se da cuenta de que no la sabe. -->
            <TextView
                android:id="@+id/tvOlvidastePassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:text="@string/login_olvidaste"
                android:textSize="@dimen/text_label"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <!-- Botón de inicio de sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/login_entrar"
                android:textSize="@dimen/text_subtitle"
                app:cornerRadius="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline"
                    android:alpha="0.4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/login_o"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="?attr/colorOutline"
                    android:alpha="0.4" />
            </LinearLayout>

            <!-- Botón de acceso como invitado (rol GUEST) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntrarInvitado"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/login_entrar_invitado"
                android:textSize="@dimen/text_body"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_ms_person"
                app:iconGravity="textStart" />

            <!-- Enlace de navegación hacia el registro -->
            <TextView
                android:id="@+id/tvNoTienesCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/login_no_cuenta"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

    </RelativeLayout>

</ScrollView>