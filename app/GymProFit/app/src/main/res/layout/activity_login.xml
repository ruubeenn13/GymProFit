<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_login — «Ya tengo cuenta» (GP-103, tablero 11 del lienzo del alta).
  Correo o usuario (DEC-036) y contraseña con ojo, «¿Has olvidado tu contraseña?», Entrar
  y «¿No tienes cuenta? Empieza aquí». Sin «Entrar como invitado» desde la 1.5.1 (el
  código del invitado sigue; retirarlo es GP-150) ni «Continuar con Google», que es la
  fase 2 (GP-086). Tema e idioma ya no están aquí: el idioma está en la bienvenida.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:background="?android:attr/colorBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvTituloEntrar"
                style="@style/Widget.GymProFit.Alta.Titulo"
                android:layout_marginTop="0dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/entrar_titulo"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/tvTextoEntrar"
                style="@style/Widget.GymProFit.Alta.Texto"
                android:layout_marginTop="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/entrar_texto" />

            <LinearLayout
                android:id="@+id/bloqueUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:labelFor="@+id/etUsuario"
                    android:text="@string/entrar_usuario"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:errorIconDrawable="@drawable/ic_ms_error"
                    app:placeholderText="@string/entrar_usuario_ejemplo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="username"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:imeOptions="actionNext" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bloqueClave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:labelFor="@+id/etPassword"
                    android:text="@string/guarda_contrasena"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:errorIconDrawable="@drawable/ic_ms_error"
                    app:endIconMode="password_toggle"
                    app:endIconDrawable="@drawable/sel_ojo_password">

                    <es.pmdm.gymprofit.ui.widget.CampoContrasena
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:imeOptions="actionDone" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvOlvidastePassword"
                style="@style/Widget.GymProFit.Alta.BotonTexto"
                android:layout_width="wrap_content"
                android:layout_marginTop="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/login_olvidaste"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEntrar"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:text="@string/entrar_titulo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/entrar_sin_cuenta"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvNoTienesCuenta"
                style="@style/Widget.GymProFit.Alta.BotonTexto"
                android:layout_width="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/entrar_empieza_aqui"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
