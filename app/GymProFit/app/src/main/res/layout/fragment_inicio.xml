<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_inicio — pestaña Inicio, según el tablero 13 de GP-216 (22-10-2026).
  De arriba abajo: cabecera con la fecha, el saludo y el avatar (abre Perfil y ajustes) · el
  bocadillo de Profi con un dato real · «Hoy toca» (tarjeta héroe, con las zonas del día
  en el cuerpo y los ejercicios en carrusel) · «Tu día» (calorías, proteína y agua en tres
  tiles, y la comida que toca) · «Tus músculos esta semana» · «Tu progreso» (kilos por semana y el último récord) ·
  «Tus últimos entrenos». «Primeros pasos» y el fundador siguen, solo el primer día.
  Cada sección con datos de red lleva su bloque de estado (cargando, error con reintentar, vacío).

  Desde GP-285 va en Liquid Glass (DEC-070; documentacion/diseno/2026-11-25-liquid-glass): no
  tiene fondo propio, detrás se ve el fondo ambiental de MainActivity, y las tarjetas son
  cristal estático (Widget.GymProFit.Card.Cristal*, con bg_cristal* en su primer hijo). El tema
  de la raíz (ThemeOverlay.GymProFit.Cristal) da a todo lo de dentro el texto y los colores
  medidos sobre el cristal. Las secciones, los textos y la lógica son los de GP-216.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollInicio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.GymProFit.Cristal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout style="@style/Widget.GymProFit.CabeceraPestana">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvHola"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display" />
            </LinearLayout>

            <include
                android:id="@+id/avatarInicio"
                layout="@layout/view_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_8"
            android:paddingBottom="@dimen/espacio_24">

            <!-- Profi: una frase con un dato tuyo. Sin dato que decir, no se ve. -->
            <LinearLayout
                android:id="@+id/filaProfi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_16"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@color/gp_hero"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profi_cara"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.GymProFit.Circulo" />

                <TextView
                    android:id="@+id/tvProfi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/espacio_4"
                    android:background="@drawable/bg_burbuja_profi"
                    android:lineSpacingMultiplier="1.1"
                    android:paddingStart="@dimen/espacio_24"
                    android:paddingEnd="@dimen/espacio_16"
                    android:paddingTop="@dimen/espacio_12"
                    android:paddingBottom="@dimen/espacio_12"
                    android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Hoy toca -->
            <es.pmdm.gymprofit.ui.cristal.TarjetaCristal
                android:id="@+id/cardHoyToca"
                style="@style/Widget.GymProFit.Card.Cristal.Heroe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cristal_heroe"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/espacio_20"
                    android:paddingBottom="@dimen/espacio_20">

                    <!-- El título con las siluetas al lado. El subtítulo va junto a ellas mientras
                         quepa en dos líneas; si no, lo enseña tvHoySubAncho, debajo y a todo el
                         ancho (CabeceraHoyToca lo decide en cada medida). -->
                    <es.pmdm.gymprofit.ui.inicio.CabeceraHoyToca
                        android:id="@+id/cabeceraHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/espacio_20"
                        android:paddingEnd="@dimen/espacio_20">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/ivHoyIcono"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ms_event_available"
                                    app:tint="@color/gp_cristal_acento" />

                                <!-- Una línea siempre: junto a las siluetas, a letra 1,3, «HOY TOCA · DÍA
                                     1 DE 4» dejaba el «4» solo en la segunda. Si no cabe, encoge, como
                                     mucho hasta su tamaño a letra 1,0 (el mínimo de la app). Lo activa
                                     InicioFragment con TextoQueEncoge: en el layout rompería la pantalla
                                     a letra 1,0, donde no hay de dónde encoger. -->
                                <TextView
                                    android:id="@+id/tvHoyEyebrow"
                                    style="@style/Widget.GymProFit.Seccion.Cristal"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="@dimen/espacio_8"
                                    android:maxLines="1"
                                    android:text="@string/hoy_toca" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvHoyTitulo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_8"
                                android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                            <TextView
                                android:id="@+id/tvHoySub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_4"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- Las zonas de hoy en el cuerpo: dibujada a mano, con su descripción. -->
                        <es.pmdm.gymprofit.ui.widget.SiluetaMuscularView
                            android:id="@+id/siluetaHoy"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_12"
                            android:visibility="gone" />
                    </LinearLayout>

                        <TextView
                            android:id="@+id/tvHoySubAncho"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_20"
                            android:layout_marginEnd="@dimen/espacio_20"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </es.pmdm.gymprofit.ui.inicio.CabeceraHoyToca>

                    <!-- «La última vez, hace 3 días», en un chip: en la maqueta iba suelto arriba a
                         la derecha, sobre el brillo, y no se leía (README, regla 1). Debajo de la fila
                         del título y las siluetas, a todo el ancho de la tarjeta y en una línea:
                         junto a las siluetas, con letra grande, se partía en dos. -->
                    <TextView
                        android:id="@+id/tvHoyUltima"
                        style="@style/Widget.GymProFit.ChipCristal"
                        android:layout_marginStart="@dimen/espacio_20"
                        android:layout_marginEnd="@dimen/espacio_20"
                        android:layout_marginTop="@dimen/espacio_4"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:visibility="gone" />

                    <!-- Llega a los dos bordes de la tarjeta (el relleno alinea el primer ejercicio
                         con el resto), funde el último a la vista y encaja por ejercicio. -->
                    <es.pmdm.gymprofit.ui.widget.CarruselView
                        android:id="@+id/scrollHoyEjercicios"
                        android:focusable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:clipToPadding="false"
                        android:paddingStart="@dimen/espacio_20"
                        android:paddingEnd="@dimen/espacio_20"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/listaHoyEjercicios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:divider="@drawable/sep_carrusel"
                            android:orientation="horizontal"
                            android:showDividers="middle" />
                    </es.pmdm.gymprofit.ui.widget.CarruselView>

                    <LinearLayout
                        android:id="@+id/filaBotonesHoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/espacio_20"
                        android:paddingEnd="@dimen/espacio_20">

                        <es.pmdm.gymprofit.ui.widget.BotonExpresivo
                            android:id="@+id/btnHoyPrincipal"
                            style="@style/Widget.GymProFit.BotonPildora.Expresivo.Cristal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/btn_empezar"
                            app:icon="@drawable/ic_ms_play_arrow_fill" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHoySecundario"
                            style="@style/Widget.GymProFit.BotonPildora.Cristal"
                            android:layout_width="wrap_content"
                            android:layout_marginStart="@dimen/espacio_8"
                            android:text="@string/btn_cambiar" />
                    </LinearLayout>
                </LinearLayout>
            </es.pmdm.gymprofit.ui.cristal.TarjetaCristal>

            <!-- Primeros pasos (GP-103): solo el primer día; se marcan solos, se pueden
                 ocultar y desaparecen al completarse. -->
            <es.pmdm.gymprofit.ui.cristal.TarjetaCristal
                android:id="@+id/cardPrimerosPasos"
                style="@style/Widget.GymProFit.Card.Cristal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_12"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cristal"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espacio_16"
                    android:paddingEnd="@dimen/espacio_8"
                    android:paddingTop="6dp"
                    android:paddingBottom="@dimen/espacio_8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvPrimerosPasos"
                            style="@style/Widget.GymProFit.Seccion"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <ImageButton
                            android:id="@+id/btnOcultarPasos"
                            style="@style/Widget.GymProFit.BotonIcono"
                            android:src="@drawable/ic_ms_close"
                            android:contentDescription="@string/inicio_pasos_ocultar_a11y"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <es.pmdm.gymprofit.ui.cristal.BarraProgresoCristal
                        android:id="@+id/barraPasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/espacio_8" />

                    <include android:id="@+id/pasoPlan" layout="@layout/item_primer_paso" />
                    <include android:id="@+id/pasoEntreno" layout="@layout/item_primer_paso" />
                    <include android:id="@+id/pasoComida" layout="@layout/item_primer_paso" />
                </LinearLayout>
            </es.pmdm.gymprofit.ui.cristal.TarjetaCristal>

            <!-- Tu día -->
            <LinearLayout
                android:id="@+id/seccionTuDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pestana"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.GymProFit.CabeceraSeccion">

                    <TextView
                        style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                        android:text="@string/inicio_tu_dia" />

                    <TextView
                        android:id="@+id/enlaceTuDia"
                        style="@style/Widget.GymProFit.CabeceraSeccion.Enlace.Cristal"
                        android:text="@string/inicio_ver_dia" />
                </LinearLayout>

                <include
                    android:id="@+id/estadoDia"
                    layout="@layout/view_estado" />

                <!-- Tres tiles iguales a lo ancho (GP-285): ya no es un carrusel. -->
                <LinearLayout
                    android:id="@+id/filaTuDia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/titulo_a_contenido"
                    android:baselineAligned="false"
                    android:divider="@drawable/sep_tiles"
                    android:orientation="horizontal"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/cardDiaKcal"
                        layout="@layout/item_tu_dia"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardDiaProteina"
                        layout="@layout/item_tu_dia"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/cardDiaAgua"
                        layout="@layout/item_tu_dia"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- La comida que toca ahora: apuntarla es un toque. -->
                <es.pmdm.gymprofit.ui.cristal.TarjetaCristal
                    android:id="@+id/cardComidaQueToca"
                    style="@style/Widget.GymProFit.Card.Cristal.Tile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cristal_tile"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/fila_alto_min"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/espacio_16"
                        android:paddingEnd="@dimen/espacio_16">

                        <ImageView
                            style="@style/Widget.GymProFit.Fila.Icono"
                            android:layout_gravity="center_vertical"
                            android:background="@drawable/bg_circulo_capitulo"
                            android:src="@drawable/ic_ms_cookie"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/fila_icono_a_texto"
                            android:orientation="vertical"
                            android:paddingTop="@dimen/espacio_8"
                            android:paddingBottom="@dimen/espacio_8">

                            <TextView
                                android:id="@+id/tvComidaQueToca"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.GymProFit.Seccion.Fila" />

                            <TextView
                                android:id="@+id/tvComidaQueTocaSub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/fila_icono_circulo"
                            android:layout_height="@dimen/fila_icono_circulo"
                            android:layout_marginStart="@dimen/espacio_12"
                            android:background="@drawable/bg_circulo_primario"
                            android:backgroundTint="@color/gp_cristal_principal"
                            android:importantForAccessibility="no"
                            android:padding="9dp"
                            android:src="@drawable/ic_ms_add"
                            app:tint="@color/gp_cristal_sobre_principal" />
                    </LinearLayout>
                </es.pmdm.gymprofit.ui.cristal.TarjetaCristal>
            </LinearLayout>

            <!-- Tus músculos esta semana -->
            <LinearLayout
                android:id="@+id/seccionMusculos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pestana"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.GymProFit.CabeceraSeccion">

                    <TextView
                        style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                        android:text="@string/inicio_musculos" />

                    <TextView
                        android:id="@+id/enlaceMusculos"
                        style="@style/Widget.GymProFit.CabeceraSeccion.Enlace.Cristal"
                        android:text="@string/inicio_detalle" />
                </LinearLayout>

                <include
                    android:id="@+id/estadoMusculos"
                    layout="@layout/view_estado" />

                <es.pmdm.gymprofit.ui.cristal.TarjetaCristal
                    android:id="@+id/cardMusculos"
                    style="@style/Widget.GymProFit.Card.Cristal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/titulo_a_contenido">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cristal"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_16">

                        <TextView
                            android:id="@+id/tvSemanaResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_12"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <es.pmdm.gymprofit.ui.widget.SiluetaMuscularView
                                android:id="@+id/siluetaSemana"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content" />

                            <LinearLayout
                                android:id="@+id/listaZonasSemana"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/espacio_16"
                                android:divider="@drawable/sep_zonas"
                                android:orientation="vertical"
                                android:showDividers="middle" />
                        </LinearLayout>
                    </LinearLayout>
                </es.pmdm.gymprofit.ui.cristal.TarjetaCristal>
            </LinearLayout>

            <!-- Tu progreso -->
            <LinearLayout
                android:id="@+id/seccionProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pestana"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.GymProFit.CabeceraSeccion">

                    <TextView
                        style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                        android:text="@string/inicio_progreso" />

                    <TextView
                        android:id="@+id/enlaceProgreso"
                        style="@style/Widget.GymProFit.CabeceraSeccion.Enlace.Cristal"
                        android:text="@string/inicio_ver_todo" />
                </LinearLayout>

                <include
                    android:id="@+id/estadoProgreso"
                    layout="@layout/view_estado" />

                <es.pmdm.gymprofit.ui.cristal.TarjetaCristal
                    android:id="@+id/cardProgreso"
                    style="@style/Widget.GymProFit.Card.Cristal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/titulo_a_contenido">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_cristal"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_16">

                        <LinearLayout
                            android:id="@+id/bloqueKilos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvKilosEtiqueta"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/inicio_kilos_semana"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

                                <TextView
                                    android:id="@+id/tvKilosVariacion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/espacio_8"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>

                            <es.pmdm.gymprofit.ui.widget.BarrasKilosView
                                android:id="@+id/barrasKilos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_12" />
                        </LinearLayout>

                        <!-- El último récord (view_record_inicio): nombre, detalle y marca, cada uno en
                             su línea; la tarjeta crece hasta la progresión de ese ejercicio. -->
                        <include layout="@layout/view_record_inicio" />
                    </LinearLayout>
                </es.pmdm.gymprofit.ui.cristal.TarjetaCristal>
            </LinearLayout>

            <!-- Tus últimos entrenos -->
            <LinearLayout
                android:id="@+id/seccionEntrenos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pestana"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.GymProFit.CabeceraSeccion">

                    <TextView
                        style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                        android:text="@string/inicio_entrenos" />

                    <TextView
                        android:id="@+id/enlaceEntrenos"
                        style="@style/Widget.GymProFit.CabeceraSeccion.Enlace.Cristal"
                        android:text="@string/inicio_historial" />
                </LinearLayout>

                <include
                    android:id="@+id/estadoEntrenos"
                    layout="@layout/view_estado" />

                <!-- Llega a los dos bordes de la pantalla, funde el último entreno a la vista y
                     encaja por entreno. El hueco hasta el título y el de después van como relleno
                     suyo (y el de después, descontado del margen): un carrusel recorta a su caja,
                     y ahí cae la sombra que las tarjetas llevan en claro. -->
                <es.pmdm.gymprofit.ui.widget.CarruselView
                    android:id="@+id/scrollEntrenos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla_fuera"
                    android:layout_marginEnd="@dimen/margen_pantalla_fuera"
                    android:layout_marginBottom="@dimen/separacion_pestana_fuera"
                    android:clipToPadding="false"
                    android:paddingStart="@dimen/margen_pantalla"
                    android:paddingTop="@dimen/titulo_a_contenido"
                    android:paddingEnd="@dimen/margen_pantalla"
                    android:paddingBottom="@dimen/separacion_pestana"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/listaEntrenos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/sep_carrusel"
                        android:orientation="horizontal"
                        android:showDividers="middle" />
                </es.pmdm.gymprofit.ui.widget.CarruselView>
            </LinearLayout>

            <!-- El fundador (GP-103): el primer día, con su texto; se oculta. -->
            <LinearLayout
                android:id="@+id/cardFundador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/separacion_pestana"
                android:background="@drawable/bg_tarjeta_fundador"
                android:orientation="vertical"
                android:padding="@dimen/espacio_16"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circulo_capitulo"
                        android:gravity="center"
                        android:text="@string/inicio_fundador_inicial"
                        android:textAppearance="@style/TextAppearance.GymProFit.Display"
                        android:textSize="@dimen/text_title"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/espacio_12"
                        android:accessibilityHeading="true"
                        android:text="@string/inicio_fundador_titulo"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/inicio_fundador_texto"
                    android:textSize="@dimen/text_body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEscribirFundador"
                        style="@style/Widget.GymProFit.BotonPildora.Contorno"
                        android:layout_width="wrap_content"
                        android:text="@string/inicio_fundador_escribir"
                        app:icon="@drawable/ic_ms_mail" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOcultarFundador"
                        style="@style/Widget.GymProFit.Alta.BotonTexto"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="@dimen/espacio_8"
                        android:text="@string/inicio_fundador_ocultar"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
