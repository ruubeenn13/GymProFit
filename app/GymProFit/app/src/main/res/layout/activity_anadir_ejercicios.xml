<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_anadir_ejercicios — «Elige ejercicios», el paso 2 de crear una rutina (GP-244,
  tablero Mezcla-2), y la biblioteca al añadir a una sesión. Arriba, el buscador del catálogo
  en píldora y, al crear, una píldora por zona que se quita con su aspa y «+ Zona». Cada fila
  (item_elegir_ejercicio) con el nombre, la zona y el equipo, y el botón de añadir que pasa a
  check. El pie fijo dice cuántos llevas y, al crear, «Unos 35 de tus 45 min» con su barra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/elegir_ej_titulo" />

    <LinearLayout
        android:id="@+id/campoBuscarElegir"
        android:layout_width="match_parent"
        android:layout_height="@dimen/buscador_alto"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_4"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:background="@drawable/bg_buscador_pildora"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/espacio_16"
        android:paddingEnd="@dimen/espacio_16">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ms_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/etBuscarEjercicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/espacio_12"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/ejercicios_buscar"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/grupoZonas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        app:chipSpacingHorizontal="@dimen/espacio_8"
        app:chipSpacingVertical="@dimen/espacio_4" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espacio_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEjerciciosBusqueda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_16" />

        <include
            android:id="@+id/estadoElegir"
            layout="@layout/view_estado" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/pieElegir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_16">

        <es.pmdm.gymprofit.ui.widget.FilaQueBaja
            android:id="@+id/filaPieElegir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:focusable="true">

            <TextView
                android:id="@+id/tvLlevas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTiempoElegir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
        </es.pmdm.gymprofit.ui.widget.FilaQueBaja>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraTiempoElegir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:importantForAccessibility="no"
            android:max="100"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/gp_meter_track"
            app:trackCornerRadius="4dp"
            app:indicatorTrackGapSize="0dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuar"
            style="@style/Widget.GymProFit.BotonPildora.Expresivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_12"
            android:minHeight="56dp"
            android:text="@string/elegir_ej_listo" />
    </LinearLayout>
</LinearLayout>
