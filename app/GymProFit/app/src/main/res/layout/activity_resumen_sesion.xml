<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_resumen_sesion — el resumen del entreno (GP-210 paso 1, tablero 3 «Resumen»
  de documentacion/diseno/2026-10-22-firma-visual/, que sustituye a «Sesión completada»
  del tablero 11 de nutrición). De arriba abajo:
    1. Los kilos que cuentan desde cero, con tres fichas: la variación frente a la sesión
       anterior de la misma rutina, la duración y las series.
    2. La tarjeta dorada de récords, con la marca anterior (momento 12).
    3. «Frente a la última vez», por ejercicio, en cascada.
    4. El logro conseguido, con el medallón dorado. Sin Profi: llega en el paso 5.
    5. «Para recuperar»: la proteína del día y tres ideas con su «+» (view_para_recuperar).
  Abajo, fijo, «Hecho». «Compartir» no se dibuja: llega con la tarjeta del paso 4 y aquí
  no hay nada que no funcione. Cargando y error, con view_estado; las secciones sin nada
  que enseñar no ocupan sitio.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/android:colorBackground"
        app:navigationIcon="@drawable/ic_ms_close"
        app:navigationContentDescription="@string/resumen_cerrar_a11y"
        app:title="@string/resumen_cabecera" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scrollResumen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="invisible">

            <LinearLayout
                android:id="@+id/contenidoResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp">

                <!-- 1. Lo que has movido -->
                <LinearLayout
                    android:id="@+id/layoutCelebracion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvCelebracionEyebrow"
                        style="@style/Widget.GymProFit.Seccion"
                        android:text="@string/resumen_celebracion_eyebrow"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/tvVolumenHero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/barlow_condensed"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_number_gigante"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCelebracionUnidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_celebracion_unidad"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_fila" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSinKilos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:text="@string/resumen_sin_kilos"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_fila"
                    android:visibility="gone" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/fichasResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_horizontal"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />

                <!-- 2. Récords -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layoutRecordsResumen"
                    style="@style/Widget.GymProFit.Card.Estructura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/gp_gold_container"
                    app:strokeColor="@color/gp_gold">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:id="@+id/cabeceraRecordsResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivTrofeoCabecera"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:importantForAccessibility="no"
                                android:padding="4dp"
                                android:src="@drawable/ic_ms_trophy_fill"
                                app:tint="@color/gp_gold" />

                            <TextView
                                android:id="@+id/tvRecordsTituloResumen"
                                style="@style/TextAppearance.GymProFit.Headline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:textColor="@color/gp_gold_text" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/contenedorRecordsResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvPrimerasMarcasResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/gp_gold_text"
                            android:textSize="@dimen/text_caption"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Frente a la última vez -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUltimaVez"
                    style="@style/Widget.GymProFit.Card.Estructura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tvUltimaVezTitulo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp"
                            android:text="@string/resumen_ultima_vez_titulo"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/contenedorUltimaVez"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Logro conseguido (sin Profi hasta el paso 5) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogroResumen"
                    style="@style/Widget.GymProFit.Card.Estructura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/android:colorBackground"
                    app:strokeColor="@color/gp_gold">

                    <LinearLayout
                        android:id="@+id/filaLogroResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_circulo_oro"
                            android:importantForAccessibility="no">

                            <ImageView
                                android:id="@+id/ivMedallonLogro"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ms_workspace_premium_fill"
                                app:tint="@color/gp_gold_container" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.GymProFit.Seccion"
                                android:text="@string/resumen_logro_eyebrow"
                                android:textColor="@color/gp_gold_text" />

                            <TextView
                                android:id="@+id/tvLogroNombreResumen"
                                style="@style/TextAppearance.GymProFit.Headline"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvLogroDetalleResumen"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Para recuperar -->
                <include
                    android:id="@+id/cardParaRecuperar"
                    layout="@layout/view_para_recuperar" />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/estadoResumen"
            layout="@layout/view_estado" />
    </FrameLayout>

    <!-- Abajo, fijo: «Hecho». Compartir llega con la tarjeta (paso 4). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHechoResumen"
            style="@style/Widget.GymProFit.BotonPildora"
            android:layout_width="match_parent"
            android:minHeight="52dp"
            android:text="@string/resumen_hecho" />
    </FrameLayout>
</LinearLayout>
