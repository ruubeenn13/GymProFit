<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_resumen_sesion — Pantalla de resumen de la sesión de entrenamiento y estadísticas del usuario.
  Arriba, un único número grande que celebra lo que se acaba de hacer: los kilos
  movidos. Debajo, el detalle de la sesión (fecha, duración, rutina, notas), el
  bloque de estadísticas agregadas y los logros conseguidos.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:paddingBottom="12dp"
        android:background="?attr/colorSurface">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/resumen_titulo"
            android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- === CELEBRACIÓN: un solo número grande === -->
            <!--
              Va antes que nada y es lo único grande de la pantalla. El resto de cifras
              siguen ahí abajo, pero como detalle: seis números del mismo tamaño no
              celebran nada, solo informan.
            -->
            <LinearLayout
                android:id="@+id/layoutCelebracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvCelebracionEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resumen_celebracion_eyebrow"
                    android:textSize="@dimen/text_eyebrow"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvVolumenHero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="@dimen/text_number"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/barlow_condensed"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvVolumenUnidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resumen_celebracion_unidad"
                    android:textSize="@dimen/text_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

            <!-- === CARD SESIÓN === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resumen_seccion_sesion"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Fecha -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/resumen_fecha"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvFechaResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Duración -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/resumen_duracion"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvDuracionResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Calorías -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/resumen_calorias"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvCaloriasResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Rutina -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/resumen_rutina"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvRutinaResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Notas (oculto si vacío) -->
                    <LinearLayout
                        android:id="@+id/layoutNotasResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/resumen_notas"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvNotasResumen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/text_body"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <!-- Badge completada -->
                    <TextView
                        android:id="@+id/tvCompletadaResumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resumen_completada"
                        android:textSize="@dimen/text_label"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- === CARD ESTADÍSTICAS === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resumen_seccion_stats"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:layout_marginBottom="8dp" />

            <!-- Tarjetas de estadísticas en filas de 2 -->
            <!-- Fila 1: totalSesiones | sesionesCompletadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatSesiones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_sesiones"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatCompletadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_completadas"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Fila 2: totalMinutos | totalCalorias -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatMinutos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_minutos"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatCalorias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_calorias"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Fila 3: rachaActual | mejorRacha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatRacha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_racha"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatMejorRacha"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/resumen_stat_mejor_racha"
                            android:textSize="@dimen/text_eyebrow"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- === CARD LOGROS === -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resumen_seccion_logros"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvLogrosVacioResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center"
                        android:text="@string/resumen_sin_logros"
                        android:textSize="@dimen/text_body"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLogrosResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
