<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_detalle_ejercicio — ficha de un ejercicio (GP-216, tablero 30). Arriba la demostración
  (los dos fotogramas del catálogo, alternados), el nombre con sus datos, tu mejor marca en dorado
  con el máximo estimado y dos pestañas: «Tu progreso» (gráfica por periodo y tus últimas veces) y
  «Cómo se hace» (los pasos numerados). Todo lo que depende de tus datos se oculta si no hay.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetalle"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/espacio_36">

            <!-- Demostración: debajo del botón de volver, 24 dp de radio -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GymProFit.Card"
                android:id="@+id/cardDemo"
                android:layout_width="match_parent"
                android:layout_height="238dp"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="72dp"
                android:layout_marginEnd="@dimen/margen_pantalla"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="@dimen/radio_tarjeta"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:id="@+id/layoutVideoPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Sin foto: la silueta de la zona, nunca un bloque en blanco. -->
                    <ImageView
                        android:id="@+id/ivSilueta"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/espacio_16"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_body_full" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/ivImagenDetalle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- Segundo fotograma: se funde con el primero en bucle -->
                <ImageView
                    android:id="@+id/ivImagenDetalle2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvNombreDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_20"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:accessibilityHeading="true"
                android:lineSpacingMultiplier="1.05"
                android:textAppearance="@style/TextAppearance.GymProFit.Display"
                android:textSize="@dimen/text_display_large" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/margen_pantalla"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <!-- Tu mejor marca, en dorado: solo si ya tiene récord -->
            <LinearLayout
                android:id="@+id/cardMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_24"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:background="@drawable/bg_marca_oro"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ms_trophy_fill"
                    app:tint="@color/gp_gold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMarcaFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_eyebrow" />

                    <TextView
                        android:id="@+id/tvMarcaValor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GymProFit.Number"
                        android:textColor="@color/gp_gold_text"
                        android:textSize="@dimen/text_cifra_pequena" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bloqueMaximo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_8"
                    android:gravity="end"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvMaximoValor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.GymProFit.Number"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detalle_ejercicio_maximo_estimado"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_eyebrow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pestañas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_24"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:background="@drawable/bg_pestanas_progreso"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnTabProgreso"
                    style="@style/Widget.GymProFit.PestanaFicha"
                    android:text="@string/detalle_ejercicio_tab_progreso" />

                <TextView
                    android:id="@+id/btnTabComo"
                    style="@style/Widget.GymProFit.PestanaFicha"
                    android:text="@string/detalle_ejercicio_tab_como" />
            </LinearLayout>

            <!-- Tu progreso -->
            <LinearLayout
                android:id="@+id/panelProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_20"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardProgresion"
                    style="@style/Widget.GymProFit.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProgresionTitulo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/detalle_progresion_peso_maximo"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvProgresionDelta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_caption"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chartProgresion"
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:layout_marginTop="@dimen/espacio_8" />

                        <LinearLayout
                            android:id="@+id/periodos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_8"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <TextView
                                android:id="@+id/btnPeriodo4"
                                style="@style/Widget.GymProFit.PeriodoFicha"
                                android:text="@string/detalle_periodo_4" />

                            <TextView
                                android:id="@+id/btnPeriodo8"
                                style="@style/Widget.GymProFit.PeriodoFicha"
                                android:text="@string/detalle_periodo_8" />

                            <TextView
                                android:id="@+id/btnPeriodoTodo"
                                style="@style/Widget.GymProFit.PeriodoFicha"
                                android:text="@string/detalle_periodo_todo" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sin ninguna vez todavía -->
                <TextView
                    android:id="@+id/tvSinDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:text="@string/detalle_ejercicio_sin_datos"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />

                <!-- Tus últimas veces -->
                <LinearLayout
                    android:id="@+id/bloqueVeces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_20"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margen_pantalla"
                        android:layout_marginEnd="@dimen/margen_pantalla"
                        android:accessibilityHeading="true"
                        android:text="@string/detalle_ejercicio_ultimas_veces"
                        android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

                    <!-- La pista solo sale si hay una regla que la respalde (ProximaVez) -->
                    <LinearLayout
                        android:id="@+id/cardPista"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margen_pantalla"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:layout_marginEnd="@dimen/margen_pantalla"
                        android:background="@drawable/bg_pista_ejercicio"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ms_trending_up"
                            app:tint="@color/gp_primary_sobre_hero" />

                        <TextView
                            android:id="@+id/tvPista"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_12"
                            android:layout_weight="1"
                            android:lineSpacingMultiplier="1.1"
                            android:textColor="@color/gp_on_hero"
                            android:textSize="@dimen/text_enlace_seccion" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/listaVeces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margen_pantalla"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:layout_marginEnd="@dimen/margen_pantalla"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- Cómo se hace -->
            <LinearLayout
                android:id="@+id/panelComo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_20"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/espacio_16"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_enlace_seccion"
                    android:visibility="gone" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPasos"
                    style="@style/Widget.GymProFit.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/listaPasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_20" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvSinPasos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detalle_ejercicio_sin_pasos"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Volver, sobre la demostración -->
    <View
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?android:attr/colorBackground"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/btnAtras"
        style="@style/Widget.GymProFit.BotonRedondo"
        android:layout_marginStart="@dimen/espacio_8"
        android:layout_marginTop="@dimen/espacio_12"
        android:contentDescription="@string/ficha_atras"
        android:src="@drawable/ic_ms_arrow_back" />
</FrameLayout>
