<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main — Contenedor de la navegación principal por pestañas.
  El ViewPager2 (5 Fragments) ocupa TODA la pantalla y la FloatingNavBar flota
  ENCIMA, anclada abajo (liquid glass: el contenido scrollea por debajo y se ve
  difuminado a través del cristal). La barra no se recrea al cambiar de pestaña,
  por lo que su burbuja "viaja" siguiendo el scroll del pager; además permite
  deslizar (swipe) entre pestañas. Sus medidas salen de @dimen/nav_bar_*, las
  mismas que BaseFragment usa para reservar hueco bajo el contenido de cada
  pestaña: si la barra cambia de alto, el hueco cambia con ella.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Barra de navegación flotante (liquid glass con backdrop blur + burbuja) -->
    <es.pmdm.gymprofit.ui.widget.FloatingNavBar
        android:id="@+id/floatingNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/nav_bar_margin"
        android:layout_marginEnd="@dimen/nav_bar_margin"
        android:layout_marginBottom="@dimen/nav_bar_margin" />

</FrameLayout>
