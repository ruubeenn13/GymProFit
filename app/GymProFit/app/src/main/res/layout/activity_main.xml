<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_main — la navegación principal (GP-105).
  Arriba, las cuatro pestañas en un ViewPager2 sin deslizamiento; abajo, la barra fija.
  La barra no se superpone al contenido: cada pestaña llega hasta su borde y no tiene
  que reservar hueco. El velo y la hoja del «+» cubren solo el contenido, de modo que
  la barra —y su «×»— siguen a la vista y a mano con la hoja abierta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/veloAcciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/gp_velo"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <include layout="@layout/view_acciones_rapidas" />
    </FrameLayout>

    <es.pmdm.gymprofit.ui.widget.BarraNavegacion
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
