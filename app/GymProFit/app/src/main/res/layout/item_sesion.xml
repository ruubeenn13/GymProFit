<?xml version="1.0" encoding="utf-8"?>
<!--
  item_sesion — una sesión del Historial completo (GP-232, tablero «Historial»): la rutina de
  título y el cuándo arriba a la derecha («Ayer, 18:05»); debajo, las zonas en frase, los kilos
  con las barras de sus últimas veces con esa rutina (bajan bajo los kilos si no caben), la
  comparación con la anterior y minutos, series y récords en frase, el récord en dorado.
  Sin papelera: se borra deslizando a la izquierda o con la acción de TalkBack. TalkBack la lee
  de una vez (la rellena SesionAdapter).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSesion"
    style="@style/Widget.GymProFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_12"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:padding="@dimen/espacio_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRutinaSesion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

            <TextView
                android:id="@+id/tvCuandoSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_8"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                android:textColor="@color/gp_text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvZonasSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
            android:textColor="@color/gp_text_secondary" />

        <es.pmdm.gymprofit.ui.widget.FilaQueBaja
            android:id="@+id/filaKilosSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvKilosSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />

            <es.pmdm.gymprofit.ui.widget.BarrasVecesView
                android:id="@+id/barrasSesion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrasAlto="@dimen/barras_tarjeta_alto"
                app:barrasAncho="@dimen/barras_tarjeta_ancho"
                app:barrasHueco="@dimen/barras_tarjeta_hueco" />
        </es.pmdm.gymprofit.ui.widget.FilaQueBaja>

        <TextView
            android:id="@+id/tvComparacionSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMetaSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
            android:textColor="@color/gp_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
