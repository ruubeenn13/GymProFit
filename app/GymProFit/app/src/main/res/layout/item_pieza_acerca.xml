<?xml version="1.0" encoding="utf-8"?>
<!--
  item_pieza_acerca — una de las cuatro piezas de «Acerca de» (GP-216, tablero 23): un icono con su
  color y una frase corta, en una tarjeta pequeña. Decorativa: no se pulsa. La rellena AcercaDeActivity.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GymProFit.Card.Pequena"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/espacio_16">

        <ImageView
            android:id="@+id/ivPieza"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvPieza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:textAppearance="@style/TextAppearance.GymProFit.Seccion.Fila" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
