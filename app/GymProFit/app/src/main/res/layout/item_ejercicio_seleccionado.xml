<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ejercicio_seleccionado — item de RecyclerView para un ejercicio añadido a una rutina.
  Muestra nombre, chips (dificultad/calorías/series-reps) y botón de eliminar, usado al construir una rutina.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <!-- Fila principal: icono + info + botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Icono del ejercicio -->
        <ImageView
            android:id="@+id/ivIconoEjercicio"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_ms_fitness_center"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvDescripcionSeleccionado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- Chips de dificultad, calorías y series/reps configuradas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDificultad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_eyebrow"
                    app:chipMinHeight="24dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    style="@style/Widget.Material3.Chip.Assist" />

                <!-- AQUÍ HABÍA UN CHIP DE kcal, Y SE RETIRA (DEC-004 / GP-010). -->

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSeriesReps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textSize="@dimen/text_eyebrow"
                    android:textStyle="bold"
                    app:chipMinHeight="24dp"
                    android:clickable="false"
                    android:focusable="false"
                    style="@style/Widget.Material3.Chip.Suggestion" />

            </LinearLayout>

        </LinearLayout>

        <!-- Botón para quitar el ejercicio de la selección -->
        <ImageView
            android:id="@+id/btnEliminarSeleccionado"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_ms_close"
            android:tint="?attr/colorOnSurface"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="@string/accion_quitar_ejercicio" />

        <!-- Chevron indicador de navegación al detalle -->
        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_ms_chevron_right"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
