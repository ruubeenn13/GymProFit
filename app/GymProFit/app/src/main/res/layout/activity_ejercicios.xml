<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_ejercicios.xml — Biblioteca de ejercicios (GP-216, tablero 29). Arriba, fijos: volver,
  el buscador en píldora y los chips de grupo con su icono (filtran en el servidor). Debajo, una
  sola lista que se desplaza entera: «Los que más haces», el rótulo con cuántos hay y las filas
  dentro de una tarjeta. Se abre desde Entrenar, ya filtrada o con el teclado abierto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/biblioteca_titulo" />

    <!-- Buscador: píldora de 56 dp -->
    <LinearLayout
        android:id="@+id/campoBuscarBiblioteca"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:background="@drawable/bg_buscador_pildora"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="@dimen/espacio_8">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ms_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/ejercicios_buscar"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_body" />

        <ImageButton
            android:id="@+id/btnLimpiarBusqueda"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ejercicios_limpiar_busqueda"
            android:src="@drawable/ic_ms_close"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Grupo muscular: un chip por grupo, con su icono -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_16"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_4"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/espacio_8"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:checked="true"
                android:text="@string/ejercicios_todos"
                app:chipIcon="@drawable/ic_ms_splitscreen" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPecho"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_pecho"
                app:chipIcon="@drawable/ic_ms_fitness_center" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipEspalda"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_espalda"
                app:chipIcon="@drawable/ic_ms_accessibility_new" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPiernas"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_piernas"
                app:chipIcon="@drawable/ic_ms_directions_run" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHombros"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_hombros"
                app:chipIcon="@drawable/ic_ms_bolt" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBrazos"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_brazos"
                app:chipIcon="@drawable/ic_ms_target" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCore"
                style="@style/Widget.GymProFit.Chip.Biblioteca"
                android:text="@string/ejercicios_core"
                app:chipIcon="@drawable/ic_ms_spa" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Lista + estado vacío superpuesto -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEjercicios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/espacio_28" />

        <!-- «No hay nada»: sobre la lista, debajo de la cabecera de «Los que más haces» -->
        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="120dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/feedback_lista_vacia"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_subtitle"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
