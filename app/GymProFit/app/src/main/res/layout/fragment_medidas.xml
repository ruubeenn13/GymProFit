<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_medidas — sección Medidas de Progreso (GP-105; antes MedicionesActivity).
  La última medición, editable fila a fila, y la gráfica por métrica y rango.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Área de contenido -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_ms_monitor_weight"
                android:alpha="0.3"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/mediciones_sin_mediciones"
                android:textSize="@dimen/text_subtitle"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/medicion_sin_datos_subtitulo"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrarPrimera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/medicion_registrar_primera"
                app:icon="@drawable/ic_ms_add" />

        </LinearLayout>

        <!-- Contenido con mediciones -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollMediciones"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingTop="@dimen/espacio_16"
                android:paddingBottom="@dimen/espacio_16">

                <TextView
                    android:id="@+id/tvFechaUltima"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Gráfica de evolución del peso (oculta si hay <2 registros con peso) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGraficaPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvGraficaTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/medicion_grafica_peso"
                            android:textAppearance="@style/TextAppearance.GymProFit.Label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <!-- Toggle de métrica: qué medida se representa -->
                        <es.pmdm.gymprofit.ui.widget.SelectorPildora
                            android:id="@+id/chipsMetrica"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:selectorOpciones="@array/selector_metricas"
                            app:selectorNombreGrupo="@string/selector_grupo_metrica"
                            app:selectorElegida="0" />

                        <!-- Área de gráfica: la línea, el punto solo o, si esa métrica no tiene
                             datos en el rango, un mensaje de estado vacío (la card y los chips NO
                             desaparecen; GP-229). -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:layout_marginTop="8dp">

                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/chartPeso"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <TextView
                                android:id="@+id/tvGraficaVacia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/grafica_sin_medida"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_body"
                                android:gravity="center"
                                android:visibility="gone" />

                            <!-- Con un solo punto: qué hace falta para ver la línea (GP-229). Va
                                 encima de la gráfica, arriba: aparecer no mueve el selector de
                                 rango (revisor, GP-225). Lo dice la descripción de la gráfica. -->
                            <TextView
                                android:id="@+id/tvGraficaPista"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                                android:textColor="@color/gp_text_secondary"
                                android:visibility="gone" />

                        </FrameLayout>


                        <!-- Rango temporal de la gráfica -->
                        <es.pmdm.gymprofit.ui.widget.SelectorPildora
                            android:id="@+id/chipsRango"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:selectorOpciones="@array/selector_rangos"
                            app:selectorNombreGrupo="@string/selector_grupo_rango"
                            app:selectorElegida="2" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 8 dp por los lados: el anillo de foco de una fila (2 dp de aire y 2 de trazo por
                         fuera) cabe dentro de la tarjeta y no pisa su borde (revisor, lote 7). -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp">

                        <!-- Peso -->
                        <LinearLayout
                            android:id="@+id/rowPeso"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/fila_alto_min"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/perfil_peso"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvPesoVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_ms_chevron_right"
                                app:tint="@color/gp_stroke"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                        <!-- Grasa corporal -->
                        <LinearLayout
                            android:id="@+id/rowGrasa"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/fila_alto_min"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/medicion_label_grasa"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvGrasaVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_ms_chevron_right"
                                app:tint="@color/gp_stroke"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                        <!-- Cintura -->
                        <LinearLayout
                            android:id="@+id/rowCintura"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/fila_alto_min"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/medicion_label_cintura"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvCinturaVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_ms_chevron_right"
                                app:tint="@color/gp_stroke"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                        <!-- Notas -->
                        <LinearLayout
                            android:id="@+id/rowNotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/fila_alto_min"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/medicion_label_notas"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:id="@+id/tvNotasVal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxWidth="140dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="8dp"
                                android:src="@drawable/ic_ms_chevron_right"
                                app:tint="@color/gp_stroke"
                                android:contentDescription="@null" />

                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp"
                            android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                        <!-- Toggle: despliega/oculta las medidas avanzadas (nicho) -->
                        <LinearLayout
                            android:id="@+id/rowMasDetalles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/fila_alto_min"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvMasDetalles"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/medicion_mas_detalles"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:drawableEnd="@drawable/ic_ms_keyboard_arrow_down"
                                android:drawableTint="?attr/colorPrimary"
                                android:drawablePadding="6dp"
                                android:gravity="center_vertical" />

                        </LinearLayout>

                        <!-- Medidas avanzadas (colapsable, oculto por defecto) -->
                        <LinearLayout
                            android:id="@+id/layoutMasDetalles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <!-- Masa muscular -->
                            <LinearLayout
                                android:id="@+id/rowMusculo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/fila_alto_min"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/medicion_label_musculo"
                                    android:textSize="@dimen/text_body"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvMusculoVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_body"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_ms_chevron_right"
                                    app:tint="@color/gp_stroke"
                                    android:contentDescription="@null" />

                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                            <!-- Pecho -->
                            <LinearLayout
                                android:id="@+id/rowPecho"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/fila_alto_min"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/medicion_label_pecho"
                                    android:textSize="@dimen/text_body"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvPechoVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_body"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_ms_chevron_right"
                                    app:tint="@color/gp_stroke"
                                    android:contentDescription="@null" />

                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                            <!-- Brazos -->
                            <LinearLayout
                                android:id="@+id/rowBrazos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/fila_alto_min"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/medicion_label_brazos"
                                    android:textSize="@dimen/text_body"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvBrazosVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_body"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_ms_chevron_right"
                                    app:tint="@color/gp_stroke"
                                    android:contentDescription="@null" />

                            </LinearLayout>

                            <View android:layout_width="match_parent" android:layout_height="1dp"
                                android:layout_marginHorizontal="12dp" android:background="?attr/colorOutlineVariant" />

                            <!-- Piernas -->
                            <LinearLayout
                                android:id="@+id/rowPiernas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="@dimen/fila_alto_min"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/medicion_label_piernas"
                                    android:textSize="@dimen/text_body"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvPiernasVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="@dimen/text_body"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_ms_chevron_right"
                                    app:tint="@color/gp_stroke"
                                    android:contentDescription="@null" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>
