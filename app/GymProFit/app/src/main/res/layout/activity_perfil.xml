<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_perfil — Perfil y ajustes (GP-216, tablero 17). Sustituye a Ajustes y reúne lo que
  eran sus 22 filas en un solo patrón (view_fila_ajuste): la cabecera del perfil con la cámara
  sobre el avatar, la tarjeta «Tus datos y objetivos» con el plan, y los grupos Cuenta,
  Entrenamiento, La app, Ayuda y Legal (más Administración solo para ADMIN), y «Cerrar sesión»
  y «Eliminar cuenta» al final. Se abre con el avatar de Inicio, Entrenar, Nutrición y Progreso.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/perfil_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_16"
            android:paddingBottom="@dimen/espacio_36">

            <!-- Tu perfil: el avatar con la cámara (es el «Foto de perfil» de antes), el nombre y desde cuándo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <include
                        android:id="@+id/avatarPerfil"
                        layout="@layout/view_avatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="@dimen/espacio_12"
                        android:layout_marginEnd="@dimen/espacio_12"
                        android:layout_marginBottom="@dimen/espacio_12" />

                    <ImageButton
                        android:id="@+id/btnCamaraPerfil"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_camara_perfil"
                        android:contentDescription="@string/perfil_cambiar_foto_a11y"
                        android:padding="@dimen/espacio_12"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ms_photo_camera"
                        app:tint="?attr/colorSurface" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPerfilNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                <TextView
                    android:id="@+id/tvPerfilSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
            </LinearLayout>

            <!-- Tu objetivo (GP-242, tablero Objetivo-1): el icono del objetivo de Tus datos, el nombre
                 con «Cambiar», lo que supone en una frase y el plan: las kcal y el reparto de los macros. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardObjetivo"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:layout_marginEnd="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_icono_objetivo"
                            android:importantForAccessibility="no">

                            <ImageView
                                android:id="@+id/ivObjetivo"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                app:tint="?attr/colorPrimary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_12"
                            android:layout_weight="1"
                            android:importantForAccessibility="no"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/perfil_objetivo_rotulo"
                                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                                android:textColor="@color/gp_text_secondary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvObjetivoNombre"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarObjetivo"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/aire_anillo_fuera"
                            android:contentDescription="@string/perfil_objetivo_cambiar_a11y"
                            android:minHeight="@dimen/zona_tactil"
                            android:minWidth="@dimen/zona_tactil"
                            android:text="@string/apuntar_cambiar"
                            android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                            android:textColor="?attr/colorPrimary"
                            app:rippleColor="@color/tarjeta_capa" />
                    </LinearLayout>

                    <!-- Lo de debajo se lee de una vez: «Tu objetivo, perder grasa. Comes… 2.150 kcal
                         al día: 160 gramos de proteína, 210 de hidratos y 74 de grasa.» -->
                    <LinearLayout
                        android:id="@+id/bloqueObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_16"
                        android:focusable="true"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvObjetivoFrase"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo"
                            android:textColor="@color/gp_text_secondary" />

                        <LinearLayout
                            android:id="@+id/bloquePlan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/separador_alto"
                                android:layout_marginTop="@dimen/espacio_16"
                                android:background="?attr/colorSurfaceVariant" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_16"
                                android:baselineAligned="true"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvPlanKcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Number" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/espacio_8"
                                    android:layout_weight="1"
                                    android:text="@string/perfil_kcal_al_dia"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo"
                                    android:textColor="@color/gp_text_secondary" />
                            </LinearLayout>

                            <!-- La barra del reparto: un tramo por macro, del ancho de sus kcal. -->
                            <LinearLayout
                                android:id="@+id/barraMacros"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/espacio_8"
                                android:orientation="horizontal">

                                <View
                                    android:id="@+id/tramoProteina"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_tramo_macro"
                                    android:backgroundTint="@color/gp_macro_proteinas" />

                                <View
                                    android:id="@+id/tramoHidratos"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="@dimen/reparto_hueco"
                                    android:background="@drawable/bg_tramo_macro"
                                    android:backgroundTint="@color/gp_macro_carbos" />

                                <View
                                    android:id="@+id/tramoGrasa"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="@dimen/reparto_hueco"
                                    android:background="@drawable/bg_tramo_macro"
                                    android:backgroundTint="@color/gp_macro_grasas" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/filaMacros"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/espacio_8"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/columnaProteina"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvPlanProteina"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                                        android:textColor="@color/gp_macro_proteinas" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/perfil_macro_proteina"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                                        android:textColor="@color/gp_text_secondary" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/columnaHidratos"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/reparto_hueco"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvPlanHidratos"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                                        android:textColor="@color/gp_macro_carbos" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/perfil_macro_hidratos"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                                        android:textColor="@color/gp_text_secondary" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/columnaGrasa"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/reparto_hueco"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tvPlanGrasa"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                                        android:textColor="@color/gp_macro_grasas" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/perfil_macro_grasa"
                                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                                        android:textColor="@color/gp_text_secondary" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tus datos en rejilla: peso, altura y edad; nivel y actividad. «Editar» abre Tus datos. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTusDatos"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_16"
                android:layout_marginEnd="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espacio_20"
                    android:paddingTop="@dimen/espacio_8"
                    android:paddingEnd="@dimen/espacio_20"
                    android:paddingBottom="@dimen/espacio_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/perfil_datos_titulo"
                            android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditarDatos"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/aire_anillo_fuera"
                            android:contentDescription="@string/perfil_datos_editar_a11y"
                            android:minHeight="@dimen/zona_tactil"
                            android:minWidth="@dimen/zona_tactil"
                            android:text="@string/perfil_datos_editar"
                            android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                            android:textColor="?attr/colorPrimary"
                            app:icon="@drawable/ic_ms_edit"
                            app:iconSize="20dp"
                            app:iconTint="?attr/colorPrimary"
                            app:rippleColor="@color/tarjeta_capa" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/filaDatos1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:id="@+id/filaDatos2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_16"
                        android:baselineAligned="false"
                        android:orientation="horizontal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cuenta -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_cuenta" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaCorreo" layout="@layout/view_fila_ajuste" />
                <!-- GP-045: solo mientras el correo esté sin verificar. -->
                <include android:id="@+id/filaVerificarCorreo" layout="@layout/view_fila_ajuste"
                    android:visibility="gone" />
                <include android:id="@+id/filaContrasena" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Entrenamiento -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_entrenamiento" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaDescansoAlMarcar" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaDescansoSinPauta" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAvisosDescanso" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- La app -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/perfil_la_app" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaNotificaciones" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaTema" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaIdioma" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaVaso" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Ayuda -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_ayuda" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaSoporte" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaError" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaMejora" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Legal -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_legal" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaTerminos" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaPrivacidad" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaLicencias" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAcerca" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Administración: solo ADMIN, temporal hasta la web de administración (GP-085) -->
            <TextView
                android:id="@+id/tvSeccionAdmin"
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_admin"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/grupoAdmin"
                style="@style/Widget.GymProFit.GrupoAjustes.Pantalla"
                android:visibility="gone">

                <include android:id="@+id/filaAdmin" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:text="@string/perfil_cerrar_sesion" />

            <TextView
                android:id="@+id/btnEliminarCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_8"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="@dimen/espacio_16"
                android:paddingEnd="@dimen/espacio_16"
                android:text="@string/perfil_eliminar_cuenta"
                android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
