<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_perfil — Perfil y ajustes (GP-216, tablero 17). Sustituye a Ajustes y reúne lo que
  eran sus 22 filas en un solo patrón (view_fila_ajuste): la cabecera del perfil con la cámara
  sobre el avatar, la tarjeta «Tus datos y objetivos» con el plan, y los grupos Cuenta,
  Entrenamiento, La app, Ayuda y Legal (más Administración solo para ADMIN), y «Cerrar sesión»
  y «Eliminar cuenta» al final. Se abre con el avatar de Inicio, Entrenar, Nutrición y Progreso.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/perfil_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_16"
            android:paddingBottom="@dimen/espacio_36">

            <!-- Tu perfil: el avatar con la cámara (es el «Foto de perfil» de antes), el nombre y desde cuándo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <include
                        android:id="@+id/avatarPerfil"
                        layout="@layout/view_avatar"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="@dimen/espacio_12"
                        android:layout_marginEnd="@dimen/espacio_12"
                        android:layout_marginBottom="@dimen/espacio_12" />

                    <ImageButton
                        android:id="@+id/btnCamaraPerfil"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="end|bottom"
                        android:background="@drawable/bg_camara_perfil"
                        android:contentDescription="@string/perfil_cambiar_foto_a11y"
                        android:padding="@dimen/espacio_12"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_ms_photo_camera"
                        app:tint="?attr/colorSurface" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPerfilNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                <TextView
                    android:id="@+id/tvPerfilSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
            </LinearLayout>

            <!-- GP-265: «Tu objetivo», tarjeta destacada. En claro, casi negra con texto claro;
                 en oscuro, superficie elevada con borde fino (gp_objetivo_*). Las fichas son las kcal
                 y la proteína del día que ya calcula la app (DiaNutricion); sin plan, no salen. Sin
                 objetivo, el bloque «vacío» lo pide. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardObjetivo"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                app:cardBackgroundColor="@color/gp_objetivo_fondo"
                app:strokeColor="@color/gp_objetivo_borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/perfil_objetivo_rotulo"
                            android:textAppearance="@style/TextAppearance.GymProFit.Label"
                            android:textColor="@color/gp_objetivo_texto_2"
                            android:textSize="@dimen/text_rotulo_destacado"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCambiarObjetivo"
                            style="@style/Widget.GymProFit.BotonPildora.Contorno"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/perfil_objetivo_cambiar_a11y"
                            android:minHeight="@dimen/zona_tactil"
                            android:minWidth="@dimen/zona_tactil"
                            android:text="@string/apuntar_cambiar"
                            android:textColor="@color/gp_objetivo_texto"
                            app:strokeColor="@color/gp_objetivo_contorno" />
                    </LinearLayout>

                    <!-- Con objetivo: icono, nombre y fichas. Se lee de una vez. -->
                    <LinearLayout
                        android:id="@+id/bloqueObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:focusable="true"
                        android:importantForAccessibility="yes"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_icono_objetivo_destacado">

                                <ImageView
                                    android:id="@+id/ivObjetivo"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:layout_gravity="center"
                                    app:tint="@color/gp_objetivo_icono" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvObjetivoNombre"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/espacio_16"
                                android:layout_weight="1"
                                android:fontFamily="@font/barlow_condensed_extrabold"
                                android:lineSpacingMultiplier="0.9"
                                android:textColor="@color/gp_objetivo_texto"
                                android:textSize="@dimen/text_titular_objetivo" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/fichasObjetivo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_16"
                            android:baselineAligned="false"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_ficha_objetivo"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/espacio_12"
                                android:paddingTop="@dimen/espacio_8"
                                android:paddingEnd="@dimen/espacio_12"
                                android:paddingBottom="@dimen/espacio_8">

                                <TextView
                                    android:id="@+id/tvFichaKcal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/barlow_condensed"
                                    android:textColor="@color/gp_objetivo_texto"
                                    android:textSize="@dimen/text_headline"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_ficha_kcal"
                                    android:textColor="@color/gp_objetivo_texto_2"
                                    android:textSize="@dimen/text_eyebrow" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/espacio_8"
                                android:layout_weight="1"
                                android:background="@drawable/bg_ficha_objetivo"
                                android:orientation="vertical"
                                android:paddingStart="@dimen/espacio_12"
                                android:paddingTop="@dimen/espacio_8"
                                android:paddingEnd="@dimen/espacio_12"
                                android:paddingBottom="@dimen/espacio_8">

                                <TextView
                                    android:id="@+id/tvFichaProteina"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/barlow_condensed"
                                    android:textColor="@color/gp_objetivo_texto"
                                    android:textSize="@dimen/text_headline"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/perfil_ficha_proteina"
                                    android:textColor="@color/gp_objetivo_texto_2"
                                    android:textSize="@dimen/text_eyebrow" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Sin objetivo: lo pide. Es una propuesta, no un estado de carga (como la tarjeta
                         «sin programa» de Entrenar), así que no va en view_estado. El botón de arriba también lleva a elegirlo. -->
                    <LinearLayout
                        android:id="@+id/objetivoPorElegir"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_12"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/barlow_condensed_extrabold"
                            android:text="@string/perfil_objetivo_vacio_titulo"
                            android:textColor="@color/gp_objetivo_texto"
                            android:textSize="@dimen/text_titular_vacio" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_4"
                            android:text="@string/perfil_objetivo_vacio_texto"
                            android:textColor="@color/gp_objetivo_texto_2"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GP-265: «Tus datos», los cuatro en una fila separados por líneas finas. Lo que no
                 se sabe sale con una raya, nunca con el valor de serie. El lápiz abre Tus datos. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTusDatos"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_16"
                android:layout_marginEnd="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/espacio_20"
                    android:paddingTop="@dimen/espacio_8"
                    android:paddingEnd="@dimen/espacio_8"
                    android:paddingBottom="@dimen/espacio_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/perfil_datos_titulo"
                            android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                        <ImageButton
                            android:id="@+id/btnEditarDatos"
                            android:layout_width="@dimen/zona_tactil"
                            android:layout_height="@dimen/zona_tactil"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/perfil_datos_editar_a11y"
                            android:src="@drawable/ic_ms_edit"
                            android:tooltipText="@string/perfil_datos_editar_a11y"
                            app:tint="?attr/colorPrimary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/filaDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:layout_marginEnd="@dimen/espacio_12"
                        android:baselineAligned="false"
                        android:divider="@drawable/div_datos_perfil"
                        android:orientation="horizontal"
                        android:showDividers="middle">

                        <include android:id="@+id/datoPeso" layout="@layout/item_dato_perfil" />
                        <include android:id="@+id/datoAltura" layout="@layout/item_dato_perfil" />
                        <include android:id="@+id/datoEdad" layout="@layout/item_dato_perfil" />
                        <include android:id="@+id/datoActividad" layout="@layout/item_dato_perfil" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cuenta -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_cuenta" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaCorreo" layout="@layout/view_fila_ajuste" />
                <!-- GP-045: solo mientras el correo esté sin verificar. -->
                <include android:id="@+id/filaVerificarCorreo" layout="@layout/view_fila_ajuste"
                    android:visibility="gone" />
                <include android:id="@+id/filaContrasena" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Entrenamiento -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_entrenamiento" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaDescansoAlMarcar" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaDescansoSinPauta" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAvisosDescanso" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- La app -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/perfil_la_app" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaNotificaciones" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaTema" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaIdioma" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaVaso" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Ayuda -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_ayuda" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaSoporte" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaError" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaMejora" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Legal -->
            <TextView
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_legal" />

            <LinearLayout style="@style/Widget.GymProFit.GrupoAjustes.Pantalla">

                <include android:id="@+id/filaTerminos" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaPrivacidad" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaLicencias" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAcerca" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Administración: solo ADMIN, temporal hasta la web de administración (GP-085) -->
            <TextView
                android:id="@+id/tvSeccionAdmin"
                style="@style/Widget.GymProFit.RotuloGrupo"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:text="@string/ajustes_admin"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/grupoAdmin"
                style="@style/Widget.GymProFit.GrupoAjustes.Pantalla"
                android:visibility="gone">

                <include android:id="@+id/filaAdmin" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <!-- Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:text="@string/perfil_cerrar_sesion" />

            <TextView
                android:id="@+id/btnEliminarCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_8"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="@dimen/espacio_16"
                android:paddingEnd="@dimen/espacio_16"
                android:text="@string/perfil_eliminar_cuenta"
                android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
