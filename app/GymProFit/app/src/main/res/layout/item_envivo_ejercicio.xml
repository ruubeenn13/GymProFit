<?xml version="1.0" encoding="utf-8"?>
<!--
  item_envivo_ejercicio — cabecera de la tarjeta de un ejercicio en la sesión en vivo
  (GP-012): nombre, pauta y notas como en el detalle de la rutina, la última vez
  (GP-014), «Tu récord» y el aviso del récord (GP-210), el menú del ejercicio y los rótulos
  de las columnas de las series.
  En Liquid Glass (GP-285, lote 2) no lleva fondo: la tarjeta de cristal de cada ejercicio la
  pinta la lista de una pieza, detrás de su cabecera, sus series y su pie (TarjetaEjercicioCristal).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/envivo_margen"
    android:layout_marginEnd="@dimen/envivo_margen"
    android:layout_marginTop="16dp"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/grupoCabecera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:focusable="true"
            android:importantForAccessibility="yes">

            <TextView
                android:id="@+id/tvNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.GymProFit.Display"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_headline" />

            <TextView
                android:id="@+id/tvPauta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvNotas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- «Tu récord: 85 kg × 7», con su trofeo, en el dorado de texto sobre cristal
                 (4,5:1 en los dos temas), o «Primera vez», en neutro (GP-210). -->
            <TextView
                android:id="@+id/tvRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:drawableStartCompat="@drawable/ic_ms_trophy"
                android:drawablePadding="5dp"
                app:drawableTint="@color/gp_cristal_oro"
                android:importantForAccessibility="no"
                android:textColor="@color/gp_cristal_oro"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUltimaVez"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAccessibility="no"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMenuEjercicio"
            style="@style/Widget.GymProFit.BotonIcono"
            android:src="@drawable/ic_ms_more_vert"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- El aviso del récord (GP-210, momento 25): baja con el trofeo, las chispas y el brillo.
         Sobre cristal, la fila dorada (el tinte del diseño sobre su surco); el título, en el
         dorado que pasa 4,5:1 ahí, y la marca de antes, en el texto principal. -->
    <LinearLayout
        android:id="@+id/avisoRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_cristal_fila_oro"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/marcoTrofeo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivTrofeo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_trophy_fill"
                app:tint="@color/gp_cristal_oro_fila" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecordTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GymProFit.Number"
                android:textColor="@color/gp_cristal_oro_fila"
                android:textSize="@dimen/text_title" />

            <TextView
                android:id="@+id/tvRecordAntes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>

    <!-- Rótulos de las columnas, como en la maqueta: pequeños y en el texto secundario. Solo
         para la vista: cada fila se lee entera. Son TextoSinPartir (GP-286): con letra grande
         encogen lo justo para caber en su columna, nunca por debajo de su tamaño a letra 1,0, y
         los cuatro al mismo tamaño (FilaRotulos). -->
    <es.pmdm.gymprofit.ui.widget.FilaRotulos
        android:id="@+id/filaRotulos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingBottom="@dimen/espacio_4">

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvRotuloSerie"
            android:layout_width="@dimen/envivo_col_serie"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/envivo_col_serie"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvRotuloAnterior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:paddingStart="@dimen/espacio_8"
            android:paddingEnd="@dimen/espacio_4"
            android:text="@string/envivo_col_anterior"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvRotuloKg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/envivo_col_kg"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvRotuloReps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/envivo_col_reps"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <Space
            android:layout_width="48dp"
            android:layout_height="1dp" />
    </es.pmdm.gymprofit.ui.widget.FilaRotulos>
</LinearLayout>
