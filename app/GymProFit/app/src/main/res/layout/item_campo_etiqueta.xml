<?xml version="1.0" encoding="utf-8"?>
<!--
  item_campo_etiqueta — una cifra de «Como en la etiqueta» (lote 1.6.2): el punto del macro,
  su nombre (y «opcional» si lo es) y la caja con la cifra y su unidad. El error, debajo, en
  el mismo campo. Con letra grande, el nombre baja de línea; la caja no se encoge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_raya_arriba"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/vPuntoCampo"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_punto_macro"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvNombreCampo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="10dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila" />

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_campo_cifra"
            android:gravity="center_vertical|end"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp">

            <EditText
                android:id="@+id/etCifra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFeatureSettings="tnum"
                android:gravity="end|center_vertical"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:digits="0123456789.,"
                android:maxLength="7"
                android:minHeight="44dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUnidadCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvErrorCampo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="end"
        android:textColor="?attr/colorError"
        android:textSize="@dimen/text_eyebrow"
        android:visibility="gone" />
</LinearLayout>
