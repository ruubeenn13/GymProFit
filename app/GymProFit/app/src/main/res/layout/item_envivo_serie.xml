<?xml version="1.0" encoding="utf-8"?>
<!--
  item_envivo_serie — una serie en la sesión en vivo (GP-012): número, «Anterior»
  (GP-014), kg y reps —o el tiempo y su cronómetro en una serie por tiempo— y el botón
  de marcar. Hecha, la fila se tiñe (y lo dice su estado, no solo el color).
  Se quita deslizándola, y con TalkBack desde sus acciones.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_envivo_medio">

    <LinearLayout
        android:id="@+id/filaSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="1dp"
        android:layout_marginEnd="1dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="11dp"
        android:paddingEnd="7dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvNumero"
            android:layout_width="@dimen/envivo_col_serie"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.GymProFit.Number"
            android:textSize="@dimen/text_fila" />

        <TextView
            android:id="@+id/tvAnterior"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.3"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:importantForAccessibility="no"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/etKg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_envivo_campo"
            android:gravity="center"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:digits="0123456789.,"
            android:inputType="numberDecimal"
            android:maxLength="6"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="@dimen/text_fila"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <EditText
            android:id="@+id/etReps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_envivo_campo"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="3"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="@dimen/text_fila"
            android:textColorHint="?attr/colorOnSurfaceVariant" />

        <!-- Por tiempo: los segundos («40» o «0:40») y el cronómetro. -->
        <EditText
            android:id="@+id/etTiempo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:background="@drawable/bg_envivo_campo"
            android:digits="0123456789:"
            android:gravity="center"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="time"
            android:maxLength="5"
            android:minHeight="48dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="@dimen/text_fila"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnCronometro"
            style="@style/Widget.GymProFit.BotonIcono"
            android:layout_width="0dp"
            android:layout_weight="0.6"
            android:minWidth="48dp"
            android:src="@drawable/ic_ms_timer"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnMarcar"
            style="@style/Widget.GymProFit.BotonIcono"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_ms_radio_button_unchecked"
            app:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
