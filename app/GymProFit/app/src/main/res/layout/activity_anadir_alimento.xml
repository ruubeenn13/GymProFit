<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_anadir_alimento — Añadir y Buscar (tableros 4 y 5, lotes 1.6.1 y 1.6.2).
  Cabecera con cerrar, «Añadir alimento» y la etiqueta de la comida (view_etiqueta_comida),
  que abre la hoja «¿A qué comida?». Si la etiqueta no cabe al lado del título, baja a la
  ranura de debajo (ElegirComida.colocarEtiqueta).
  Debajo, el buscador y el botón naranja del escáner. La lista es la de Añadir
  (Recientes y Habituales) sin escribir, y la de la búsqueda con 2 letras o más.
  Cargando, error con reintentar y vacío, con view_estado.
  Lote 1.6.3: sin texto, las pestañas «Todo» y «Favoritos» (tablero 4; «Mis platos» no se
  dibuja hasta su lote), y abajo la barra de «Hecho» con lo añadido, que sube con el primero.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/filaTituloAnadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnCerrarAnadir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/anadir_cerrar"
            android:src="@drawable/ic_ms_close"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvTituloAnadir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:accessibilityHeading="true"
            android:text="@string/anadir_titulo"
            android:textAppearance="@style/TextAppearance.GymProFit.Headline"
            android:textSize="24sp"
            android:textColor="?attr/colorOnSurface"
            tools:targetApi="28" />

        <FrameLayout
            android:id="@+id/ranuraEtiquetaDerecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <include layout="@layout/view_etiqueta_comida" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/ranuraEtiquetaDebajo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="56dp"
        android:paddingEnd="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscarAnadir"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/anadir_buscar_hint"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="26dp"
            app:boxCornerRadiusTopEnd="26dp"
            app:boxCornerRadiusBottomStart="26dp"
            app:boxCornerRadiusBottomEnd="26dp"
            app:boxStrokeColor="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurface"
            app:startIconDrawable="@drawable/ic_ms_search"
            app:startIconTint="?attr/colorOnSurfaceVariant"
            app:startIconContentDescription="@null"
            app:endIconMode="clear_text"
            app:endIconDrawable="@drawable/ic_ms_close"
            app:endIconContentDescription="@string/buscar_borrar"
            app:errorIconDrawable="@drawable/ic_ms_error">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscarAnadir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="@string/anadir_buscar_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="@dimen/text_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/anadir_escanear"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_ms_barcode_scanner"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pestanasAnadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/anadir_pestanas"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnPestanaTodo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaTodo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/sel_unidad_fondo"
            android:textColor="@color/sel_unidad_texto"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:text="@string/anadir_pestana_todo"
            app:strokeColor="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaFavoritos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/sel_unidad_fondo"
            android:textColor="@color/sel_unidad_texto"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:text="@string/anadir_pestana_favoritos"
            app:icon="@drawable/ic_ms_favorite"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/sel_unidad_texto"
            app:strokeColor="?attr/colorOutline" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAnadir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <include
            android:id="@+id/estadoAnadir"
            layout="@layout/view_estado" />

        <!-- La barra de «Hecho»: lo añadido sin salir de aquí (tablero 4, B3). -->
        <LinearLayout
            android:id="@+id/barraHecho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/textosBarraHecho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvResumenHecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_fila"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvKcalHecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHecho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginStart="12dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/barra_hecho"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold"
                app:cornerRadius="26dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
