<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_anadir_alimento — buscador de alimentos para añadir a una comida.
  Muestra un campo de búsqueda, acceso a crear alimento propio y el listado
  filtrado de resultados.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Toolbar -->
    <!-- Volver, título y acceso a crear alimento nuevo -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/anadir_alimento_titulo">

        <Button
            android:id="@+id/btnCrearAlimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:text="@string/anadir_alimento_crear"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_gravity="end" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Search -->
    <!-- Campo de búsqueda de alimentos -->
    <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:hint="@string/anadir_alimento_buscar_hint"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- RecyclerView -->
    <!-- Resultados de la búsqueda de alimentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlimentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
