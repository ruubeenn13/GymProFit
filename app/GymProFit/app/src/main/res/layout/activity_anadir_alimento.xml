<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_anadir_alimento — buscador de alimentos para añadir a una comida.
  Muestra un campo de búsqueda, acceso a crear alimento propio y el listado
  filtrado de resultados.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Toolbar -->
    <!-- Volver, título y acceso a crear alimento nuevo -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/anadir_alimento_titulo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrearAlimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_caption"
            android:text="@string/anadir_alimento_crear"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_gravity="end" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Para qué comida (GP-105): se ve y se puede cambiar antes de guardar. El atajo
         del «+» llega con la que toca por la hora ya marcada. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:text="@string/anadir_alimento_para"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingEnd="12dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/anadir_alimento_para_a11y"
                app:singleLine="true"
                app:singleSelection="true"
                app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComidaDesayuno"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutricion_desayuno" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComidaAlmuerzo"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutricion_almuerzo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComidaComida"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutricion_comida" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComidaMerienda"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutricion_merienda" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComidaCena"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nutricion_cena" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Search -->
    <!-- Campo de búsqueda de alimentos -->
    <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:hint="@string/anadir_alimento_buscar_hint"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBuscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- RecyclerView -->
    <!-- Resultados de la búsqueda de alimentos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAlimentos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>
