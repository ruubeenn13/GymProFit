<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_anadir_alimento — Añadir y Buscar (tableros 4 y 5, lotes 1.6.1 y 1.6.2).
  Cabecera con cerrar, «Añadir alimento» y la etiqueta de la comida (view_etiqueta_comida),
  que abre la hoja «¿A qué comida?». Si la etiqueta no cabe al lado del título, baja a la
  ranura de debajo (ElegirComida.colocarEtiqueta).
  Debajo, el buscador y el botón naranja del escáner. La lista es la de Añadir
  (Recientes y Habituales) sin escribir, y la de la búsqueda con 2 letras o más.
  Cargando, error con reintentar y vacío, con view_estado.
  Lote 1.6.3: sin texto, las pestañas «Todo» y «Favoritos» (tablero 4), y abajo la barra de
  «Hecho» con lo añadido, que sube con el primero. Lote 1.6.6: la tercera pestaña, «Mis
  platos» (tablero 9); al elegir ingredientes de un plato no hay etiqueta ni esa pestaña.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- La cabecera (tablero 25): atrás y «Añadir a la merienda ⌄»; tocar el título cambia de comida. -->
    <LinearLayout
        android:id="@+id/filaTituloAnadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnCerrarAnadir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ficha_atras"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvTituloAnadir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_ms_keyboard_arrow_down"
            android:drawableTint="?attr/colorOnSurfaceVariant"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:accessibilityHeading="true"
            android:text="@string/anadir_titulo"
            android:textAppearance="@style/TextAppearance.GymProFit.Headline"
            android:textSize="@dimen/text_display"
            android:textColor="?attr/colorOnSurface"
            tools:targetApi="28" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBuscarAnadir"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/anadir_buscar_hint"
            app:hintEnabled="false"
            app:boxCornerRadiusTopStart="26dp"
            app:boxCornerRadiusTopEnd="26dp"
            app:boxCornerRadiusBottomStart="26dp"
            app:boxCornerRadiusBottomEnd="26dp"
            app:boxStrokeColor="?attr/colorPrimary"
            app:boxBackgroundColor="?attr/colorSurface"
            app:startIconDrawable="@drawable/ic_ms_search"
            app:startIconTint="?attr/colorOnSurfaceVariant"
            app:startIconContentDescription="@null"
            app:endIconMode="clear_text"
            app:endIconDrawable="@drawable/ic_ms_close"
            app:endIconContentDescription="@string/buscar_borrar"
            app:errorIconDrawable="@drawable/ic_ms_error">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBuscarAnadir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="@string/anadir_buscar_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="@dimen/text_subtitle" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEscanear"
            style="@style/Widget.Material3.Button.Icon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:contentDescription="@string/anadir_escanear"
            app:icon="@drawable/ic_ms_barcode_scanner"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/pestanasAnadir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/anadir_pestanas"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@+id/btnPestanaTodo">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaTodo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/sel_unidad_fondo"
            android:textColor="@color/sel_unidad_texto"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:text="@string/anadir_pestana_todo"
            app:strokeColor="?attr/colorOutline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaFavoritos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:backgroundTint="@color/sel_unidad_fondo"
            android:textColor="@color/sel_unidad_texto"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:text="@string/anadir_pestana_favoritos"
            app:icon="@drawable/ic_ms_favorite"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconTint="@color/sel_unidad_texto"
            app:strokeColor="?attr/colorOutline" />

        <!-- Lote 1.6.6: «Mis platos» (tablero 9). No sale al elegir ingredientes. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPestanaPlatos"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:backgroundTint="@color/sel_unidad_fondo"
            android:textColor="@color/sel_unidad_texto"
            android:textStyle="bold"
            android:textSize="@dimen/text_body"
            android:text="@string/anadir_pestana_platos"
            app:icon="@drawable/ic_ms_menu_book"
            app:iconGravity="textStart"
            app:iconSize="18dp"
            app:iconPadding="6dp"
            app:iconTint="@color/sel_unidad_texto"
            app:strokeColor="?attr/colorOutline" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAnadir"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <include
            android:id="@+id/estadoAnadir"
            layout="@layout/view_estado" />

        <!-- La barra de «Hecho»: lo añadido sin salir de aquí (tablero 4, B3). -->
        <LinearLayout
            android:id="@+id/barraHecho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:elevation="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/textosBarraHecho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvResumenHecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_fila"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/tvKcalHecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_barra_redonda"
                    android:backgroundTint="@color/gp_meter_track"
                    android:importantForAccessibility="no">

                    <View
                        android:id="@+id/progresoProteinaHecho"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_barra_redonda"
                        android:backgroundTint="@color/gp_macro_proteinas"
                        android:scaleX="0" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFaltaHecho"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <es.pmdm.gymprofit.ui.widget.BotonExpresivo
                android:id="@+id/btnHecho"
                style="@style/Widget.GymProFit.Button.Expresivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginStart="12dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/barra_hecho"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
