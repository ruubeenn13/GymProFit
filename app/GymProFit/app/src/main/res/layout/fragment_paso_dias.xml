<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_paso_dias — «Días y tiempo» (GP-103, tablero 7 del lienzo): cuántos días por
  semana, con la semana de ejemplo, y cuánto tiempo por sesión. «Ver mi plan» se enciende
  con los dos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/cabeceraPaso"
                layout="@layout/view_cabecera_paso" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/tvEtiquetaDias"
                    style="@style/Widget.GymProFit.Alta.Etiqueta"
                    android:text="@string/alta_dias_etiqueta" />

                <es.pmdm.gymprofit.ui.alta.SelectorPildora
                    android:id="@+id/selectorDias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:id="@+id/filaEjemplo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="@string/alta_por_ejemplo"
                        android:textSize="@dimen/text_caption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:importantForAccessibility="no" />

                    <es.pmdm.gymprofit.ui.alta.SemanaEjemplo
                        android:id="@+id/semanaEjemplo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEtiquetaTiempo"
                    style="@style/Widget.GymProFit.Alta.Etiqueta"
                    android:layout_marginTop="24dp"
                    android:text="@string/alta_tiempo_etiqueta" />

                <es.pmdm.gymprofit.ui.alta.SelectorPildora
                    android:id="@+id/selectorMinutos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguientePaso"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:enabled="false"
            android:text="@string/alta_ver_mi_plan" />
    </FrameLayout>
</LinearLayout>
