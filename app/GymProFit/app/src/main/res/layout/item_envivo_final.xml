<?xml version="1.0" encoding="utf-8"?>
<!--
  item_envivo_final — final de la lista de la sesión en vivo (GP-012): el estado de la
  carga (cargando, error con reintentar o sin ejercicios), «Añadir ejercicio» y
  «Descartar la sesión». Tras el primer intento de guardar, los botones no salen.
  En Liquid Glass (GP-285, lote 2) va sobre el fondo ambiental, sin tarjeta: los botones son
  secundarios, de cristal (DEC-070), y «Descartar» lleva el rojo medido sobre ese fondo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/envivo_margen"
    android:paddingEnd="@dimen/envivo_margen"
    android:paddingTop="16dp">

    <LinearLayout
        android:id="@+id/grupoEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progresoCarga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:indeterminate="true"
            android:importantForAccessibility="no"
            app:indicatorColor="?attr/gpGraficoMarca" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <es.pmdm.gymprofit.ui.widget.BotonCristal
            android:id="@+id/btnReintentarCarga"
            style="@style/Widget.GymProFit.Boton.Cristal"
            android:layout_width="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_reintentar" />
    </LinearLayout>

    <es.pmdm.gymprofit.ui.widget.BotonCristal
        android:id="@+id/btnAnadirEjercicio"
        style="@style/Widget.GymProFit.Boton.Cristal"
        android:layout_width="match_parent"
        android:text="@string/envivo_anadir_ejercicio"
        app:icon="@drawable/ic_ms_add" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDescartar"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/envivo_descartar"
        android:textColor="@color/gp_cristal_error"
        android:textSize="@dimen/text_fila"
        app:rippleColor="@color/tarjeta_capa" />
</LinearLayout>
