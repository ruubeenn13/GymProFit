<?xml version="1.0" encoding="utf-8"?>
<!--
  view_barra_sesion — la sesión en curso, sobre la navegación de las pestañas (GP-012):
  «Sesión en curso · Pierna B · 23:14 · Volver». Tocarla abre la sesión. Si se intentó
  guardar y no se pudo: «Sin guardar · Pierna B» con «Reintentar».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/barraSesion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorPrimaryContainer"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/ivBarraSesion"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ms_timer"
        app:tint="?attr/colorOnPrimaryContainer" />

    <TextView
        android:id="@+id/tvBarraSesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBarraSesion"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:importantForAccessibility="no"
        android:text="@string/envivo_volver"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="@dimen/text_fila" />
</LinearLayout>
