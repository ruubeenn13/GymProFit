<?xml version="1.0" encoding="utf-8"?>
<!--
  view_macro_barra — una macro en la tarjeta de Nutrición (GP-105). Desde la 1.6.8 (tablero 1):
  el punto de su color y el nombre a la izquierda, «82 / 136 g» a la derecha, la barra de su
  color (10 dp la proteína, 8 las otras, desde el código) y, solo en la proteína, «Te faltan
  54 g». Con el día completo y la proteína hecha, el trofeo y el dorado (tablero 3).
  Para TalkBack, la fila entera es una imagen con su descripción.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/ivMacroIcono"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            android:src="@drawable/ic_ms_trophy_fill" />

        <View
            android:id="@+id/vMacroPunto"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_punto_dia" />

        <TextView
            android:id="@+id/tvMacroNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvMacroValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraMacro"
        style="@style/Widget.GymProFit.BarraProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp" />

    <!-- Solo en la proteína (GP-206): el objetivo con su mínimo eficaz y sobre qué se calculó. -->
    <TextView
        android:id="@+id/tvMacroBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:lineSpacingMultiplier="1.15"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/tvMacroFalta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:importantForAccessibility="no"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:textColor="@color/gp_macro_proteinas" />
</LinearLayout>
