<?xml version="1.0" encoding="utf-8"?>
<!--
  view_macro_barra — una macro en la tarjeta de Nutrición (GP-105): nombre a la
  izquierda, «86 / 149 g» a la derecha y una barra de 6 dp de su color.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/tvMacroNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvMacroValor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraMacro"
        style="@style/Widget.GymProFit.BarraProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp" />
</LinearLayout>
