<?xml version="1.0" encoding="utf-8"?>
<!-- item_macro_comida — un macro en el resumen de una comida (tablero 28): los gramos en grande y,
     debajo, el punto de su color y el nombre. ComidaActivity lo rellena. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvGramosMacro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textAppearance="@style/TextAppearance.GymProFit.Hero.Titulo"
        android:textSize="@dimen/text_display" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/vPuntoMacro"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_punto_macro"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvNombreMacro"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.GymProFit.Hero.Apoyo"
            android:textSize="@dimen/text_label" />
    </LinearLayout>
</LinearLayout>
