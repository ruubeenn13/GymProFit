<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_logros.xml — Pantalla de logros/insignias conseguidos por el usuario.
  Muestra un listado en RecyclerView o un mensaje de estado vacío si no hay logros.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Cabecera -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/logros_titulo" />

    <!-- Mensaje de estado vacío (sin logros) -->
    <TextView
        android:id="@+id/tvVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/logros_sin_logros"
        android:textSize="@dimen/text_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Listado de logros conseguidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLogros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>
