<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ultimo_entreno — un entreno del carrusel «Tus últimos entrenos» de Inicio (GP-216,
  tablero 13): cuándo, la rutina, los kilos y los minutos, y una línea de color con lo que
  tuvo (récords en dorado, subida en verde, lo demás en neutro). La rellena InicioEntrenos.
  Pulsable: abre el resumen de esa sesión y la tarjeta crece hasta él.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.GymProFit.Card.Pequena"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_16">

        <TextView
            android:id="@+id/tvEntrenoCuando"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <TextView
            android:id="@+id/tvEntrenoRutina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvEntrenoKilos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvEntrenoMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_12"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEntrenoExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
