<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_avisos — «¿Te avisamos?» del alta (GP-103 y GP-112, tablero 12 del lienzo).
  Arriba, una notificación de ejemplo que baja como una de verdad (momento 11); debajo,
  qué se manda y los tres interruptores, antes de pedir el permiso de Android. «Activar
  avisos» lo pide; «Ahora no», no.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- La notificación de ejemplo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisoEjemplo"
                style="@style/Widget.GymProFit.Card.Estructura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="28dp"
                android:focusable="true"
                android:contentDescription="@string/avisos_ejemplo_a11y"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:importantForAccessibility="noHideDescendants">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/iconoAvisoEjemplo"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circulo_primario">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_ms_fitness_center_fill"
                                app:tint="?attr/colorOnPrimary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/avisos_ejemplo_origen"
                            android:textSize="@dimen/text_eyebrow"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/avisos_ejemplo_titulo"
                        android:textSize="@dimen/text_fila"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/avisos_ejemplo_texto"
                        android:textSize="@dimen/text_body"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvTituloAvisos"
                style="@style/Widget.GymProFit.Alta.Titulo"
                android:layout_marginTop="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/avisos_titulo"
                android:textSize="38sp" />

            <TextView
                android:id="@+id/tvTextoAvisos"
                style="@style/Widget.GymProFit.Alta.Texto"
                android:layout_marginTop="8dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/avisos_texto" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTiposAviso"
                style="@style/Widget.GymProFit.Card.Estructura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/avisos_tipos_a11y">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/div_grupo_ajustes"
                    android:showDividers="middle">

                    <include android:id="@+id/filaAvisoDescanso" layout="@layout/view_fila_aviso" />
                    <include android:id="@+id/filaAvisoEntrenar" layout="@layout/view_fila_aviso" />
                    <include android:id="@+id/filaAvisoComidas" layout="@layout/view_fila_aviso" />
                    <include android:id="@+id/filaAvisoProgreso" layout="@layout/view_fila_aviso" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActivarAvisos"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:text="@string/avisos_activar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAhoraNo"
            style="@style/Widget.GymProFit.Alta.BotonTexto"
            android:layout_marginTop="4dp"
            android:text="@string/avisos_ahora_no" />
    </LinearLayout>
</LinearLayout>
