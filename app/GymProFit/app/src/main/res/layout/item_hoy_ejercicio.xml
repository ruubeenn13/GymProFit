<?xml version="1.0" encoding="utf-8"?>
<!--
  item_hoy_ejercicio — un ejercicio del carrusel de «Hoy toca» (GP-216, tablero 13): el icono
  de su zona (provisional, hasta tener ilustraciones), su nombre y su pauta. No es pulsable:
  se pulsa la tarjeta entera, que abre la rutina. Va dentro de la tarjeta héroe de cristal
  (GP-285): el bloque del icono es un tile de cristal y sus colores salen del tema de Inicio
  (ThemeOverlay.GymProFit.Cristal).
  Nombre y pauta son TextoSinPartir (GP-288): con letra grande encogen antes que partir una
  palabra, nunca por debajo de su tamaño a letra 1,0, y todas las tarjetas del carrusel van al
  mismo tamaño (InicioHoyDetalle.igualarTextos). El nombre llega a cinco líneas; si aun así no
  cabe, acaba en «…» tras una palabra entera.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Su alto cede hasta hoy_ejercicio_icono_cede si «Empezar» queda pegado a la barra (EncajeHeroe). -->
    <FrameLayout
        android:id="@+id/bloqueIconoEjercicio"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hoy_ejercicio_icono_alto"
        android:background="@drawable/bg_cristal_tile"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/ivIconoEjercicio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/gpGraficoMarca" />
    </FrameLayout>

    <es.pmdm.gymprofit.ui.widget.TextoSinPartir
        android:id="@+id/tvNombreEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_8"
        android:maxLines="5"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <es.pmdm.gymprofit.ui.widget.TextoSinPartir
        android:id="@+id/tvMetaEjercicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_4"
        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
