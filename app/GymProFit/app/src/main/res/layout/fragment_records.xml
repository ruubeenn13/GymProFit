<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_records — sección Récords de Progreso (GP-105; antes RecordsActivity, GP-088).
  El récord vigente de cada ejercicio, agrupado por zona. Además de la lista:
  cargando, vacío (todavía no ha superado ninguna marca) y error con reintentar, en view_estado.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Cargando, vacío (la primera vez que se hace un ejercicio es el punto de partida) y
             error con «Reintentar»: view_estado, centrado en la sección (GP-064) -->
        <include
            android:id="@+id/estadoRecords"
            layout="@layout/view_estado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/margen_pantalla"
            android:layout_marginEnd="@dimen/margen_pantalla" />

    </FrameLayout>

</LinearLayout>
