<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_records — sección Récords de Progreso (GP-105; antes RecordsActivity, GP-088).
  El récord vigente de cada ejercicio, agrupado por zona. Además de la lista:
  cargando, vacío (todavía no ha superado ninguna marca) y error con reintentar.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Cargando: en la sección, sin tapar la pantalla entera -->
        <ProgressBar
            android:id="@+id/cargandoRecords"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Vacío: la primera vez que se hace un ejercicio es el punto de partida -->
        <LinearLayout
            android:id="@+id/layoutVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_ms_trending_up"
                app:tint="?attr/colorOnSurfaceVariant"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:id="@+id/tvVacioTitulo"
                android:text="@string/records_vacio_titulo"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/records_vacio_texto"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Error: se dice y se ofrece reintentar -->
        <LinearLayout
            android:id="@+id/layoutError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_ms_error"
                app:tint="?attr/colorOnSurfaceVariant"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sesiones_error_reintentar" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
