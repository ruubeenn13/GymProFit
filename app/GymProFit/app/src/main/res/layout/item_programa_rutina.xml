<?xml version="1.0" encoding="utf-8"?>
<!--
  item_programa_rutina — una rutina en el detalle de un programa (GP-216, tablero 31), plegable:
  el número, el nombre con sus ejercicios y minutos, y una flecha. Abierta, dice con qué ejercicios
  se trabaja. Solo una abierta cada vez; lo gestiona ProgramaDetalleActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cabeceraRutina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fila_padding_horizontal"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/fila_padding_horizontal"
        android:paddingBottom="@dimen/espacio_12">

        <TextView
            android:id="@+id/tvRutinaNumero"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circulo_superficie"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.GymProFit.Number"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fila_icono_a_texto"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRutinaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_fila"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRutinaResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_eyebrow" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivDesplegar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurfaceVariant"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRutinaEjercicios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.15"
        android:paddingStart="66dp"
        android:paddingEnd="@dimen/fila_padding_horizontal"
        android:paddingBottom="@dimen/espacio_16"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <View
        android:id="@+id/rayaRutina"
        android:layout_width="match_parent"
        android:layout_height="@dimen/separador_alto"
        android:layout_marginStart="@dimen/fila_sangria_separador"
        android:background="?attr/colorSurfaceVariant"
        android:importantForAccessibility="no" />
</LinearLayout>
