<?xml version="1.0" encoding="utf-8"?>
<!--
  item_encaja — una tarjeta del carrusel de «Lo que te encaja» en Añadir (lote 1.6.7; desde
  GP-216, lote 3, en carrusel como el tablero 25). Arriba, el icono del alimento y su «+» de
  48 dp, que añade y se vuelve ✓ (momento 15); debajo, el nombre (con la marca «Plato» si lo
  es) y lo que añade el «+»: cantidad, kcal y proteína. Abajo del todo, la barra de lo que
  cubre de la proteína que falta, con su texto (sin proteína pendiente no sale). Mide 220 dp
  de ancho y la altura la pone el carrusel: todas como la más alta, con la barra al pie.
  Tocar la tarjeta abre la ficha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaEncaja"
    android:layout_width="@dimen/tarjeta_carrusel"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tarjeta_filas"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/espacio_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivIconoEncaja"
            style="@style/Widget.GymProFit.Fila.Icono"
            android:src="@drawable/ic_ms_restaurant" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- El «+» (o el ✓), igual que en item_alimento_busqueda. -->
        <FrameLayout
            android:id="@+id/btnMasEncaja"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_mas_fila"
            android:backgroundTint="@color/gp_surface_2"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivMasEncaja"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_add"
                app:tint="?attr/colorOnSurface" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_12"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreEncaja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalleEncaja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Empuja la barra al pie: las tarjetas miden lo que la más alta. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Lo que cubre de la proteína que falta: una imagen para TalkBack, con su texto debajo. -->
    <LinearLayout
        android:id="@+id/barraEncaja"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_12"
        android:focusable="true"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/pistaEncaja"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@drawable/bg_barra_redonda"
            android:backgroundTint="@color/gp_meter_track"
            android:importantForAccessibility="no">

            <View
                android:id="@+id/rellenoEncaja"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_barra_redonda"
                android:backgroundTint="@color/gp_macro_proteinas" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCubreEncaja"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
