<?xml version="1.0" encoding="utf-8"?>
<!--
  view_biblioteca_cabecera — lo que va encima de la lista de la Biblioteca (GP-216, tablero 29):
  «Los que más haces» (oculto si no hay nada que enseñar) y el rótulo de la lista con cuántos hay.
  Es la primera pieza del RecyclerView, así se desplaza con él.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_24">

    <LinearLayout
        android:id="@+id/bloqueMasHaces"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/espacio_28"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen_pantalla"
            android:layout_marginEnd="@dimen/margen_pantalla"
            android:accessibilityHeading="true"
            android:text="@string/biblioteca_mas_haces"
            android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_12"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/listaMasHaces"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:layout_marginBottom="@dimen/espacio_12"
        android:gravity="center_vertical|bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTituloLista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/biblioteca_lista"
            android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

        <TextView
            android:id="@+id/tvCuantos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>
