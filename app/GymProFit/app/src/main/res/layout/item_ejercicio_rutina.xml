<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ejercicio_rutina — un ejercicio en el detalle de la rutina (GP-216, tablero 32): el número,
  la foto, el nombre, la pauta con el descanso y tu última marca (dorada si fue récord). Toda la
  fila abre la ficha del ejercicio; TalkBack la lee de una vez.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/fila_padding_horizontal"
    android:paddingTop="@dimen/espacio_12"
    android:paddingEnd="@dimen/fila_padding_horizontal"
    android:paddingBottom="@dimen/espacio_12"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvNumeroEjercicio"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.GymProFit.Number"
        android:textColor="?attr/colorOutline"
        android:textSize="@dimen/text_fila" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.GymProFit.Card"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="@dimen/espacio_4"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/radio_miniatura"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivIconoEjercicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_body_full" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_12"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPautaEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_eyebrow" />

        <TextView
            android:id="@+id/tvUltimaMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_eyebrow" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/espacio_8"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ms_chevron_right"
        app:tint="?attr/colorOutline" />
</LinearLayout>
