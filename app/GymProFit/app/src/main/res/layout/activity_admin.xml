<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_admin — Panel de administración.
  Muestra estadísticas globales de la app (usuarios, sesiones, rutinas, ejercicios) y accesos a las secciones de gestión (usuarios, rutinas, ejercicios, alimentos).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Cabecera -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/admin_titulo">

        <ImageButton
            android:id="@+id/btnMenuOpciones"
            style="@style/Widget.GymProFit.BotonIcono"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_ms_more_vert"
            android:contentDescription="@string/menu_opciones" />

    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Estadísticas -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_estadisticas"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:layout_marginBottom="12dp" />

            <!-- Fila 1: total usuarios + activos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="22dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTotalUsuarios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_total_usuarios"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="@color/gp_on_primary_secondary" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvUsuariosActivos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_usuarios_activos"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Fila 2: sesiones + sesiones hoy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvTotalSesiones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_total_sesiones"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvSesionesHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_sesiones_hoy"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Fila 3: rutinas predefinidas + ejercicios activos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvRutinasPredefinidas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_rutinas_predefinidas"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvEjerciciosActivos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:fontFamily="@font/barlow_condensed"
                            android:textFontWeight="700"
                            android:includeFontPadding="false"
                            android:textSize="@dimen/text_display_large"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admin_ejercicios_activos"
                            android:textSize="@dimen/text_label"
                            android:textAllCaps="true"
                            android:letterSpacing="0.12"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Secciones de gestión -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_secciones"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:layout_marginBottom="12dp" />

            <!-- Card usuarios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarUsuarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ms_person"
                        android:alpha="0.7"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/admin_gestionar_usuarios"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        android:alpha="0.4"
                        android:contentDescription="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card rutinas -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarRutinas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ms_assignment"
                        android:alpha="0.7"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/admin_gestionar_rutinas"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        android:alpha="0.4"
                        android:contentDescription="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card ejercicios -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ms_fitness_center"
                        android:alpha="0.7"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/admin_gestionar_ejercicios"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        android:alpha="0.4"
                        android:contentDescription="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card alimentos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGestionarAlimentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_ms_restaurant"
                        android:alpha="0.7"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:text="@string/admin_gestionar_alimentos"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        android:alpha="0.4"
                        android:contentDescription="@null" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
