<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_cronometro — el cronómetro de una serie por tiempo (GP-012): cuenta hacia
  arriba con la pauta a la vista; «Parar y apuntar» guarda los segundos y marca la
  serie, «Cancelar» lo para sin apuntar. Mientras está abierta, la pantalla no se apaga.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/tvCronoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.GymProFit.Display"
        android:textSize="@dimen/text_subtitle" />

    <TextView
        android:id="@+id/tvCronoTiempo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.GymProFit.Number"
        android:textSize="@dimen/text_number_hero" />

    <TextView
        android:id="@+id/tvCronoPauta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/text_body"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/barraCrono"
        style="@style/Widget.GymProFit.BarraProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnParar"
        style="@style/Widget.GymProFit.BotonPildora"
        android:layout_width="match_parent"
        android:layout_marginTop="20dp"
        android:text="@string/envivo_crono_parar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelarCrono"
        style="@style/Widget.GymProFit.BotonPildora.Contorno"
        android:layout_width="match_parent"
        android:layout_marginTop="8dp"
        android:text="@string/dialog_cancelar" />
</LinearLayout>
