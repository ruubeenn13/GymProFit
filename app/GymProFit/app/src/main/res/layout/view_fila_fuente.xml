<?xml version="1.0" encoding="utf-8"?>
<!--
  view_fila_fuente — una fuente de datos en Licencias de terceros (GP-153): su nombre con
  la licencia, qué trae a la app y el enlace al proyecto, que se abre en el navegador.
  Los textos los pone LicenciasActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvFuenteNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvFuenteUso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:lineSpacingMultiplier="1.25" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_ms_open_in_new"
        android:alpha="0.7"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />
</LinearLayout>
