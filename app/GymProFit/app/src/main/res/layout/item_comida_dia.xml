<?xml version="1.0" encoding="utf-8"?>
<!--
  item_comida_dia — una de las cinco comidas en Nutrición (GP-105): nombre, resumen
  («3 alimentos · 820 kcal» o «Sin registrar») y un «+» de 48 dp que abre añadir
  alimento. Tocar la tarjeta abre la comida. El «+» de la comida que toca por la hora
  va en naranja si está sin registrar.
  Desde la 1.6.8, el icono de la comida delante, y «Hoy no» en el resumen si se marcó.
  Desde GP-216 (tablero 15), las kcal a la derecha si está apuntada y el «+» si está pendiente;
  «Copiar ayer» vive en la cabecera «Comidas».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="68dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- El icono de la comida (lote 1.6.8, tablero 1): dibujo, lo dice el nombre. -->
        <FrameLayout
            android:id="@+id/circuloComida"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circulo_superficie"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/ivComidaIcono"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvComidaNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_fila"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvComidaResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Con la comida apuntada, sus kcal; con «+» si está pendiente (tablero 15). -->
        <TextView
            android:id="@+id/tvComidaKcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:fontFeatureSettings="tnum"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnAnadirComida"
            style="@style/Widget.GymProFit.BotonRedondo"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_ms_add" />
    </LinearLayout>

    </LinearLayout>
</LinearLayout>
