<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_editar_perfil.xml — Pantalla de edición del perfil del usuario.
  Formulario con nombre para mostrar (GP-116), peso, altura, edad, sexo, actividad, nivel y objetivo, con botón de
  guardado. Se abre desde Ajustes › Tus datos y objetivos (GP-105).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Cabecera -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/editar_perfil_titulo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Nombre para mostrar (GP-116): opcional; en blanco se usa el de usuario.
                 40 como la columna de la API; el contador avisa antes de llegar. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/perfil_nombre"
                app:helperText="@string/editar_perfil_nombre_ayuda"
                app:counterEnabled="true"
                app:counterMaxLength="40"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:maxLines="1" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- El correo ya no está aquí: se cambia en Ajustes › Correo (GP-105). -->
            <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/perfil_peso"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:digits="0123456789.," />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Altura -->
            <com.google.android.material.textfield.TextInputLayout
        app:errorIconDrawable="@drawable/ic_ms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/perfil_altura"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAltura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Edad: de 14 a 100 (GP-145); por debajo de 14 se explica el mínimo. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEdad"
                app:errorIconDrawable="@drawable/ic_ms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:hint="@string/perfil_edad"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sexo y actividad (GP-105): antes solo se elegían en el onboarding;
                 se guardan donde entonces y recalculan como entonces. -->
            <TextView
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/onboarding_sexo"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <Spinner
                    android:id="@+id/spSexo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/onboarding_actividad_label"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <Spinner
                    android:id="@+id/spActividad"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Qué cuenta cada nivel de actividad (GP-103): el factor de la fórmula ya
                 incluye el ejercicio, y sin decirlo cada uno entendía una cosa. -->
            <TextView
                android:id="@+id/tvActividadDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Selector de nivel de experiencia -->
            <!-- Nivel de experiencia -->
            <TextView
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/perfil_nivel"
                android:textSize="@dimen/text_label"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <Spinner
                    android:id="@+id/spNivel"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Selector de objetivo fitness -->
            <!-- Objetivo fitness -->
            <TextView
                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/perfil_objetivo"
                android:textSize="@dimen/text_label"
                android:textAllCaps="true"
                android:letterSpacing="0.12"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutline">

                <Spinner
                    android:id="@+id/spObjetivo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

            </com.google.android.material.card.MaterialCardView>

            <!-- De 14 a 17 años, «Perder grasa» se queda en mantenimiento (GP-103): se dice. -->
            <TextView
                android:id="@+id/tvNotaObjetivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/editar_perfil_nota_menores"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <!-- Botón de guardado de cambios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/editar_perfil_guardar"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
