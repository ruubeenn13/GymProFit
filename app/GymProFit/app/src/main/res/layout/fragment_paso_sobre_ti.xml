<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_paso_sobre_ti — «Sobre ti», en una pantalla (GP-103): sexo, edad, altura, peso
  y actividad, cada uno con su hoja. «Siguiente» se enciende con los cinco; «Prefiero no
  decirlo» sigue sin ellos y el plan sale sin calorías (decisión 4 del lienzo).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/cabeceraPaso"
                layout="@layout/view_cabecera_paso" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDatos"
                style="@style/Widget.GymProFit.Card.Estructura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:id="@+id/grupoDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:divider="@drawable/div_grupo_ajustes"
                    android:showDividers="middle">

                    <include android:id="@+id/filaSexo" layout="@layout/view_fila_sobre_ti" />
                    <include android:id="@+id/filaEdad" layout="@layout/view_fila_sobre_ti" />
                    <include android:id="@+id/filaAltura" layout="@layout/view_fila_sobre_ti" />
                    <include android:id="@+id/filaPeso" layout="@layout/view_fila_sobre_ti" />
                    <include android:id="@+id/filaActividad" layout="@layout/view_fila_sobre_ti" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguientePaso"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:enabled="false"
            android:text="@string/onboarding_siguiente" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrefieroNoDecirlo"
            style="@style/Widget.GymProFit.Alta.BotonTexto"
            android:layout_marginTop="4dp"
            android:text="@string/alta_prefiero_no_decirlo" />
    </LinearLayout>
</LinearLayout>
