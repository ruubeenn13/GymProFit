<?xml version="1.0" encoding="utf-8"?>
<!--
  view_demo_bienvenida — la demostración de la bienvenida (GP-103, tablero 1 del lienzo):
  se apunta la tercera serie de press de banca, empieza el descanso y, al guardar la
  sesión, sale un récord nuevo. La mueve DemoBienvenida en un bucle de 8 s. Para TalkBack
  es una imagen con su descripción entera.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- La serie que se apunta -->
    <LinearLayout
        android:id="@+id/demoSerie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_demo_tarjeta"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_ejercicio"
                android:textSize="@dimen/text_subtitle"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_demo_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/demo_basico"
                android:textSize="@dimen/text_eyebrow"
                android:textStyle="bold"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/demo_pauta"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <TextView style="@style/Widget.GymProFit.Demo.Columna" android:layout_width="38dp" android:text="@string/demo_col_serie" />
            <TextView style="@style/Widget.GymProFit.Demo.Columna" android:layout_width="0dp" android:layout_weight="1.25" android:text="@string/demo_col_anterior" />
            <TextView style="@style/Widget.GymProFit.Demo.Columna" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_col_kg" />
            <TextView style="@style/Widget.GymProFit.Demo.Columna" android:layout_width="0dp" android:layout_weight="1" android:text="@string/demo_col_reps" />
            <Space android:layout_width="44dp" android:layout_height="1dp" />
        </LinearLayout>

        <include android:id="@+id/demoFila1" layout="@layout/view_demo_fila" />
        <include android:id="@+id/demoFila2" layout="@layout/view_demo_fila"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <include android:id="@+id/demoFila3" layout="@layout/view_demo_fila"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

        <!-- El descanso -->
        <LinearLayout
            android:id="@+id/demoDescanso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_demo_descanso"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_ms_timer"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/demo_descanso"
                    android:textAppearance="@style/TextAppearance.GymProFit.Label"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textSize="@dimen/text_eyebrow"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_descanso_tiempo"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display"
                    android:textSize="20sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_demo_pista">

                <View
                    android:id="@+id/demoBarraDescanso"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_demo_barra" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- El resumen con el récord -->
    <LinearLayout
        android:id="@+id/demoResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_demo_tarjeta"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_ms_check_circle_fill"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_sesion_guardada"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_rutina"
                    android:textSize="@dimen/text_caption"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.GymProFit.Seccion"
            android:layout_marginTop="12dp"
            android:accessibilityHeading="false"
            android:text="@string/demo_records"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/demoRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_demo_record"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/demoTrofeo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_demo_trofeo">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_ms_trophy_fill"
                    app:tint="@color/gp_gold_container" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_ejercicio"
                    android:textSize="@dimen/text_fila"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/demo_record_marca"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/gp_gold_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
