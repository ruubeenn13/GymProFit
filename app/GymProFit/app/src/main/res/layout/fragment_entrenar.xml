<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_entrenar — pestaña Entrenar (GP-105, rehecha en GP-216, tablero 14). Arriba el título con
  el buscador de ejercicios y el avatar; «Tu programa» (en view_tu_programa: su tarjeta, el bloque de
  hoy y sus rutinas); «Mis rutinas» (las propias, que no están en el tablero pero se conservan);
  «Por tu cuenta» (entreno libre y crear una rutina) y «Más programas» en un carrusel.
  La biblioteca de ejercicios se abre con el buscador de arriba; sus zonas, con los chips de dentro.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/espacio_24">

        <LinearLayout style="@style/Widget.GymProFit.CabeceraPestana">

            <TextView
                style="@style/Widget.GymProFit.TituloPestana"
                android:text="@string/entrenar_titulo" />

            <ImageButton
                android:id="@+id/btnBuscarEjercicios"
                style="@style/Widget.GymProFit.BotonRedondo"
                android:contentDescription="@string/entrenar_buscar_a11y"
                android:src="@drawable/ic_ms_search" />

            <include
                android:id="@+id/avatarCabecera"
                layout="@layout/view_avatar"
                android:layout_width="@dimen/avatar_cabecera"
                android:layout_height="@dimen/avatar_cabecera"
                android:layout_marginStart="@dimen/espacio_8" />
        </LinearLayout>

        <include
            android:id="@+id/tuPrograma"
            layout="@layout/view_tu_programa" />

        <!-- Mis rutinas: las propias -->
        <LinearLayout
            android:id="@+id/bloqueMisRutinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_36"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:accessibilityHeading="true"
                android:text="@string/mis_rutinas"
                android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMisRutinas"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_12"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/listaMisRutinas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/espacio_4"
                    android:paddingBottom="@dimen/espacio_4" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Sin rutinas propias -->
            <LinearLayout
                android:id="@+id/layoutRutinasVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_12"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvRutinasVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mis_rutinas_vacio"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearPrimera"
                    style="@style/Widget.GymProFit.BotonPildora"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:text="@string/btn_crea_primera_rutina"
                    app:icon="@drawable/ic_ms_add" />
            </LinearLayout>
        </LinearLayout>

        <!-- Por tu cuenta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen_pantalla"
            android:layout_marginTop="@dimen/espacio_36"
            android:layout_marginEnd="@dimen/margen_pantalla"
            android:accessibilityHeading="true"
            android:text="@string/entrenar_por_tu_cuenta"
            android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margen_pantalla"
            android:layout_marginTop="@dimen/espacio_12"
            android:layout_marginEnd="@dimen/margen_pantalla"
            android:orientation="horizontal">

            <!-- Entreno libre -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSinRutina"
                style="@style/Widget.GymProFit.Card.Pequena"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/btn_empezar_sin_rutina"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ms_bolt_fill"
                        app:tint="?attr/colorPrimary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:importantForAccessibility="no"
                        android:text="@string/entrenar_entreno_libre"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_fila"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/entrenar_entreno_libre_sub"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_eyebrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Crear una rutina -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCrearRutina"
                style="@style/Widget.GymProFit.Card.Pequena"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_12"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/entrenar_crear_rutina_a11y"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="104dp"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_16">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ms_add"
                        app:tint="?attr/colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:importantForAccessibility="no"
                        android:text="@string/entrenar_crear_rutina"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_fila"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/entrenar_crear_rutina_sub"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_eyebrow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Más programas -->
        <LinearLayout
            android:id="@+id/bloqueMasProgramas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_36"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                style="@style/Widget.GymProFit.CabeceraSeccion"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla">

                <TextView
                    style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                    android:text="@string/entrenar_mas_programas" />

                <TextView
                    android:id="@+id/btnVerTodosProgramas"
                    style="@style/Widget.GymProFit.CabeceraSeccion.Enlace"
                    android:text="@string/entrenar_ver_todos" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_12"
                android:clipToPadding="false"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/listaMasProgramas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
