<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_comida — una comida (decisión 16, tableros 2 y 2b, lote 1.6.2).
  Cabecera con atrás, el nombre de la comida y el día. El resumen: el anillo con las kcal
  dentro y el reparto, los gramos de cada macro y qué parte son de lo del día, y la comida
  frente a las kcal del día con su barra. Debajo, «N alimentos» y las filas (deslizar o
  mantener pulsado para quitar). Vacía: el icono de la comida y «Aún no has apuntado…».
  Abajo, fija, «Añadir alimento» y el escáner. Cargando y error con view_estado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizComida"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnAtrasComida"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ficha_atras"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_display_large"
                tools:targetApi="28" />

            <TextView
                android:id="@+id/tvDiaComida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_label" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollComida"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <!-- Resumen en la tarjeta protagonista (tablero 28): las kcal, qué parte es del día, el
                     reparto en una barra, los gramos de cada macro y, si es alta en proteína, el comentario. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResumen"
                    style="@style/Widget.GymProFit.Card.Protagonista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:id="@+id/marcoAnillo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="true"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="true"
                                android:importantForAccessibility="noHideDescendants"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvKcalComida"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Hero.Titulo"
                                    android:textSize="@dimen/text_cifra_grande" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:text="@string/comida_kcal_corto"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Hero.Apoyo"
                                    android:textSize="@dimen/text_body" />

                                <TextView
                                    android:id="@+id/tvDiaPct"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Hero.Apoyo"
                                    android:textSize="@dimen/text_label" />
                            </LinearLayout>

                            <es.pmdm.gymprofit.ui.nutricion.BarraReparto
                                android:id="@+id/barraReparto"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginTop="16dp" />

                            <LinearLayout
                                android:id="@+id/columnaMacros"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:importantForAccessibility="noHideDescendants"
                                android:orientation="horizontal">

                                <include
                                    android:id="@+id/filaProteina"
                                    layout="@layout/item_macro_comida"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/filaCarbos"
                                    layout="@layout/item_macro_comida"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <include
                                    android:id="@+id/filaGrasa"
                                    layout="@layout/item_macro_comida"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/filaComentario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ms_check_circle_fill"
                                app:tint="@color/gp_success" />

                            <TextView
                                android:id="@+id/tvComentarioComida"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/comida_alta_proteina"
                                android:textAppearance="@style/TextAppearance.GymProFit.Hero.Titulo"
                                android:textSize="@dimen/text_body" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/filaCuantos"
                    style="@style/Widget.GymProFit.CabeceraSeccion"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCuantos"
                        style="@style/Widget.GymProFit.CabeceraSeccion.Titulo" />

                    <!-- Lote 1.6.6: con dos alimentos o más, «Guardar como plato». -->
                    <TextView
                        android:id="@+id/btnGuardarComoPlato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/comida_guardar_como_plato"
                        android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/cardAlimentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tarjeta_20"
                    android:visibility="gone">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAlimentosComida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvPistaAlimentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/comida_pista"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_label"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/bloqueVacia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/marcoIconoVacia"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_icono_comida_vacia"
                        android:importantForAccessibility="no">

                        <ImageView
                            android:id="@+id/ivIconoVacia"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:tint="?attr/colorOnPrimaryContainer" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvVacia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.GymProFit.Headline"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_cifra_pequena" />

                    <TextView
                        android:id="@+id/tvVaciaToca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/comida_es_la_que_toca"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textSize="@dimen/text_body"
                        android:visibility="gone" />

                    <!-- «Hoy no» (lote 1.6.8, decisión 10): la comida que ese día no se hace
                         cuenta para el día completo. Marcada, lo dice y se puede quitar. -->
                    <TextView
                        android:id="@+id/tvHoyNoMarcada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="@string/hoy_no_marcada"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_body"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHoyNo"
                        style="@style/Widget.GymProFit.BotonPildora.Contorno"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="48dp"
                        android:text="@string/hoy_no_boton"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Lote 1.6.4 (tablero 2b): con la comida vacía, «¿Copiar la de ayer?» y
                     «Lo que sueles merendar». Las rellena ComidaActivity. -->
                <LinearLayout
                    android:id="@+id/bloqueSugerencias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/ranuraCopiarComida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/seccionSueles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvSueles"
                            style="@style/Widget.GymProFit.Seccion"
                            android:layout_marginBottom="8dp"
                            android:accessibilityHeading="true"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextAppearance.GymProFit.Label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:targetApi="28" />

                        <LinearLayout
                            android:id="@+id/listaSueles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tarjeta_20"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/estadoComida"
            layout="@layout/view_estado" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/barraComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnadirComida"
            style="@style/Widget.GymProFit.BotonPildora"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:minHeight="52dp"
            android:text="@string/comida_anadir_alimento"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold"
            app:icon="@drawable/ic_ms_add" />

        <ImageButton
            android:id="@+id/btnEscanearComida"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circulo_superficie"
            android:contentDescription="@string/comida_escanear_a11y"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ms_barcode_scanner"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
</LinearLayout>
