<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_permiso_descanso — «Avisarte con la pantalla apagada» (GP-013), la hoja que
  sale sola una vez, la primera vez que empieza un descanso sin el permiso que hace
  falta. «Dar permiso» lleva a lo que falte; «Ahora no» la cierra y no vuelve a salir
  sola (queda «Activar» en Ajustes).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circulo_contenedor"
        android:importantForAccessibility="no">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ms_alarm"
            app:tint="?attr/colorOnPrimaryContainer" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPermisoTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:accessibilityHeading="true"
        android:text="@string/descanso_permiso_titulo"
        android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

    <TextView
        android:id="@+id/tvPermisoTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/descanso_permiso_texto_alarmas"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDarPermiso"
        style="@style/Widget.GymProFit.BotonPildora"
        android:layout_width="match_parent"
        android:layout_marginTop="14dp"
        android:minHeight="52dp"
        android:text="@string/descanso_permiso_dar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAhoraNo"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp"
        android:text="@string/descanso_permiso_ahora_no"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/descanso_permiso_nota"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
