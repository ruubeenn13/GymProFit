<?xml version="1.0" encoding="utf-8"?>
<!--
  item_seccion_extra — un rótulo de grupo con algo a la derecha (tablero 4 y 8, lote 1.6.3):
  «Recientes» con «Ver todos», que despliega el resto ahí mismo, o «Los que más usas» con
  cuántos favoritos hay. El rótulo es un encabezado para TalkBack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/tvSeccion"
        style="@style/Widget.GymProFit.Seccion"
        android:textAppearance="@style/TextAppearance.GymProFit.Label"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:textAllCaps="true"
        android:accessibilityHeading="true"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:targetApi="28" />

    <TextView
        android:id="@+id/tvCuantosSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="12dp"
        android:textSize="@dimen/text_caption"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerTodos"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/recientes_ver_todos"
        android:contentDescription="@string/recientes_ver_todos_a11y"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
</LinearLayout>
