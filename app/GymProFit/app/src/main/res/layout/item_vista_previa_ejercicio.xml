<?xml version="1.0" encoding="utf-8"?>
<!--
  item_vista_previa_ejercicio — un ejercicio de la rutina desplegada en la hoja del tiempo
  (GP-243): el check, el nombre y la pauta («2 × 6–10») si se queda; el aspa, el nombre
  tachado y «fuera» si sale. El estado lo dicen el icono y la palabra, no solo el color.
  No se pulsa: sin los 48 dp de una zona táctil, para que la lista se lea de un vistazo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/espacio_4"
    android:paddingBottom="@dimen/espacio_4"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivVistaEjercicio"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ms_check"
        app:tint="?attr/colorPrimary" />

    <TextView
        android:id="@+id/tvVistaEjercicio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_12"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo" />

    <TextView
        android:id="@+id/tvVistaPauta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_8"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />
</LinearLayout>
