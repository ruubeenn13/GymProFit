<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_bienvenida — la bienvenida (GP-103, tablero 1 del lienzo): la función, en
  marcha. La marca y el idioma arriba, la demostración en bucle, qué hace la app en una
  frase, y «Empezar» y «Ya tengo cuenta» al pie. Es la puerta de entrada sin sesión.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/cabeceraBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.GymProFit.Display"
                android:textSize="@dimen/text_display" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIdioma"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="14dp"
                android:textSize="@dimen/text_body"
                app:icon="@drawable/ic_ms_language"
                app:iconSize="20dp" />
        </LinearLayout>

        <es.pmdm.gymprofit.ui.alta.DemoBienvenida
            android:id="@+id/demoBienvenida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:minHeight="420dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <TextView
            android:id="@+id/tvTituloBienvenida"
            style="@style/Widget.GymProFit.Alta.Titulo"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/bienvenida_titulo"
            android:textSize="38sp" />

        <TextView
            android:id="@+id/tvTextoBienvenida"
            style="@style/Widget.GymProFit.Alta.Texto"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/bienvenida_texto"
            android:textSize="@dimen/text_subtitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmpezar"
                style="@style/Widget.GymProFit.Alta.Boton"
                android:text="@string/alta_empezar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnYaTengoCuenta"
                style="@style/Widget.GymProFit.Alta.BotonTexto"
                android:layout_marginTop="4dp"
                android:text="@string/bienvenida_ya_tengo_cuenta" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
