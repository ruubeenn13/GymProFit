<?xml version="1.0" encoding="utf-8"?>
<!--
  item_alimento_busqueda — una fila de Añadir y de Buscar (tableros 4, 5 y 8, lotes 1.6.1 y 1.6.3).
  Icono de su categoría, nombre con la insignia azul de «datos revisados» y, debajo, las kcal
  por 100 g y la proteína, o la marca y su ración si es un producto. Tocarla abre la
  ficha; mantenerla pulsada, si es tuya, editar o eliminar. Las filas de un grupo forman
  su tarjeta con bg_grupo_* (primera, media, última o sola), que pone el adaptador, y
  una raya las separa. A la derecha, el «+» de 44 dp (lote 1.6.3), que añade sin preguntar
  y se vuelve ✓; tocar el ✓ lo quita.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filaAlimento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margen_pantalla"
    android:layout_marginEnd="@dimen/margen_pantalla"
    android:orientation="vertical"
    android:background="@drawable/bg_grupo_solo"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/espacio_16"
        android:paddingEnd="6dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

    <!-- El icono en su círculo de 40 dp sobre superficie 2 (DESIGN.md «Fila de lista»). -->
    <ImageView
        android:id="@+id/ivIconoFila"
        style="@style/Widget.GymProFit.Fila.Icono"
        android:src="@drawable/ic_ms_restaurant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/fila_icono_a_texto"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNombreFila"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="@dimen/text_fila"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetalleFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- El «+» (o el ✓): un círculo de 44 dp, como el tablero, dentro de una zona de toque
         de 48 (bg_mas_fila lo inserta 2 dp). Su fondo lo tiñe el adaptador. -->
    <FrameLayout
        android:id="@+id/btnMasFila"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_mas_fila"
        android:backgroundTint="@color/gp_surface_2"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivMasFila"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ms_add"
            app:tint="?attr/colorOnSurface" />
    </FrameLayout>
    </LinearLayout>

    <!-- Hasta el texto, 70 dp (GP-225). -->
    <View
        android:id="@+id/rayaFila"
        style="@style/Widget.GymProFit.Separador" />
</LinearLayout>
