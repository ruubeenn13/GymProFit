<?xml version="1.0" encoding="utf-8"?>
<!--
  item_alimento_busqueda — una fila de Añadir y de Buscar (tableros 4 y 5, lote 1.6.1).
  Icono del grupo, nombre con la insignia azul de «datos revisados» y, debajo, las kcal
  por 100 g y la proteína, o la marca y su ración si es un producto. Tocarla abre la
  ficha; mantenerla pulsada, si es tuya, editar o eliminar. Las filas de un grupo forman
  su tarjeta con bg_grupo_* (primera, media, última o sola), que pone el adaptador, y
  una raya las separa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filaAlimento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_grupo_solo"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/ivIconoFila"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant"
        android:src="@drawable/ic_ms_restaurant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvNombreFila"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="@dimen/text_fila"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDetalleFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/rayaFila"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="14dp"
        android:importantForAccessibility="no"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>
