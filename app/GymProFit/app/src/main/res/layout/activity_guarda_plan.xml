<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_guarda_plan — «Guarda tu plan» (GP-103, tableros 9 y 10 del lienzo).
  Tres campos —nombre, correo y contraseña con ojo—, sin repetirla ni elegir usuario.
  «Crear cuenta» se hace círculo y debajo salen los pasos («Creando tu cuenta»,
  «Preparando <programa>»); al acabar, «Todo listo» tapa la pantalla. Los errores van
  bajo su campo. «Continuar con Google» no está: es la fase 2 (GP-086).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/formularioGuarda"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.GymProFit.Cabecera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationContentDescription="@string/guarda_volver_a11y" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollGuarda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/filaPlanListo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivPlanListo"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_ms_check_circle_fill"
                        app:tint="?attr/colorOnPrimaryContainer"
                        android:importantForAccessibility="no" />

                    <TextView
                        style="@style/Widget.GymProFit.Alta.Antetitulo"
                        android:layout_marginStart="6dp"
                        android:text="@string/guarda_plan_listo" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTituloGuarda"
                    style="@style/Widget.GymProFit.Alta.Titulo"
                    android:layout_marginTop="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/alta_guarda_tu_plan"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/tvTextoGuarda"
                    style="@style/Widget.GymProFit.Alta.Texto"
                    android:layout_marginTop="8dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/guarda_texto" />

                <!-- Nombre -->
                <LinearLayout
                    android:id="@+id/bloqueNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:labelFor="@+id/etNombreGuarda"
                        android:text="@string/guarda_nombre"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNombreGuarda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:errorIconDrawable="@drawable/ic_ms_error"
                        app:helperTextEnabled="true"
                        app:helperText="@string/guarda_nombre_ayuda">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNombreGuarda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="personGivenName"
                            android:inputType="textPersonName|textCapWords"
                            android:maxLines="1"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Correo -->
                <LinearLayout
                    android:id="@+id/bloqueCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:labelFor="@+id/etCorreoGuarda"
                        android:text="@string/guarda_correo"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCorreoGuarda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:errorIconDrawable="@drawable/ic_ms_error">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCorreoGuarda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="emailAddress"
                            android:inputType="textEmailAddress"
                            android:maxLines="1"
                            android:imeOptions="actionNext" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Correo en uso: el error va en el campo, y debajo «Entrar con él». -->
                    <LinearLayout
                        android:id="@+id/errorCorreoEnUso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEntrarConCorreo"
                            style="@style/Widget.GymProFit.Alta.BotonTexto"
                            android:layout_width="wrap_content"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/guarda_entrar_con_el"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contraseña -->
                <LinearLayout
                    android:id="@+id/bloqueClave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:labelFor="@+id/etClaveGuarda"
                        android:text="@string/guarda_contrasena"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilClaveGuarda"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:errorIconDrawable="@drawable/ic_ms_error"
                        app:endIconMode="password_toggle"
                        app:endIconDrawable="@drawable/sel_ojo_password"
                        app:helperTextEnabled="true"
                        app:helperText="@string/password_politica">

                        <es.pmdm.gymprofit.ui.widget.CampoContrasena
                            android:id="@+id/etClaveGuarda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autofillHints="newPassword"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:imeOptions="actionDone" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Sin red: el plan no se pierde y se reintenta. -->
            <TextView
                android:id="@+id/tvAvisoGuarda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                android:accessibilityLiveRegion="assertive" />

            <FrameLayout
                android:id="@+id/marcoCrear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrearCuenta"
                    style="@style/Widget.GymProFit.Alta.Boton"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/guarda_crear_cuenta" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/giroCrear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="?attr/colorOnPrimary"
                    app:trackColor="@android:color/transparent"
                    app:indicatorSize="24dp"
                    app:trackThickness="3dp"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <!-- Los pasos mientras se crea la cuenta. -->
            <LinearLayout
                android:id="@+id/pasosCrear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                android:accessibilityLiveRegion="polite">

                <include android:id="@+id/pasoCuenta" layout="@layout/view_paso_crear" />
                <include android:id="@+id/pasoPrograma" layout="@layout/view_paso_crear"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLegalGuarda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:textSize="@dimen/text_eyebrow"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/guarda_ya_tienes_cuenta"
                    android:textSize="@dimen/text_body"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEntrarGuarda"
                    style="@style/Widget.GymProFit.Alta.BotonTexto"
                    android:layout_width="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/guarda_entrar"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- «Todo listo»: tapa la pantalla al acabar. -->
    <LinearLayout
        android:id="@+id/capaListo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:clipChildren="false">

            <View
                android:id="@+id/aroListo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:background="@drawable/bg_aro_listo" />

            <es.pmdm.gymprofit.ui.alta.CheckTrazado
                android:id="@+id/checkListo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTituloListo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.GymProFit.Display"
            android:textSize="36sp" />

        <TextView
            android:id="@+id/tvTextoListo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textSize="@dimen/text_fila"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeguirListo"
            style="@style/Widget.GymProFit.Alta.Boton"
            android:layout_marginTop="18dp"
            android:text="@string/guarda_seguir" />
    </LinearLayout>
</FrameLayout>
