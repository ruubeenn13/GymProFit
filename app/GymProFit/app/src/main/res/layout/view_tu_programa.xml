<?xml version="1.0" encoding="utf-8"?>
<!--
  view_tu_programa — «Tu programa», arriba de Entrenar (GP-074, rehecho en GP-216, tablero 14).

  Tres casos: sin programa, una tarjeta «Elige tu programa» que lleva a Programas; con programa, su
  tarjeta (nombre, «día N de M», las hechas de esta vuelta y la tira del ciclo), el bloque naranja
  «Hoy» con el botón de empezar y «Rutinas del programa» con los músculos y cuándo toca cada una; y
  si ha borrado todas sus rutinas, la tarjeta lo dice y ofrece volver a seguirlo o dejarlo. Mientras
  carga o si falla, el bloque de estado. Lo pinta TuProgramaVista.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/Widget.GymProFit.CabeceraSeccion"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/espacio_8">

        <TextView
            style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
            android:text="@string/tu_programa" />

        <ImageButton
            android:id="@+id/btnMenuPrograma"
            style="@style/Widget.GymProFit.BotonIcono"
            android:contentDescription="@string/tu_programa_menu_a11y"
            android:src="@drawable/ic_ms_more_vert"
            android:visibility="gone" />
    </LinearLayout>

    <include
        android:id="@+id/estadoPrograma"
        layout="@layout/view_estado" />

    <!-- Sin programa -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardElegirPrograma"
        style="@style/Widget.GymProFit.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_16">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circulo_superficie"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_ms_calendar_month"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tu_programa_elige_titulo"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display"
                    android:textSize="@dimen/text_headline" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/tu_programa_elige_sub"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/espacio_8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Con programa: su tarjeta -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPrograma"
        style="@style/Widget.GymProFit.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_20">

            <LinearLayout
                android:id="@+id/cabeceraPrograma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProgramaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display"
                    android:textSize="@dimen/text_display" />

                <TextView
                    android:id="@+id/tvProgramaResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Día N de M y las hechas de esta vuelta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_16"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgramaDia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/tvProgramaHechas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/barraCiclo"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/espacio_8"
                android:orientation="horizontal" />

            <!-- La tira del ciclo: un círculo por día con las siglas de su rutina -->
            <LinearLayout
                android:id="@+id/tiraCiclo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_16"
                android:orientation="horizontal" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Hoy: el bloque naranja con el botón de empezar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloqueHoy"
        style="@style/Widget.GymProFit.Card.Protagonista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_20">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHoyEtiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHoyNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_display_large" />

                <TextView
                    android:id="@+id/tvHoySub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <es.pmdm.gymprofit.ui.widget.BotonExpresivo
                android:id="@+id/btnEmpezarHoy"
                style="@style/Widget.GymProFit.Button.Expresivo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/espacio_16"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_ms_play_arrow_fill"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="32dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Todas las rutinas borradas -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bloqueBorradas"
        style="@style/Widget.GymProFit.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_16">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tu_programa_borradas"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolverASeguir"
                style="@style/Widget.GymProFit.BotonPildora"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/espacio_12"
                android:text="@string/tu_programa_volver_a_seguir" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDejarPrograma"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/espacio_8"
                android:text="@string/tu_programa_dejar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Rutinas del programa -->
    <TextView
        android:id="@+id/tvDespues"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_36"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:accessibilityHeading="true"
        android:text="@string/tu_programa_rutinas_titulo"
        android:textAppearance="@style/TextAppearance.GymProFit.Seccion"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardRutinasPrograma"
        style="@style/Widget.GymProFit.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/margen_pantalla"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/listaRestoPrograma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_4"
            android:paddingBottom="@dimen/espacio_4" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
