<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_home.xml — dashboard atlético del usuario tras iniciar sesión.
  Orden: cabecera, SILUETA MUSCULAR (el gancho: qué se ha entrenado esta semana),
  acciones rápidas —lo que se puede hacer HOY— y, por debajo, el historial:
  racha y resumen semanal. Navegación inferior al pie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cabecera: saludo + nombre (display) + fecha + menú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="22dp"
                android:paddingStart="20dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSaludo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_saludo"
                        android:textSize="@dimen/text_body"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/usuario_ejemplo"
                        android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                    <TextView
                        android:id="@+id/tvFecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="@dimen/text_caption"
                        android:textColor="?attr/colorPrimary" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/btnMenuOpciones"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_more_vert"
                    android:padding="8dp"
                    app:tint="?attr/colorOnSurface"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="16dp">

                <!-- ── EL CUERPO: qué has entrenado esta semana ── -->
                <!--
                  Va lo primero a propósito. Es lo único de la app que se entiende sin
                  leer y sin historial: un cuerpo gris que se enciende. Un usuario que
                  entra el primer día lo ve entero apagado, y eso es la llamada a la
                  acción más fuerte que puede tener la pantalla.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutlineVariant">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_cuerpo_eyebrow"
                            android:textSize="@dimen/text_eyebrow"
                            android:textStyle="bold"
                            android:letterSpacing="0.14"
                            android:textColor="?attr/colorPrimary" />

                        <!-- Resumen en una frase: cuántos grupos y cuál falta. -->
                        <TextView
                            android:id="@+id/tvCuerpoResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <es.pmdm.gymprofit.ui.widget.SiluetaMuscularView
                            android:id="@+id/siluetaMuscular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp" />

                        <TextView
                            android:id="@+id/tvCuerpoLeyenda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:text="@string/home_cuerpo_leyenda"
                            android:textSize="@dimen/text_label"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── RÉCORD: de lo que eres capaz, en dorado ── -->
                <!--
                  Nace oculta y solo aparece cuando hay un récord de verdad. Hasta ahora
                  este dato solo existía dentro del detalle de un ejercicio, o sea que
                  solo lo veía quien ya sabía cuál era el suyo.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecordHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/gp_gold">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_trofeo"
                            app:tint="@color/gp_gold"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_record_eyebrow"
                                android:textSize="@dimen/text_eyebrow"
                                android:textStyle="bold"
                                android:letterSpacing="0.14"
                                android:textColor="@color/gp_gold" />

                            <TextView
                                android:id="@+id/tvRecordEjercicio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textSize="@dimen/text_body"
                                android:textColor="?attr/colorOnSurface" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRecordPeso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textSize="@dimen/text_headline"
                            android:textStyle="bold"
                            android:textColor="@color/gp_gold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── ACCIONES RÁPIDAS ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/home_acciones_rapidas"
                    android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardIniciarEntrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_accion_tile">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_ejercicios"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="@string/home_iniciar_entrenamiento"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVerRutinas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_accion_tile">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_rutinas"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="@string/home_ver_rutinas"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRegistrarComida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_accion_tile">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nutricion"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:text="@string/home_registrar_comida"
                            android:textSize="@dimen/text_subtitle"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@null" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <!-- ── RACHA: número XXL sobre naranja ── -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="22dp"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_racha"
                                android:textAllCaps="true"
                                android:textSize="@dimen/text_caption"
                                android:letterSpacing="0.12"
                                android:textColor="?attr/colorOnPrimary"
                                android:alpha="0.85" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/tvRachaNumero"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:fontFamily="@font/barlow_condensed"
                                    android:textFontWeight="700"
                                    android:textSize="@dimen/text_number_hero"
                                    android:includeFontPadding="false"
                                    android:textColor="?attr/colorOnPrimary" />

                                <TextView
                                    android:id="@+id/tvRachaUnidad"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginBottom="12dp"
                                    android:text="@string/home_minutos"
                                    android:textSize="@dimen/text_subtitle"
                                    android:textColor="?attr/colorOnPrimary"
                                    android:alpha="0.9" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvRachaMejor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnPrimary"
                                android:alpha="0.85" />

                        </LinearLayout>

                        <FrameLayout
                            android:layout_width="76dp"
                            android:layout_height="76dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="#33FFFFFF">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_calorias"
                                app:tint="?attr/colorOnPrimary"
                                android:contentDescription="@string/home_racha" />

                        </FrameLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- ── ESTA SEMANA: 3 cifras grandes ── -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/home_semana_titulo"
                    android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_ejercicios"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvConteoEntrenamientos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="—"
                                android:fontFamily="@font/barlow_condensed"
                                android:textFontWeight="700"
                                android:textSize="@dimen/text_display_large"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_entrenos"
                                android:textSize="@dimen/text_eyebrow"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_calorias"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvConteoCaloriasHome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="—"
                                android:fontFamily="@font/barlow_condensed"
                                android:textFontWeight="700"
                                android:textSize="@dimen/text_display_large"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_calorias"
                                android:textSize="@dimen/text_eyebrow"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center_horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_tiempo"
                                app:tint="?attr/colorPrimary"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tvConteoMinutosHome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="—"
                                android:fontFamily="@font/barlow_condensed"
                                android:textFontWeight="700"
                                android:textSize="@dimen/text_display_large"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurface" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_minutos"
                                android:textSize="@dimen/text_eyebrow"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
