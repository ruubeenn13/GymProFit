<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_programa_detalle — detalle de un programa (GP-216, tablero 31). Cabecera con el color de
  su material que se funde con el fondo, «El ciclo» con cada rutina en su día, «De qué va» con
  «Leer más», las rutinas plegables (una abierta cada vez) y «Seguir este programa» fijo abajo.
  Los programas son cíclicos: sus días no son los de la semana, son el orden en que tocan.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                android:id="@+id/estadoDetalle"
                layout="@layout/view_estado" />

            <LinearLayout
                android:id="@+id/contenidoDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Cabecera: el color del material, que se funde con el fondo -->
                <LinearLayout
                    android:id="@+id/cabeceraPrograma"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/margen_pantalla"
                    android:paddingTop="84dp"
                    android:paddingEnd="@dimen/margen_pantalla"
                    android:paddingBottom="@dimen/espacio_24">

                    <TextView
                        android:id="@+id/tvDetalleMaterial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/gp_on_hero_variant"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetalleNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.GymProFit.Display"
                        android:textColor="@color/gp_on_hero"
                        android:textSize="@dimen/text_display_large" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipsPrograma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_12"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="6dp" />
                </LinearLayout>

                <!-- El ciclo -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:accessibilityHeading="true"
                    android:text="@string/programa_ciclo_titulo"
                    android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.GymProFit.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:layout_marginEnd="@dimen/margen_pantalla">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_16">

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/listaCiclo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal" />
                        </HorizontalScrollView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_12"
                            android:text="@string/programa_ciclo_explicacion"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_eyebrow" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- De qué va -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginTop="@dimen/espacio_28"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/programa_de_que_va"
                        android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

                    <TextView
                        android:id="@+id/tvDetalleDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:lineSpacingMultiplier="1.15"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_enlace_seccion" />

                    <TextView
                        android:id="@+id/btnLeerMas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Las rutinas -->
                <TextView
                    android:id="@+id/tvRutinasTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginTop="@dimen/espacio_16"
                    android:layout_marginEnd="@dimen/margen_pantalla"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.GymProFit.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margen_pantalla"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:layout_marginEnd="@dimen/margen_pantalla">

                    <LinearLayout
                        android:id="@+id/listaRutinasPrograma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/espacio_4"
                        android:paddingBottom="@dimen/espacio_4" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/btnAtras"
        style="@style/Widget.GymProFit.BotonRedondo"
        android:layout_marginStart="@dimen/espacio_8"
        android:layout_marginTop="@dimen/espacio_12"
        android:contentDescription="@string/ficha_atras"
        android:src="@drawable/ic_ms_arrow_back" />

    <!-- Seguir, fijo abajo -->
    <FrameLayout
        android:id="@+id/barraSeguir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_barra_inferior"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_16"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeguirPrograma"
            style="@style/Widget.GymProFit.BotonPildora.Expresivo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:maxLines="2"
            android:text="@string/programa_seguir"
            app:icon="@drawable/ic_ms_check" />
    </FrameLayout>
</FrameLayout>
