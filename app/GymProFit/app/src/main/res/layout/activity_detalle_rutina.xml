<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_detalle_rutina — detalle de una rutina (GP-216, tablero 32). Cabecera protagonista en el
  naranja de la marca con el nombre, las series por zona y la última vez; debajo, cada ejercicio con
  su pauta y tu última marca (dorada si fue récord); y «Empezar» fijo abajo. Editar solo en las
  rutinas propias.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPantalla"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="72dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GymProFit.Card.Protagonista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginEnd="@dimen/margen_pantalla">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_20">

                    <TextView
                        android:id="@+id/tvEtiquetaRutina"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNombreDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.GymProFit.Display"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/text_display_large" />

                    <TextView
                        android:id="@+id/tvResumenRutina"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_enlace_seccion" />

                    <TextView
                        android:id="@+id/tvDescripcionDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_8"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <!-- Series por zona -->
                    <LinearLayout
                        android:id="@+id/listaZonas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_16"
                        android:orientation="vertical" />

                    <!-- La última vez -->
                    <LinearLayout
                        android:id="@+id/bloqueUltimaVez"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ms_history"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvUltimaVezRutina"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/espacio_8"
                            android:layout_weight="1"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Ejercicios -->
            <TextView
                android:id="@+id/tvEjerciciosTituloDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_28"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.GymProFit.Seccion" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEjerciciosRutina"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_12"
                android:layout_marginEnd="@dimen/margen_pantalla">

                <LinearLayout
                    android:id="@+id/listaEjerciciosRutina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/espacio_4"
                    android:paddingBottom="@dimen/espacio_4" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvSinEjercicios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/espacio_12"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:text="@string/detalle_rutina_sin_ejercicios"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fondo tras el botón de volver al desplazar (BarraSuperior) -->
    <View
        android:id="@+id/barraSuperior"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?android:attr/colorBackground"
        android:importantForAccessibility="no"
        android:visibility="invisible" />

    <!-- Volver y editar, sobre el contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_8"
        android:layout_marginTop="@dimen/espacio_12"
        android:layout_marginEnd="@dimen/espacio_8"
        android:orientation="horizontal">


        <ImageButton
            android:id="@+id/btnAtras"
            style="@style/Widget.GymProFit.BotonRedondo"
            android:contentDescription="@string/ficha_atras"
            android:src="@drawable/ic_ms_arrow_back" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnEditarRutina"
            style="@style/Widget.GymProFit.BotonRedondo"
            android:contentDescription="@string/rutinas_editar"
            android:src="@drawable/ic_ms_edit"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Empezar, fijo abajo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_barra_inferior"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_16">

        <es.pmdm.gymprofit.ui.widget.BotonExpresivo
            android:id="@+id/btnEntrenarRutina"
            style="@style/Widget.GymProFit.BotonPildora.Expresivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:minHeight="56dp"
            app:icon="@drawable/ic_ms_play_arrow_fill" />
    </FrameLayout>
</FrameLayout>
