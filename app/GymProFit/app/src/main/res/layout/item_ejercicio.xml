<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ejercicio — una fila de la Biblioteca (GP-216, tablero 29): foto de 52 dp, nombre, grupo y
  material, y a la derecha el nivel con su punto de color. El fondo (primera, media, última o sola
  de la tarjeta) lo pone el adaptador. Sin foto, la silueta del músculo; nunca un bloque en blanco.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margen_pantalla"
    android:layout_marginEnd="@dimen/margen_pantalla"
    android:minHeight="76dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/fila_padding_horizontal"
    android:paddingEnd="@dimen/fila_padding_horizontal"
    android:paddingTop="@dimen/espacio_12"
    android:paddingBottom="@dimen/espacio_12"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_grupo_media">

    <!-- Primer fotograma de la demostración; la silueta si el ejercicio no tiene. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="@dimen/radio_miniatura"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivIconoEjercicio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_body_full" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fila_icono_a_texto"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_fila"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalleEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_eyebrow" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/puntoNivel"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_punto_nivel"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvNivelEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_eyebrow" />
    </LinearLayout>
</LinearLayout>
