<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_onboarding4.xml — Onboarding paso 4/5: elección de objetivo.

  CUATRO tarjetas, no diez. Los seis objetivos retirados (resistencia,
  flexibilidad, velocidad, movilidad, reducir grasa y aumentar calorías) no
  cambiaban el plan nutricional o repetían a otro, así que la pantalla pedía
  elegir entre diez opciones para llegar a cuatro resultados distintos. La poda
  del enum en la API va en V202609181900__Poda_objetivos_a_cuatro.sql.

  Los emojis se sustituyen por VectorDrawable de trazo (ic_objetivo_*). Un emoji
  lo dibuja la fuente del sistema: cambia de un móvil a otro, no se puede teñir
  y en algunos aparece en color plano sobre el fondo oscuro. El vector toma el
  color por app:tint, así que el mismo archivo vale para tema claro y oscuro.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Enlace para saltar el paso -->
    <TextView
        android:id="@+id/tvSaltar4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:text="@string/onboarding_saltar"
        android:textSize="@dimen/text_body"
        android:textColor="?attr/colorPrimary"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_objetivo_titulo"
                android:textAppearance="@style/TextAppearance.GymProFit.Display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:text="@string/onboarding_objetivo_desc"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- PERDER_PESO — tendencia bajando -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPerderPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivIconoPerderPeso"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_objetivo_perder_grasa"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="16dp" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/objetivo_perder_peso" android:textSize="@dimen/text_body"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="@string/objetivo_perder_peso_desc"
                            android:textSize="@dimen/text_caption" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ivCheckPerderPeso" android:layout_width="20dp"
                        android:layout_height="20dp" android:src="@drawable/ic_check"
                        android:visibility="gone" android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GANAR_MASA_MUSCULAR — tendencia subiendo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGanarMusculo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivIconoGanarMusculo"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_objetivo_ganar_musculo"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="16dp" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/objetivo_ganar_musculo" android:textSize="@dimen/text_body"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="@string/objetivo_ganar_musculo_desc"
                            android:textSize="@dimen/text_caption" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ivCheckGanarMusculo" android:layout_width="20dp"
                        android:layout_height="20dp" android:src="@drawable/ic_check"
                        android:visibility="gone" android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MANTENER_PESO — balanza en equilibrio -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMantener"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivIconoMantener"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_objetivo_mantener"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="16dp" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/objetivo_mantener" android:textSize="@dimen/text_body"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="@string/objetivo_mantener_desc"
                            android:textSize="@dimen/text_caption" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ivCheckMantener" android:layout_width="20dp"
                        android:layout_height="20dp" android:src="@drawable/ic_check"
                        android:visibility="gone" android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MEJORAR_FUERZA — rayo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFuerza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:strokeWidth="2dp"
                app:strokeColor="?attr/colorOutline">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical">
                    <ImageView android:id="@+id/ivIconoFuerza"
                        android:layout_width="28dp" android:layout_height="28dp"
                        android:src="@drawable/ic_objetivo_fuerza"
                        app:tint="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="16dp" android:contentDescription="@null" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/objetivo_fuerza" android:textSize="@dimen/text_body"
                            android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="@string/objetivo_fuerza_desc"
                            android:textSize="@dimen/text_caption" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <ImageView android:id="@+id/ivCheckFuerza" android:layout_width="20dp"
                        android:layout_height="20dp" android:src="@drawable/ic_check"
                        android:visibility="gone" android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Indicador paso 4/5 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
            <View android:layout_width="8dp" android:layout_height="4dp" android:background="?attr/colorSurfaceVariant" android:layout_marginEnd="5dp" />
            <View android:layout_width="8dp" android:layout_height="4dp" android:background="?attr/colorSurfaceVariant" android:layout_marginEnd="5dp" />
            <View android:layout_width="8dp" android:layout_height="4dp" android:background="?attr/colorSurfaceVariant" android:layout_marginEnd="5dp" />
            <View android:layout_width="32dp" android:layout_height="4dp" android:background="?attr/colorPrimary" android:layout_marginEnd="5dp" />
            <View android:layout_width="8dp" android:layout_height="4dp" android:background="?attr/colorSurfaceVariant" />
        </LinearLayout>

        <!-- Botones de navegación anterior/siguiente -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior4"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginEnd="8dp" android:text="@string/onboarding_anterior" app:cornerRadius="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente4"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="@string/onboarding_siguiente" app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
