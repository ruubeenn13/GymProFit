<?xml version="1.0" encoding="utf-8"?>
<!--
  item_propuesta_favorito — la propuesta de favorito, arriba de Favoritos (tablero 8,
  decisión 6, lote 1.6.3): el icono de su categoría, «¿Pan integral a favoritos?», cuántas
  veces lo has añadido en dos semanas, el corazón (sí) y la equis (no, y no vuelve).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_grupo_solo"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ImageView
        android:id="@+id/ivIconoPropuesta"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="@color/gp_on_primary_container" />

    <LinearLayout
        android:id="@+id/textosPropuesta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        android:focusable="true">

        <TextView
            android:id="@+id/tvTituloPropuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_fila"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/tvVecesPropuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnAceptarPropuesta"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_mas_fila"
        android:backgroundTint="@color/gp_primary_container"
        android:src="@drawable/ic_ms_favorite_fill"
        app:tint="?attr/colorPrimary" />

    <ImageButton
        android:id="@+id/btnRechazarPropuesta"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/propuesta_rechazar_a11y"
        android:src="@drawable/ic_ms_close"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
