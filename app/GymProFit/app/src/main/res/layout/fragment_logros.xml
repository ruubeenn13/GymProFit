<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_logros — sección Logros de Progreso (GP-105; antes LogrosActivity).
  El catálogo de logros con su estado; la carga, el vacío y el error con «Reintentar» van en
  view_estado, centrado en la sección (GP-064).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground">

    <!-- Listado de logros conseguidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLogros"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:visibility="gone" />

    <include
        android:id="@+id/estadoLogros"
        layout="@layout/view_estado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/margen_pantalla"
        android:layout_marginEnd="@dimen/margen_pantalla" />

</FrameLayout>
