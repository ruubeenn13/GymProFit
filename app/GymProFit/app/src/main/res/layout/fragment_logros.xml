<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_logros — sección Logros de Progreso (GP-105; antes LogrosActivity).
  El catálogo de logros con su estado, o el vacío si no hay.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Mensaje de estado vacío (sin logros) -->
    <TextView
        android:id="@+id/tvVacio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/logros_sin_logros"
        android:textSize="@dimen/text_subtitle"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Listado de logros conseguidos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLogros"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

</LinearLayout>
