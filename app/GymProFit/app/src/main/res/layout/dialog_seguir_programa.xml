<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_seguir_programa — la hoja de seguir un programa o cambiar su tiempo (lote 1.2.1).
  «¿Cuánto tiempo tienes por sesión?» con 30, 45, 60 y 75+, y la vista previa de lo
  elegido que calcula la API: cada rutina con sus minutos y lo que se queda fuera, la
  regla del recorte y el ajuste del perfil. Si ya sigue uno, el aviso de lo que pasa.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvSeguirTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/seguir_titulo"
            android:textAppearance="@style/TextAppearance.GymProFit.Display"
            android:textSize="@dimen/text_headline" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsMinutos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip30"
                style="@style/Widget.GymProFit.Chip.Hoja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip45"
                style="@style/Widget.GymProFit.Chip.Hoja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip60"
                style="@style/Widget.GymProFit.Chip.Hoja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip75"
                style="@style/Widget.GymProFit.Chip.Hoja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/seguir_chip_75" />
        </com.google.android.material.chip.ChipGroup>

        <include
            android:id="@+id/estadoVistaPrevia"
            layout="@layout/view_estado" />

        <LinearLayout
            android:id="@+id/listaVistaPrevia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvRegla"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/seguir_regla"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvAjustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="@dimen/text_caption"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAvisoSeguir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            android:background="@drawable/bg_grupo_solo"
            android:textSize="@dimen/text_body"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarSeguir"
            style="@style/Widget.GymProFit.BotonPildora"
            android:layout_width="match_parent"
            android:layout_marginTop="16dp"
            android:maxLines="2"
            android:text="@string/seguir_boton" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
