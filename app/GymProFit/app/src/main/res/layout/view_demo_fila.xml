<?xml version="1.0" encoding="utf-8"?>
<!-- Una serie de la demostración de la bienvenida (GP-103): número, anterior, kg, reps y su check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_demo_fila"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView android:id="@+id/demoNum" style="@style/Widget.GymProFit.Demo.Celda" android:layout_width="48dp"
        android:textSize="@dimen/text_body" />
    <TextView android:id="@+id/demoAnterior" style="@style/Widget.GymProFit.Demo.Celda" android:layout_width="0dp"
        android:layout_weight="1.25" android:textSize="@dimen/text_caption" android:textStyle="normal"
        android:textColor="?attr/colorOnSurfaceVariant" />
    <TextView android:id="@+id/demoKg" style="@style/Widget.GymProFit.Demo.Celda" android:layout_width="0dp"
        android:layout_weight="1" />
    <TextView android:id="@+id/demoReps" style="@style/Widget.GymProFit.Demo.Celda" android:layout_width="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:clipChildren="false">

        <View
            android:id="@+id/demoOnda"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/bg_demo_onda" />

        <FrameLayout
            android:id="@+id/demoCheck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_demo_check">

            <ImageView
                android:id="@+id/demoCheckIcono"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ms_check"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
