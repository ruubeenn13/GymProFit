<?xml version="1.0" encoding="utf-8"?>
<!--
  item_ingrediente_plato — un ingrediente en la pantalla del plato (tablero 10, lote 1.6.6):
  el icono de su categoría, su nombre y su cantidad, y sus kcal a la derecha. Tocarlo abre
  su cantidad en la ficha («Actualizar»); deslizarlo lo quita, con «Deshacer». Una raya lo
  separa del siguiente (la de debajo del último la tapa «Añadir ingrediente»).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filaIngrediente"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/ivIconoIngrediente"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ms_restaurant"
            app:tint="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreIngrediente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_fila" />

            <TextView
                android:id="@+id/tvCantidadIngrediente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKcalIngrediente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:importantForAccessibility="no"
        android:background="?attr/colorOutlineVariant" />
</LinearLayout>
