<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_acerca_de — Acerca de GymProFit (GP-216, tablero 23): el logo, la versión y lo que es la
  app, cuatro de sus piezas en tarjetas y, debajo, el contacto, compartir la app y las licencias.
  Los términos y la política de privacidad están en Perfil y ajustes › Legal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ajustes_acerca" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/espacio_24"
            android:paddingBottom="@dimen/espacio_36">

            <!-- La marca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_8"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_8"
                    android:background="@drawable/bg_chip_dato"
                    android:paddingStart="@dimen/espacio_12"
                    android:paddingTop="@dimen/espacio_4"
                    android:paddingEnd="@dimen/espacio_12"
                    android:paddingBottom="@dimen/espacio_4"
                    android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/acerca_lema"
                    android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo" />
            </LinearLayout>

            <!-- Qué hace: cuatro piezas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pieza1"
                        layout="@layout/item_pieza_acerca" />

                    <include
                        android:id="@+id/pieza2"
                        layout="@layout/item_pieza_acerca" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_12"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pieza3"
                        layout="@layout/item_pieza_acerca" />

                    <include
                        android:id="@+id/pieza4"
                        layout="@layout/item_pieza_acerca" />
                </LinearLayout>
            </LinearLayout>

            <!-- Contacto, compartir y licencias -->
            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes.Pantalla"
                android:layout_marginTop="@dimen/separacion_subpantalla">

                <include android:id="@+id/llAcercaEmail" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/llAcercaCompartir" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/llAcercaLicencias" layout="@layout/view_fila_ajuste" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
