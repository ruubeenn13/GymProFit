<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_sesion_en_vivo — la sesión en vivo (GP-012).
  Arriba, minimizar, la rutina y su programa, y «Terminar». Debajo, el tiempo, las
  series hechas de las totales y los ejercicios hechos, con una barra de progreso.
  Si se intentó guardar, el estado del guardado. Luego la lista: una tarjeta por
  ejercicio con una fila por serie, y al final «Añadir ejercicio» y «Descartar».
  La lista deja libre la parte de abajo de la pantalla: ahí irá el descanso (GP-013).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_ms_keyboard_arrow_down"
        app:navigationContentDescription="@string/envivo_minimizar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerminar"
            style="@style/Widget.GymProFit.BotonPildora"
            android:layout_width="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:text="@string/envivo_terminar" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Tiempo, series y ejercicios. TalkBack lo lee de una vez. -->
    <LinearLayout
        android:id="@+id/filaResumen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:focusable="true"
        android:importantForAccessibility="yes">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:importantForAccessibility="noHideDescendants">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRotuloTiempo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/envivo_tiempo"
                    android:textAppearance="@style/TextAppearance.GymProFit.Label"
                    android:textSize="@dimen/text_eyebrow"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvTiempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GymProFit.Number"
                    android:textSize="@dimen/text_headline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRotuloSeries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/envivo_series"
                    android:textAppearance="@style/TextAppearance.GymProFit.Label"
                    android:textSize="@dimen/text_eyebrow"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvSeries"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GymProFit.Number"
                    android:textSize="@dimen/text_headline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRotuloEjercicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/envivo_ejercicios"
                    android:textAppearance="@style/TextAppearance.GymProFit.Label"
                    android:textSize="@dimen/text_eyebrow"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvEjercicios"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.GymProFit.Number"
                    android:textSize="@dimen/text_headline" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barraProgreso"
            style="@style/Widget.GymProFit.BarraProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- Estado del guardado: solo desde el primer intento. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGuardado"
        style="@style/Widget.GymProFit.Card.Estructura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivGuardado"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_ms_error"
                    android:importantForAccessibility="no"
                    app:tint="?attr/colorError" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progresoGuardado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:indeterminate="true"
                    android:importantForAccessibility="no"
                    app:indicatorSize="24dp" />

                <TextView
                    android:id="@+id/tvGuardadoTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.GymProFit.Texto"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvGuardadoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/envivo_error_texto"
                android:textSize="@dimen/text_body"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/Widget.GymProFit.BotonPildora"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/btn_reintentar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDescartarGuardado"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:text="@string/envivo_descartar" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSesion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/envivo_hueco_descanso" />
</LinearLayout>
