<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_crear_rutina — crear una rutina, paso 1: qué y cuánto (GP-244, tablero Mezcla-1).
  «Nueva rutina» con el aspa. «¿Qué quieres entrenar?» con las seis zonas en tarjetas de dos
  en dos (item_zona_crear, se marcan una o varias); «¿Cuánto tiempo tienes?» con el selector
  de 30, 45, 60 y 75+; y «Prefiero buscar entre todos», que salta al paso 2 sin zonas. El pie
  fijo dice lo elegido y lleva «Elegir ejercicios», que pide al menos una zona.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationContentDescription="@string/crear_cerrar"
        app:navigationIcon="@drawable/ic_ms_close"
        app:title="@string/crear_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_4"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/crear_que_entrenar"
                android:textAppearance="@style/TextAppearance.GymProFit.Display" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_4"
                android:text="@string/crear_que_entrenar_apoyo"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

            <!-- Las seis zonas, de dos en dos: las filas las rellena CrearRutinaActivity. -->
            <LinearLayout
                android:id="@+id/rejillaZonas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_16"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvCuantoTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_28"
                android:accessibilityHeading="true"
                android:text="@string/crear_cuanto_tiempo"
                android:textAppearance="@style/TextAppearance.GymProFit.Headline" />

            <es.pmdm.gymprofit.ui.widget.SelectorPildora
                android:id="@+id/selectorMinutos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_12"
                app:selectorNombreGrupo="@string/crear_cuanto_tiempo" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_12"
                android:text="@string/crear_cuanto_apoyo"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBuscarTodos"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_16"
                android:minHeight="@dimen/zona_tactil"
                android:text="@string/crear_buscar_todos"
                android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                android:textColor="?attr/colorPrimary"
                app:icon="@drawable/ic_ms_search"
                app:iconTint="?attr/colorPrimary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_inferior"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_16">

        <TextView
            android:id="@+id/tvPieCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElegirEjercicios"
            style="@style/Widget.GymProFit.BotonPildora.Expresivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8"
            android:minHeight="56dp"
            android:text="@string/crear_elegir_ejercicios"
            app:icon="@drawable/ic_ms_arrow_forward"
            app:iconGravity="textEnd" />
    </LinearLayout>
</LinearLayout>
