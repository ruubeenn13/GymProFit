<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_admin_rutinas — pantalla de administración de rutinas.
  Lista todas las rutinas del sistema con búsqueda y filtros por estado/nivel,
  destinada al rol ADMIN.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <!-- Cabecera -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/admin_rutinas_titulo">

        <ImageButton
            android:id="@+id/btnMenuOpciones"
            style="@style/Widget.GymProFit.BotonIcono"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_ms_more_vert"
            android:contentDescription="@string/menu_opciones" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- SearchView -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        app:queryHint="@string/admin_buscar_rutinas"
        app:iconifiedByDefault="false"
        app:searchIcon="@drawable/ic_ms_search" />

    <!-- Filtros -->
    <!-- Estado y nivel de dificultad de las rutinas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/colorSurface">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFiltros"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_todos"
                android:checked="true"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_activos"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInactivas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_inactivos"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrincipiante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_principiante"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipIntermedio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_intermedio"
                style="@style/Widget.Material3.Chip.Filter" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAvanzado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_filtro_avanzado"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Separador visual bajo los filtros -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        android:alpha="0.12" />

    <!-- Listado de rutinas -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRutinas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

</LinearLayout>
