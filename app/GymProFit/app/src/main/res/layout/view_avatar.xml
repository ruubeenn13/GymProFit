<?xml version="1.0" encoding="utf-8"?>
<!--
  view_avatar — avatar redondo (GP-105, GP-210 paso 2): 48 dp, borde naranja de 2 dp sobre #3A2110, la foto de perfil si la hay y, si no, la
  inicial del usuario. Lo rellena AvatarUtils. Quien lo incluye decide la medida y si
  es pulsable (en Inicio lleva a Progreso; en Progreso cambia la foto).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/avatar_cabecera"
    android:layout_height="@dimen/avatar_cabecera"
    android:background="@drawable/bg_avatar_cabecera"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvInicial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.GymProFit.Avatar" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivFoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/avatar_cabecera_borde"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.GymProFit.Circulo" />
</FrameLayout>
