<?xml version="1.0" encoding="utf-8"?>
<!--
  item_programa — un programa en la lista de Programas (lote 1.2.1; rehecho en GP-232, tablero
  «Programas»): el nombre con «Lo sigues» si es el suyo, el nivel con su punto (NivelColor) y
  «Intermedio, 4 días, de 50 a 55 minutos» en frase, y la tira de su ciclo (Siglas sobre
  Programa.semana) con el icono de que se repite. Sin barras. Tocar abre el detalle; TalkBack la
  lee de una vez. El recomendado va en item_programa_recomendado, en la tarjeta protagonista.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GymProFit.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/espacio_12"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:padding="@dimen/espacio_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProgramaNombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.GymProFit.Display"
                        android:textSize="@dimen/text_programa_nombre" />

                    <TextView
                        android:id="@+id/tvLoSigues"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_8"
                        android:background="@drawable/bg_chip_zona_hecha"
                        android:gravity="center_vertical"
                        android:minHeight="22dp"
                        android:paddingStart="@dimen/espacio_8"
                        android:paddingEnd="@dimen/espacio_8"
                        android:text="@string/programas_lo_sigues"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_4"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/puntoNivel"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_punto_nivel" />

                    <TextView
                        android:id="@+id/tvProgramaResumen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.GymProFit.Apoyo"
                        android:textColor="@color/gp_text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="@dimen/espacio_8"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ms_chevron_right"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiraCiclo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tvProgramaMotivo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_12"
            android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
