<?xml version="1.0" encoding="utf-8"?>
<!-- item_paso_ejercicio — un paso de «Cómo se hace» (GP-216, tablero 30): el número en círculo naranja y el texto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_16"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvPasoNumero"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_circulo_contenedor"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.GymProFit.Number"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvPasoTexto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:lineSpacingMultiplier="1.15"
        android:paddingTop="5dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15sp" />
</LinearLayout>
