<?xml version="1.0" encoding="utf-8"?>
<!--
  item_tu_dia — una tarjeta del carrusel «Tu día» de Inicio (GP-216, tablero 13): calorías,
  proteína o agua. Rótulo con su icono, el dibujo (un aro o los vasos), la cifra y su apoyo.
  La rellena InicioTuDia. Es pulsable: lleva a Nutrición.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GymProFit.Card.Pequena"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRotuloDia"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tvRotuloDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/espacio_8"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/espacio_12"
            android:importantForAccessibility="no">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/anilloDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:max="100"
                app:indicatorSize="72dp"
                app:indicatorTrackGapSize="0dp"
                app:trackColor="@color/gp_meter_track"
                app:trackCornerRadius="@dimen/espacio_4"
                app:trackThickness="@dimen/espacio_8" />

            <es.pmdm.gymprofit.ui.widget.VasosAguaView
                android:id="@+id/vasosDia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCifraDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_12"
            android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />

        <TextView
            android:id="@+id/tvApoyoDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
