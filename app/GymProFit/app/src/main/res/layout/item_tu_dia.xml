<?xml version="1.0" encoding="utf-8"?>
<!--
  item_tu_dia — un tile de «Tu día» en Inicio (GP-216, tablero 13; en Liquid Glass desde GP-285):
  calorías, proteína o agua. Rótulo con su icono, la cifra, su apoyo y, abajo, una barra con lo
  que va del objetivo. Los tres van a lo ancho con el mismo alto: si un texto pasa a dos
  líneas, el hueco de antes de la barra absorbe la diferencia y las tres barras quedan en línea.
  Los tres textos son TextoSinPartir (GP-288): con letra grande encogen antes que partir una
  palabra o cortar la cifra, nunca por debajo de su tamaño a letra 1,0.
  Lo rellena InicioTuDia. Es pulsable: lleva a Nutrición.
-->
<es.pmdm.gymprofit.ui.cristal.TarjetaCristal xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.GymProFit.Card.Cristal.Tile"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_cristal_tile"
        android:minHeight="@dimen/tile_alto_min"
        android:orientation="vertical"
        android:paddingStart="@dimen/tile_relleno"
        android:paddingEnd="@dimen/tile_relleno"
        android:paddingTop="@dimen/espacio_12"
        android:paddingBottom="@dimen/espacio_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivRotuloDia"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no" />

            <es.pmdm.gymprofit.ui.widget.TextoSinPartir
                android:id="@+id/tvRotuloDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/espacio_4"
                android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />
        </LinearLayout>

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvCifraDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_4"
            android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />

        <es.pmdm.gymprofit.ui.widget.TextoSinPartir
            android:id="@+id/tvApoyoDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo.Pequeno" />

        <!-- Empuja la barra abajo cuando el tile de al lado es más alto. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <es.pmdm.gymprofit.ui.cristal.BarraProgresoCristal
            android:id="@+id/barraDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_8" />
    </LinearLayout>
</es.pmdm.gymprofit.ui.cristal.TarjetaCristal>
