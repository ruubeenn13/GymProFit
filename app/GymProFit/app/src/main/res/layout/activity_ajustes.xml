<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_ajustes — Ajustes (GP-105), según 05-ajustes.png. Se abre con el engranaje
  de Progreso. Reúne lo que eran la pestaña Perfil y el menú de tres puntos: cuenta,
  datos y objetivos, preferencias, ayuda, legal y, al final, cerrar sesión y eliminar
  la cuenta. La fila de Administración solo sale a un ADMIN y es temporal (GP-085).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/android:colorBackground">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.GymProFit.Cabecera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/android:colorBackground"
        app:title="@string/ajustes_titulo" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_cuenta" />

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaFoto" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaCorreo" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaContrasena" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <TextView
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_datos" />

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaPesoAlturaEdad" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaSexoActividad" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaObjetivo" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaNivel" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="6dp"
                android:text="@string/ajustes_nota_recalculo"
                android:textSize="@dimen/text_eyebrow"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_preferencias" />

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaTema" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaIdioma" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaNotificaciones" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <TextView
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_ayuda" />

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaSoporte" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaError" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaMejora" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <TextView
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_legal" />

            <LinearLayout
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaPrivacidad" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaTerminos" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaLicencias" layout="@layout/view_fila_ajuste" />
                <include android:id="@+id/filaAcerca" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSeccionAdmin"
                style="@style/Widget.GymProFit.Seccion"
                android:paddingStart="4dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="@string/ajustes_admin" />

            <LinearLayout
                android:id="@+id/grupoAdmin"
                style="@style/Widget.GymProFit.GrupoAjustes">
                <include android:id="@+id/filaAdmin" layout="@layout/view_fila_ajuste" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSesion"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:text="@string/perfil_cerrar_sesion"
                app:icon="@drawable/ic_ms_logout"
                app:iconSize="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarCuenta"
                style="@style/Widget.GymProFit.BotonPildora.Contorno"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/perfil_eliminar_cuenta"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_ms_delete"
                app:iconSize="24dp"
                app:iconTint="?attr/colorError"
                app:strokeWidth="0dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/ajustes_eliminar_nota"
                android:textSize="@dimen/text_eyebrow"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
