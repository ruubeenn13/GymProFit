<?xml version="1.0" encoding="utf-8"?>
<!--
  view_fila_ajuste_sub — una fila de Ajustes con una segunda línea (GP-013): icono,
  título, la línea de debajo («En el entrenamiento libre…», «Sin permiso: pueden llegar
  tarde»), y a la derecha un valor con chevron o un botón («Activar»). La rellena
  AjustesActivity; TalkBack la lee de una vez.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GymProFit.FilaAjuste"
    android:minHeight="64dp">

    <ImageView
        android:id="@+id/ivIcono"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:importantForAccessibility="no"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:importantForAccessibility="no"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivFlecha"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="14dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ms_chevron_right"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccion"
        style="@style/Widget.GymProFit.BotonPildora.Contorno"
        android:layout_width="wrap_content"
        android:layout_marginStart="12dp"
        android:minHeight="48dp"
        android:visibility="gone" />
</LinearLayout>
