<?xml version="1.0" encoding="utf-8"?>
<!--
  dialog_hoja_elegir — la hoja inferior de elegir una opción (GP-216, tablero 22): la misma para
  Tema, Idioma, Vaso de agua y Descanso sin pauta. Tirador, título y las opciones en dos
  columnas (item_opcion_hoja), con una nota debajo. Las filas de opciones las monta HojaElegir.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_12"
        android:paddingBottom="@dimen/espacio_28">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_tirador_hoja"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvTituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_16"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.GymProFit.Cifra.Pequena" />

        <LinearLayout
            android:id="@+id/gridOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_16"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvNotaHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_16"
            android:textAppearance="@style/TextAppearance.GymProFit.Apoyo" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
