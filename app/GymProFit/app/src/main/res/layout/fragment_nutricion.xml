<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_nutricion — pestaña Nutrición (GP-105). Desde la 1.6.8, el diario nuevo del
  tablero 1 (y el 3 con el día completo), lienzo del 02-10:
  cabecera con historial y calendario; la tira de la semana con el punto de cada día y la
  marca del entreno; «Día de entreno · …» si ese día hubo; la tarjeta del anillo, lo que
  queda y los macros (con el día completo, el ✓ y «Día completo»); el agua a vasos; con el
  día completo, «Tu semana»; y las cinco comidas con su «+». Lo rellena NutricionFragment.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/Widget.GymProFit.CabeceraPestana">

            <TextView
                style="@style/Widget.GymProFit.TituloPestana"
                android:text="@string/nav_nutricion" />

            <ImageButton
                android:id="@+id/btnHistorial"
                style="@style/Widget.GymProFit.BotonRedondo"
                android:contentDescription="@string/nutricion_historial_a11y"
                android:src="@drawable/ic_ms_bar_chart" />

            <ImageButton
                android:id="@+id/btnCalendario"
                style="@style/Widget.GymProFit.BotonRedondo"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/nutricion_elegir_dia_a11y"
                android:src="@drawable/ic_ms_calendar_month" />
            <include
                android:id="@+id/avatarCabecera"
                layout="@layout/view_avatar"
                android:layout_width="@dimen/avatar_cabecera"
                android:layout_height="@dimen/avatar_cabecera"
                android:layout_marginStart="@dimen/espacio_8" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiraSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!--
              «Tu semana de nutrición», los lunes (decisión 13): una tarjeta sin notificación que
              lleva al resumen de la semana pasada. Se cierra y no vuelve hasta el lunes siguiente.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAvisoSemana"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/filaAvisoSemana"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ms_bar_chart"
                            app:tint="?attr/colorPrimary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:importantForAccessibility="noHideDescendants"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/sn_lunes_titulo"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/text_fila"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/sn_lunes_texto"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCerrarAvisoSemana"
                        style="@style/Widget.GymProFit.BotonIcono"
                        android:contentDescription="@string/sn_lunes_cerrar"
                        android:src="@drawable/ic_ms_close"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- «Día de entreno · Cuerpo completo B»: de las sesiones terminadas ese día. -->
            <LinearLayout
                android:id="@+id/pildoraEntreno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:minHeight="44dp"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_pildora_entreno"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ms_fitness_center_fill"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvEntreno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:textColor="@color/gp_on_primary_container" />
            </LinearLayout>

            <!-- Sin red o con la API caída: el fallo y «Reintentar» donde irían las cifras. -->
            <include
                android:id="@+id/estadoNutricion"
                layout="@layout/view_estado" />

            <!-- El anillo, lo que queda y los macros -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDia"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/filaKcal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:focusable="true">

                        <FrameLayout
                            android:id="@+id/marcoAnilloDia"
                            android:layout_width="136dp"
                            android:layout_height="136dp"
                            android:importantForAccessibility="noHideDescendants">

                            <es.pmdm.gymprofit.ui.nutricion.AnilloDia
                                android:id="@+id/anilloDia"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:paddingStart="26dp"
                                android:paddingEnd="26dp"
                                android:orientation="vertical"
                                android:gravity="center_horizontal">

                                <TextView
                                    android:id="@+id/tvKcal"
                                    android:layout_width="match_parent"
                                    android:gravity="center"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeMinTextSize="18sp"
                                    app:autoSizeMaxTextSize="36sp"
                                    android:fontFeatureSettings="tnum"
                                    android:textAppearance="@style/TextAppearance.GymProFit.Number"
                                    android:textSize="@dimen/text_number" />

                                <TextView
                                    android:id="@+id/tvKcalObjetivo"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:maxLines="2"
                                    android:textSize="@dimen/text_eyebrow"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </FrameLayout>

                        <!-- Lo que queda -->
                        <LinearLayout
                            android:id="@+id/grupoQuedan"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical"
                            android:importantForAccessibility="noHideDescendants">

                            <TextView
                                android:id="@+id/tvQuedanRotulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nutricion_te_quedan"
                                android:textAppearance="@style/TextAppearance.GymProFit.Label"
                                android:textSize="@dimen/text_eyebrow" />

                            <TextView
                                android:id="@+id/tvQuedan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:includeFontPadding="false"
                                android:fontFeatureSettings="tnum"
                                android:textAppearance="@style/TextAppearance.GymProFit.Number"
                                android:textSize="@dimen/text_number" />

                            <TextView
                                android:id="@+id/tvQuedanUnidad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/nutricion_kcal_para_hoy"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <!-- Con el día completo (tablero 3) -->
                        <LinearLayout
                            android:id="@+id/grupoCompleto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:importantForAccessibility="noHideDescendants">

                            <FrameLayout
                                android:id="@+id/checkCompleto"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_check_completo">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_ms_check"
                                    app:tint="@color/gp_success" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/dia_completo_titulo"
                                android:textAppearance="@style/TextAppearance.GymProFit.Display" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/dia_completo_texto"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/macroProteinas"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />

                    <include
                        android:id="@+id/macroCarbos"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/macroGrasas"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- «Comidas» y, si hay la de ayer que copiar, «Copiar ayer» (tablero 15). -->
            <LinearLayout
                android:id="@+id/cabeceraComidas"
                style="@style/Widget.GymProFit.CabeceraSeccion"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                    android:text="@string/nutricion_comidas" />

                <TextView
                    android:id="@+id/btnCopiarAyerDiario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_ms_content_copy"
                    android:drawableTint="?attr/colorPrimary"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/nutricion_copiar_ayer"
                    android:textAppearance="@style/TextAppearance.GymProFit.Enlace"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaComidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            <!-- El agua (GP-166) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAgua"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/grupoAgua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/resumenAgua"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ms_water_drop_fill"
                                app:tint="@color/gp_agua" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical"
                                android:importantForAccessibility="noHideDescendants">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/agua_titulo"
                                    android:textSize="@dimen/text_fila"
                                    android:textStyle="bold"
                                    android:textColor="?attr/colorOnSurface" />

                                <TextView
                                    android:id="@+id/tvAguaLitros"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFeatureSettings="tnum"
                                    android:textSize="@dimen/text_caption"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVaso"
                            style="@style/Widget.Material3.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="48dp"
                            android:insetTop="2dp"
                            android:insetBottom="2dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="16dp"
                            android:text="@string/agua_vaso"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:textColor="@color/gp_on_agua_container"
                            app:backgroundTint="@color/gp_agua_container"
                            app:icon="@drawable/ic_ms_add"
                            app:iconSize="20dp"
                            app:iconPadding="6dp"
                            app:iconTint="@color/gp_on_agua_container" />
                    </LinearLayout>

                    <!-- Los vasos: los rellena NutricionFragment, en filas de nueve. -->
                    <LinearLayout
                        android:id="@+id/filasVasos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tu semana: un resumen con enlace a la semana (tablero 15). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSemana"
                style="@style/Widget.GymProFit.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/filaSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        style="@style/Widget.GymProFit.CabeceraSeccion"
                        android:importantForAccessibility="noHideDescendants">

                        <TextView
                            style="@style/Widget.GymProFit.CabeceraSeccion.Titulo"
                            android:text="@string/nutricion_tu_semana" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nutricion_ver_semana"
                            android:textAppearance="@style/TextAppearance.GymProFit.Enlace" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSemanaTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:importantForAccessibility="no"
                        android:textSize="@dimen/text_fila"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/tvSemanaTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:importantForAccessibility="no"
                        android:textSize="@dimen/text_caption"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- Con el día completo (tablero 3): cuántos van y lo que hubo ese día. -->
                    <TextView
                        android:id="@+id/tvSemanaExtra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:importantForAccessibility="no"
                        android:lineSpacingMultiplier="1.1"
                        android:textSize="@dimen/text_caption"
                        android:textColor="@color/gp_success"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
