<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_nutricion — pestaña Nutrición (GP-105), según 03-nutricion.png.
  Cabecera con historial y calendario, la tira de la semana (de lunes a domingo; los
  días que no han llegado, desactivados), la tarjeta de kcal y macros, y las cinco
  comidas con su «+». La tira y las comidas las rellena NutricionFragment.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout style="@style/Widget.GymProFit.CabeceraPestana">

            <TextView
                style="@style/Widget.GymProFit.TituloPestana"
                android:text="@string/nav_nutricion" />

            <ImageButton
                android:id="@+id/btnHistorial"
                style="@style/Widget.GymProFit.BotonRedondo"
                android:contentDescription="@string/nutricion_historial_a11y"
                android:src="@drawable/ic_ms_insights" />

            <ImageButton
                android:id="@+id/btnCalendario"
                style="@style/Widget.GymProFit.BotonRedondo"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/nutricion_elegir_dia_a11y"
                android:src="@drawable/ic_ms_calendar_month" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiraSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <!-- Kcal y macros -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GymProFit.Card.Estructura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/filaKcal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:importantForAccessibility="noHideDescendants">

                            <TextView
                                android:id="@+id/tvKcal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textAppearance="@style/TextAppearance.GymProFit.Number" />

                            <TextView
                                android:id="@+id/tvKcalObjetivo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:importantForAccessibility="noHideDescendants">

                            <TextView
                                android:id="@+id/tvQuedanRotulo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nutricion_te_quedan"
                                android:textSize="@dimen/text_caption"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <TextView
                                android:id="@+id/tvQuedan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/text_subtitle"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/barraKcal"
                        style="@style/Widget.GymProFit.BarraProgreso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp" />

                    <include
                        android:id="@+id/macroProteinas"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <include
                        android:id="@+id/macroCarbos"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <include
                        android:id="@+id/macroGrasas"
                        layout="@layout/view_macro_barra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/listaComidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
