<?xml version="1.0" encoding="utf-8"?>
<!--
  item_desplegable — una opción del menú de un desplegable (Registrar sesión, GP-225): 48 dp de alto,
  el texto de cuerpo y la ✓ naranja en la elegida (el menú la marca con su estado: CHECKED).
-->
<CheckedTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/text1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/espacio_16"
    android:paddingEnd="@dimen/espacio_16"
    android:drawablePadding="@dimen/espacio_12"
    android:checkMark="@drawable/ic_ms_check"
    android:checkMarkTint="@color/marca_elegida"
    android:ellipsize="end"
    android:maxLines="2"
    android:textAppearance="@style/TextAppearance.GymProFit.Cuerpo"
    android:textColor="?attr/colorOnSurface" />
