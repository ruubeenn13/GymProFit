<?xml version="1.0" encoding="utf-8"?>
<!-- La G entra (GP-223): el trazo aparece mientras llega, con sus mismos tiempos. La opacidad
     va con la estándar y no con el rebote: el rebote pasa de 1, y un fillAlpha por encima de
     1 se sale del byte de alfa del color y parpadea. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="fillAlpha"
    android:valueFrom="0"
    android:valueTo="1"
    android:valueType="floatType"
    android:startOffset="280"
    android:duration="420"
    android:interpolator="@interpolator/estandar" />
