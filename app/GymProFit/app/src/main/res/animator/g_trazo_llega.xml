<?xml version="1.0" encoding="utf-8"?>
<!-- La G entra (GP-223): el trazo llega desde 18 dp arriba a la derecha (57,6 unidades del
     logo de 512 sobre una G de 160 dp) y crece de 0,6 a 1, con rebote. Empieza a los
     G_TRAZO_RETRASO y dura G_TRAZO. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator
        android:propertyName="translateX"
        android:valueFrom="57.6"
        android:valueTo="0"
        android:valueType="floatType"
        android:startOffset="280"
        android:duration="420"
        android:interpolator="@interpolator/rebote" />
    <objectAnimator
        android:propertyName="translateY"
        android:valueFrom="-57.6"
        android:valueTo="0"
        android:valueType="floatType"
        android:startOffset="280"
        android:duration="420"
        android:interpolator="@interpolator/rebote" />
    <objectAnimator
        android:propertyName="scaleX"
        android:valueFrom="0.6"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="280"
        android:duration="420"
        android:interpolator="@interpolator/rebote" />
    <objectAnimator
        android:propertyName="scaleY"
        android:valueFrom="0.6"
        android:valueTo="1"
        android:valueType="floatType"
        android:startOffset="280"
        android:duration="420"
        android:interpolator="@interpolator/rebote" />
</set>
