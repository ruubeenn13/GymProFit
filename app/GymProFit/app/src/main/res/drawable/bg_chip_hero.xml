<?xml version="1.0" encoding="utf-8"?>
<!-- bg_chip_hero — el chip («Lo sigues») sobre la tarjeta protagonista del recomendado (GP-232):
     esa tarjeta es oscura en los dos temas y el fondo del chip de siempre se confundía con ella;
     lleva el borde de 1 dp de las siglas del ciclo, sin color nuevo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="@color/gp_on_hero_variant" />
</shape>
