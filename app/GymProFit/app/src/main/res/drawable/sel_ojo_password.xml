<?xml version="1.0" encoding="utf-8"?>
<!--
  sel_ojo_password — icono del conmutador de contraseña de los TextInputLayout
  (GP-080). Sustituye al ojo de Material Components, que es de Material Icons.
  Mismo criterio que el componente: con la contraseña oculta se ofrece «ver»
  (visibility); con la contraseña a la vista, «ocultar» (visibility_off).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/ic_ms_visibility_off" />
    <item android:drawable="@drawable/ic_ms_visibility" />
</selector>
