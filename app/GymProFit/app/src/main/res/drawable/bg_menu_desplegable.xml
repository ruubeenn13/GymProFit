<?xml version="1.0" encoding="utf-8"?>
<!-- bg_menu_desplegable — el menú que abre un desplegable (Spinner): superficie de tarjeta, borde de
     3:1 y radio de chip. Sin él salía en el color del fondo de la pantalla y en oscuro no se
     distinguía de lo de debajo (revisor, GP-225). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="1dp" android:color="@color/gp_stroke" />
    <corners android:radius="@dimen/radio_chip" />
    <padding android:top="@dimen/espacio_4" android:bottom="@dimen/espacio_4" />
</shape>
