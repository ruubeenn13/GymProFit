<!--
  ic_objetivo_perder_grasa — Objetivo PERDER_PESO del onboarding.

  Línea de tendencia que baja y termina en una punta de flecha hacia abajo.
  Cuenta el resultado (el peso baja), no el mecanismo (déficit calórico).
  Forma pareja simétrica con ic_objetivo_ganar_musculo, que sube.

  El color NO vive aquí: la tarjeta aplica app:tint con
  ?attr/colorOnSurfaceVariant en reposo y ?attr/colorPrimary al seleccionar,
  así que el mismo archivo sirve para tema claro y oscuro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,8 l6,6 4,-4 8,8 M15,18 h6 v-6"/>
</vector>
