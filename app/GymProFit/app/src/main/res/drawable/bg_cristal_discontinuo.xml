<?xml version="1.0" encoding="utf-8"?>
<!-- bg_cristal_discontinuo — «Añadir serie» en la tarjeta de un ejercicio (GP-285, lote 2): una
     píldora de 40 dp sin relleno con el borde a trazos de la maqueta, en gp_cristal_barra_tenue
     (3:1 contra la tarjeta). El botón mide 48 dp: los 4 de arriba y de abajo son zona táctil.
     Pulsado, la capa de siempre. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tarjeta_capa">
    <item android:id="@android:id/mask" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/gp_cristal_barra_tenue"
                android:dashWidth="4dp" android:dashGap="3dp" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
