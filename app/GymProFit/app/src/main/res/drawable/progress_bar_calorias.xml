<?xml version="1.0" encoding="utf-8"?>
<!--
  progress_bar_calorias — Barra de calorías para usar SOBRE EL NARANJA de marca.

  El blanco está bien aquí porque el fondo es colorPrimary. Para una barra sobre
  una superficie normal está progress_bar_on_surface: este mismo drawable se
  usaba también en el resumen del onboarding, encima de una tarjeta, y en tema
  claro quedaba blanco sobre blanco — invisible justo en la pantalla que
  justifica haber contestado cinco veces.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo de la barra (pista) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>

    <!-- Relleno de progreso (recortado según el valor actual) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="4dp" />
                <solid android:color="#FFFFFF" />
            </shape>
        </clip>
    </item>

</layer-list>