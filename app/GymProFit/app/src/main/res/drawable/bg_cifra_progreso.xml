<?xml version="1.0" encoding="utf-8"?>
<!-- bg_cifra_progreso — cada una de las tres cifras de Progreso (GP-105; tokens desde GP-216, lote 4):
     tarjeta pequeña (radio 20) con el borde de la tarjeta estándar, que en oscuro no existe. -->
