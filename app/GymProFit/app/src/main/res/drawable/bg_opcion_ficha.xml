<?xml version="1.0" encoding="utf-8"?>
<!-- bg_opcion_ficha — una ficha de categoría o de ración (lote 1.6.2): radio 20, borde; elegida,
     borde del acento y fondo del acento suave. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="?attr/colorPrimaryContainer" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="?attr/colorOutline" />
        </shape>
    </item>
</selector>
