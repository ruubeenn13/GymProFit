<!--
  ic_objetivo_ganar_musculo — Objetivo GANAR_MASA_MUSCULAR del onboarding.

  Línea de tendencia que sube y termina en una punta de flecha hacia arriba.
  Es el espejo exacto de ic_objetivo_perder_grasa: puestos uno al lado del
  otro en la lista de objetivos, la pareja se entiende sin leer el texto.

  Se eligió frente a tres dibujos de bíceps porque a 28 dp ninguno de ellos
  se leía como un músculo; ver la muestra de iconos de objetivo.

  El color NO vive aquí: la tarjeta aplica app:tint con
  ?attr/colorOnSurfaceVariant en reposo y ?attr/colorPrimary al seleccionar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,16 l6,-6 4,4 8,-8 M15,6 h6 v6"/>
</vector>
