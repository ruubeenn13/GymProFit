<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_logro — respaldo para un tipo de logro que la app todavía no conoce.
  El catálogo de logros vive en la API y puede crecer sin que la app se
  actualice; antes ese hueco lo tapaba un emoji de trofeo escrito en el adapter, que
  acababa siendo el icono de LOS SEIS porque el campo del que venía no existe
  en el DTO. Insignia neutra: no promete un logro concreto.

  Trazo abierto de 1,9 sobre lienzo de 24, como ic_objetivo_*: la familia entera
  se lee igual a 36 y a 44 dp. El color NO vive aquí, lo pone app:tint desde la
  fila, así que el mismo archivo sirve en claro y en oscuro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,11.6 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"/>
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,7.4 v4.2 l2.8,1.6"/>
</vector>
