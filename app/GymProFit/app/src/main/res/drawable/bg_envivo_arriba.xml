<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_envivo_arriba — pieza de la tarjeta de un ejercicio en la sesión en vivo (GP-012).
  La tarjeta se parte en cabecera, filas y pie porque cada serie es un elemento de la
  lista (así se desliza para quitarla). El borde de las juntas se saca fuera con un
  inset negativo: las piezas se pegan y se ve una sola tarjeta, como Card.Estructura.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetBottom="-2dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/colorSurface" />
        <stroke android:width="1dp" android:color="@color/gp_stroke" />
        <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
    </shape>
</inset>
