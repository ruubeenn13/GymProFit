<?xml version="1.0" encoding="utf-8"?>
<!-- bg_cristal_campo — el campo de kg, reps o tiempo de una serie sobre cristal (GP-285, lote 2):
     un surco (la pista de las barras) con el borde de un control, gp_cristal_barra_tenue, que
     pasa 3:1 contra la tarjeta (ContrasteCristalTest). Con foco, el borde en el naranja de los
     gráficos sobre cristal, de 2 dp, para que se vea dónde se escribe. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gp_cristal_pista" />
            <stroke android:width="2dp" android:color="@color/gp_cristal_grafico" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gp_cristal_pista" />
            <stroke android:width="1dp" android:color="@color/gp_cristal_barra_tenue" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
