<?xml version="1.0" encoding="utf-8"?>
<!-- bg_dia_elegido — el día elegido en la tira de Nutrición (GP-105). Desde la 1.6.8 (tablero 1),
     el contenedor naranja suave con un borde de 1 del naranja: sobre el naranja lleno no se
     veían el punto del día ni la marca del entreno. Radio 16. Pulsado, la capa del 10 % de las
     demás celdas; con el foco, el anillo de FocoVisible (GP-225). Va 2 dp hacia dentro por los
     lados: el anillo del día de al lado (2 dp por fuera de su celda) no toca este borde, y la
     celda sigue midiendo 51 dp de ancho para el toque. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/tarjeta_capa">
    <item android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radio_miniatura" />
            <solid android:color="@color/gp_primary_container" />
            <stroke android:width="1dp" android:color="@color/gp_primary" />
        </shape>
    </item>
</ripple>
