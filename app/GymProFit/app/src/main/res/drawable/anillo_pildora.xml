<?xml version="1.0" encoding="utf-8"?>
<!--
  Anillo de foco de una pestaña de la barra (GP-227; GP-285): va alrededor de la lente de la
  pestaña (icono y etiqueta), no de toda la columna. La lente lo pinta encima de su relleno, así
  que la activa también lo enseña entero. 2 dp en el texto de la barra, que pasa 3:1 sobre ella.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/selector_anillo_foco" android:color="@color/gp_vivo_texto" />
            <corners android:radius="@dimen/barra_lente_radio" />
        </shape>
    </item>
</selector>
