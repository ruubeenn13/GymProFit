<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_chevron_down — galón hacia abajo: "desplegar".
  Sustituye al triángulo hacia abajo que viajaba dentro de la cadena traducible de
  "Más detalles": un símbolo dentro del fichero de idioma no se tiñe, no se
  alinea y hay que acordarse de arrastrarlo a cada traducción.

  Trazo abierto de 1,9 sobre lienzo de 24, como ic_objetivo_*: la familia entera
  se lee igual a 36 y a 44 dp. El color NO vive aquí, lo pone app:tint desde la
  fila, así que el mismo archivo sirve en claro y en oscuro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M6.5,9.5 L12,15 l5.5,-5.5"/>
</vector>
