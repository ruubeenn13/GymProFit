<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_panel_descanso — el fondo del panel del descanso (GP-013): superficie de las
  tarjetas, esquinas de arriba redondeadas y el borde del tema (3:1, GP-063). El panel
  se sale 1 dp por los lados y por abajo para que solo se vea el borde de arriba.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="1dp" android:color="@color/gp_stroke" />
    <corners android:topLeftRadius="24dp" android:topRightRadius="24dp" />
</shape>
