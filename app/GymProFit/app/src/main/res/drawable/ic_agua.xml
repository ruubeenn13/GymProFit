<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_agua — gota de agua, para la recomendación de hidratación del resumen
  del onboarding. Sustituye al emoji de gota, que ni se teñía con el tema ni se
  alineaba con la cifra que acompaña.

  Trazo abierto de 1,9 sobre lienzo de 24, como ic_objetivo_*: la familia entera
  se lee igual a 36 y a 44 dp. El color NO vive aquí, lo pone app:tint desde la
  fila, así que el mismo archivo sirve en claro y en oscuro.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="?attr/colorOnSurfaceVariant"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,3.2 C12,3.2 5.8,10 5.8,14.4 a6.2,6.2 0 1,0 12.4,0 C18.2,10 12,3.2 12,3.2 z"/>
</vector>
