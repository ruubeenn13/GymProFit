<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml (variante DEBUG) — solo se fusiona en el build de desarrollo.

  Apaga la telemetría de Firebase en el entorno de pruebas: ni los fallos ni los
  eventos de una sesión de pruebas deben aparecer en la consola de producción,
  donde se mezclarían con los de usuarios reales. El manifest de producción
  (src/main) no se toca, así que el APK de release sigue reportando con normalidad.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Crashlytics: no enviar informes de fallo desde builds de pruebas. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <!-- Analytics: no registrar eventos de uso desde builds de pruebas. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <!-- Medidor de accesibilidad (solo depuración): vuelca al log el tamaño de
             cada texto y de cada zona pulsable, leídos del árbol de accesibilidad.
             Se activa por adb; ver MedidorAccesibilidad. -->
        <service
            android:name="es.pmdm.gymprofit.depuracion.MedidorAccesibilidad"
            android:exported="true"
            android:label="@string/medidor_nombre"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/medidor_accesibilidad" />
        </service>

        <!-- Trampolín de capturas (solo depuración): abre por adb cualquier
             pantalla de la app, que en main no están exportadas. -->
        <activity
            android:name="es.pmdm.gymprofit.depuracion.TrampolinActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />

    </application>

</manifest>
