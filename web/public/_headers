# Caché de gymprofit.app en Cloudflare Pages (GP-201). Ver web/README.md.
#
# El HTML se revalida siempre: es lo que dice qué versión de cada hoja pedir.
# Las hojas y los scripts van versionados por su contenido: los de la portada del dorsal
# con ?v=<hash> (/portada.css?v=<hash>) y los que construye Astro con el hash en el nombre
# (/_astro/beta.<hash>.css), así que se guardan un año sin preguntar. Las fuentes y las imágenes no van versionadas:
# se quedan con la revalidación de Pages.
#
# Ninguna regla /* a propósito: si dos reglas ponen Cache-Control a la misma
# ruta, Pages une sus valores con una coma.

/
  Cache-Control: no-cache

/beta
  Cache-Control: no-cache

/beta/*
  Cache-Control: no-cache

/privacidad
  Cache-Control: no-cache

/terminos
  Cache-Control: no-cache

/eliminar-cuenta
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

# La prueba de «Un día» (DEC-069): se revalida y no se indexa.
/un-dia
  Cache-Control: no-cache
  X-Robots-Tag: noindex

/portada.css
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Lo que construye Astro lleva el hash de su contenido en el nombre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
