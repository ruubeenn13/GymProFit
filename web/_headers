# Caché de gymprofit.app en Cloudflare Pages (GP-201). Ver web/README.md.
#
# El HTML se revalida siempre: es lo que dice qué versión de cada hoja pedir.
# Las hojas van versionadas por su contenido (/beta.css?v=<hash>), así que se
# guardan un año sin preguntar. Las fuentes y las imágenes no van versionadas:
# se quedan con la revalidación de Pages.
#
# Ninguna regla /* a propósito: si dos reglas ponen Cache-Control a la misma
# ruta, Pages une sus valores con una coma.

/
  Cache-Control: no-cache

/beta
  Cache-Control: no-cache

/beta/*
  Cache-Control: no-cache

/privacidad
  Cache-Control: no-cache

/terminos
  Cache-Control: no-cache

/eliminar-cuenta
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache

/estilo.css
  Cache-Control: public, max-age=31536000, immutable

/beta.css
  Cache-Control: public, max-age=31536000, immutable

/portada.css
  Cache-Control: public, max-age=31536000, immutable
