---
/**
 * La página de la beta (fase 4 de «Un día»): el texto, tal cual estaba en public/beta.html
 * (TextoIgualWebTest); la firma pasa a la cabecera común. Sin JavaScript (DEC-050).
 */
import Pagina from '../componentes/comunes/Pagina.astro';
import '../estilos/beta.css';
---
<Pagina titulo="Beta de GymProFit · Pruébala antes que nadie" descripcion="Apúntate a la beta de GymProFit para Android: entreno, dieta y progreso en una sola app. Te avisamos en cuanto abra." hora="19:00" colorOscuro="#0B0C0E" colorClaro="#F5F1EA">

<main class="marco">

  <section class="portada" aria-labelledby="titular">

    <div class="golpe">
    <h1 class="titular" id="titular">
      <span style="--k: 3.70">Pruébala</span>
      <span style="--k: 2.35">antes</span>
      <span style="--k: 3.93">que nadie.</span>
    </h1>
    <span class="tajo" aria-hidden="true"></span>
    <p class="linea">Entreno, dieta y progreso en una sola app. Solo Android.</p>
    </div>

    <!-- El formulario es nuestro y se envía por POST normal a Brevo, sin JavaScript (DEC-050).
         Los nombres de los campos son los que espera Brevo: no se cambian sin cambiarlos allí.
         No lleva animación de entrada: se ve desde el primer fotograma. -->
    <form class="alta" id="apuntarse" method="post" action="https://c66652ae.sibforms.com/serve/MUIFAORtSwe7_YQbPHZ1hfBdigRHNkNWnE7eaZati3CifuqQ3yIKNj2HQV6oOvbjfyUYusgHznzE_WWAA1fhZNqg84lw5KkyrVJxhLaYEyL0XUYchj8wmMdvuu6lNVZIDrylva7nkhY_bEC7VLwLrLIgS7kAabyxan0UmamnG80VnAInVeNAjUYo1BkWePjfwN9ptal3PQSa2H17mA==">
      <!-- Etiqueta flotante: dentro del campo hasta que se escribe o se toca, sin JS (:placeholder-shown) -->
      <div class="campo">
        <input class="correo" id="correo" type="email" name="EMAIL" required autocomplete="email" autocapitalize="off" spellcheck="false" placeholder=" ">
        <label for="correo">Tu correo</label>
      </div>

      <label class="consentimiento">
        <input type="checkbox" name="OPT_IN" value="1" required>
        <span>Avísame por correo de la beta y del lanzamiento. Me doy de baja cuando quiera. <a href="/privacidad#beta">Privacidad</a></span>
      </label>

      <!-- Trampa para bots: tiene que llegar vacía. Nadie la ve, ni con lector de pantalla. -->
      <div class="trampa" aria-hidden="true"><input type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off"></div>
      <input type="hidden" name="locale" value="es">
      <input type="hidden" name="html_type" value="simple">

      <button class="boton" type="submit">Apuntarme</button>
    </form>
  </section>

  <p class="iphone">La beta se instala desde Google Play. ¿Tienes iPhone? Sigue a @gymprofit en <a href="https://www.tiktok.com/@gymprofit">TikTok</a> o <a href="https://www.instagram.com/gymprofit">Instagram</a> para enterarte cuando llegue.</p>

  <ul class="razones">
    <li class="razon maciza">
      <h2>Todo junto</h2>
      <p>Lo que levantas, lo que comes y cómo cambias, sin cambiar de app.</p>
    </li>
    <li class="razon">
      <h2>Gratis</h2>
      <p>Probar la beta no te cuesta nada.</p>
    </li>
    <li class="razon tuya">
      <h2>Tu opinión cuenta</h2>
      <p>Lo que nos cuentes decide qué se arregla antes.</p>
    </li>
  </ul>

  <footer class="pie">
    <p>Al apuntarte te llega un correo para confirmar tu dirección: hasta que no lo confirmas, no estás en la lista. Cada correo nuestro lleva su enlace de baja.</p>
    <nav aria-label="Más de GymProFit">
      <a href="/">Inicio</a>
      <a href="/terminos">Términos</a>
      <a href="mailto:soporte@gymprofit.app">Soporte</a>
    </nav>
  </footer>

</main>

</Pagina>
